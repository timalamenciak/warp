@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix warp: <https://w3id.org/ecoweaver/warp/> .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition" .

warp:abstract_predicate a owl:AnnotationProperty ;
    rdfs:label "abstract predicate" ;
    obo:IAO_0000115 "True on a predicate that groups sub-properties and is never asserted of anything itself. The exporter always uses one of its sub-properties (decision D16)." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:action a owl:AnnotationProperty ;
    rdfs:label "action" ;
    obo:IAO_0000115 "The action node (a class) a strategy component carries out. An annotation, so the class is not punned as an individual; in OWL the part is `has part some <action>` on the strategy class (project/nodes.ttl)." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:component_of a owl:AnnotationProperty ;
    rdfs:label "component of" ;
    obo:IAO_0000115 "The management strategy (a node class) a strategy component individual belongs to. Written by export_rdf.py." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:derived_from a owl:AnnotationProperty ;
    rdfs:label "derived from" ;
    obo:IAO_0000115 "The WARP proposition an axiom was projected from. Follow it to the statements grouped under the proposition and to the synthesis assessment that let it through the projection gate." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:focus a owl:AnnotationProperty ;
    rdfs:label "focus" ;
    obo:IAO_0000115 "The node (a variable, as a class) a study result's data are about. An annotation, so the node class is not punned as an individual." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:in_jurisdiction a owl:ObjectProperty ;
    rdfs:label "in jurisdiction" ;
    obo:IAO_0000115 "The site lies in the object jurisdiction, identified by an IRI (ISO 3166-2 code)." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:jurisdiction_name a owl:AnnotationProperty ;
    rdfs:label "jurisdiction name" ;
    obo:IAO_0000115 "The name of the jurisdiction a site lies in, where it has no code to make an IRI of." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:object a owl:AnnotationProperty ;
    rdfs:label "object" ;
    obo:IAO_0000115 "The node, or other value, a statement or proposition relates its subject to. An annotation, not a relation." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:period_end a owl:AnnotationProperty ;
    rdfs:label "period end" ;
    obo:IAO_0000115 "The first instant after a project's period, as xsd:dateTime (the upper bound of its ISO 8601 end). Absent while the work is ongoing." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:period_start a owl:AnnotationProperty ;
    rdfs:label "period start" ;
    obo:IAO_0000115 "The first instant of a project's period, as xsd:dateTime (the lower bound of its ISO 8601 start)." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:predicate a owl:AnnotationProperty ;
    rdfs:label "predicate" ;
    obo:IAO_0000115 "The predicate a statement or proposition puts forward, as the predicate's IRI (an RO, CAMO or WARP object property)." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:selected_by a owl:AnnotationProperty ;
    rdfs:label "selected by" ;
    obo:IAO_0000115 "The qualifier value (an enum value IRI) for which export_rdf.py writes this sub-property in place of its abstract parent." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

warp:subject a owl:AnnotationProperty ;
    rdfs:label "subject" ;
    obo:IAO_0000115 "The node a statement or proposition is about: usually a node class, a site or project individual for particulars. An annotation, not a relation: nothing is inferred about the node." ;
    rdfs:isDefinedBy <https://w3id.org/ecoweaver/warp/ontology/relations> .

<https://w3id.org/ecoweaver/warp/ontology/relations> a owl:Ontology ;
    rdfs:label "WARP relations" ;
    dcterms:description "Every predicate WARP mints, declared once as an object property, and the annotation properties of WARP's reification layer." ;
    rdfs:comment "GENERATED by scripts/subset_schema.py: the causal profile of WARP's relations, without the predicates of cost, criteria, implementation, interaction, recommendation, tolerance." ;
    owl:versionIRI <https://w3id.org/ecoweaver/warp/ontology/relations/0.7.0> ;
    owl:versionInfo "0.7.0" .

