@prefix UBERON: <http://purl.obolibrary.org/obo/UBERON_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix node: <https://w3id.org/causal-mosaic/node/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

obo:IAO_0000115 a owl:AnnotationProperty .

dcterms:conformsTo a owl:AnnotationProperty .

node:bouteloua_gracilis a owl:Class ;
    rdfs:label "Bouteloua gracilis" ;
    obo:IAO_0000115 "An organism of Bouteloua gracilis." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/taxon.yaml> ;
    owl:equivalentClass TODO:taxon_bouteloua_gracilis .

node:fish_taxon_y a owl:Class ;
    rdfs:label "fish taxon Y" ;
    obo:IAO_0000115 "An organism of fish taxon Y." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/taxon.yaml> ;
    owl:equivalentClass TODO:taxon_y .

node:ph_of_soil a owl:Class ;
    rdfs:label "pH of soil" ;
    obo:IAO_0000115 "The pH of soil." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/quality_of_environmental_material.yaml> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TODO:ph [ a owl:Restriction ;
                        owl:onProperty RO:0000052 ;
                        owl:someValuesFrom ENVO:00001998 ] ) ] .

node:ph_of_soil_0_15cm a owl:Class ;
    rdfs:label "pH of soil, depth 0 to 15 TODO:unit_centimetre" ;
    obo:IAO_0000115 "The pH of soil, depth 0 to 15 TODO:unit_centimetre." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/quality_of_environmental_material.yaml> ;
    rdfs:comment "Refined by depth 0 to 15 TODO:unit_centimetre; not rendered in the logical definition." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( TODO:ph [ a owl:Restriction ;
                        owl:onProperty RO:0000052 ;
                        owl:someValuesFrom ENVO:00001998 ] ) ] .

node:planting_of_sanguinaria_canadensis a owl:Class ;
    rdfs:label "planting of Sanguinaria canadensis" ;
    obo:IAO_0000115 "A planting process in which organisms of Sanguinaria canadensis participate." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/intervention_involving_taxon.yaml> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TODO:planting [ a owl:Restriction ;
                        owl:onProperty RO:0000057 ;
                        owl:someValuesFrom NCBITaxon:3472 ] ) ] .

node:population_of_alliaria_petiolata a owl:Class ;
    rdfs:label "Alliaria petiolata population" ;
    obo:IAO_0000115 "A population of organisms whose members are Alliaria petiolata." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/population_of_taxon.yaml> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( PCO:0000001 [ a owl:Restriction ;
                        owl:onProperty RO:0002351 ;
                        owl:someValuesFrom NCBITaxon:126270 ] ) ] .

node:population_of_odocoileus_virginianus a owl:Class ;
    rdfs:label "Odocoileus virginianus population" ;
    obo:IAO_0000115 "A population of organisms whose members are Odocoileus virginianus." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/population_of_taxon.yaml> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( PCO:0000001 [ a owl:Restriction ;
                        owl:onProperty RO:0002351 ;
                        owl:someValuesFrom NCBITaxon:9874 ] ) ] .

node:rate_of_population_growth_of_alliaria_petiolata a owl:Class ;
    rdfs:label "rate of population growth of Alliaria petiolata population" ;
    obo:IAO_0000115 "The rate of a population growth process whose participant is a population of Alliaria petiolata." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/quality_of_process_of_population.yaml> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( PATO:0000161 [ a owl:Restriction ;
                        owl:onProperty RO:0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( PCO:0000011 [ a owl:Restriction ;
                                            owl:onProperty RO:0000057 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( PCO:0000001 [ a owl:Restriction ;
                                                                owl:onProperty RO:0002351 ;
                                                                owl:someValuesFrom NCBITaxon:126270 ] ) ] ] ) ] ] ) ] .

node:spartina_pectinata a owl:Class ;
    rdfs:label "Spartina pectinata" ;
    obo:IAO_0000115 "An organism of Spartina pectinata." ;
    dcterms:conformsTo <https://w3id.org/ecoweaver/patterns/taxon.yaml> ;
    owl:equivalentClass TODO:taxon_spartina_pectinata .

node:strategy-3adb20db5eef a owl:Class ;
    rdfs:label "Fill removal and plug planting with spot spraying if needed" ;
    obo:IAO_0000115 "A planned process whose required parts are, in order: step 1: Fill removal; step 1: Planting sedge meadow plugs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:fill_removal ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:planting_plugs_sedge_meadow ],
        OBI:0000011 .

node:strategy-ab075dde135f a owl:Class ;
    rdfs:label "Standard site preparation then seeding" ;
    obo:IAO_0000115 "A planned process whose required parts are, in order: step 1: Removal of invasive shrubs; step 2: Earthworks recontouring; step 3: Hand seeding of native mix A." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:earthworks_recontouring ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:removal_of_invasive_shrubs ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:hand_seeding_native_mix_a ],
        OBI:0000011 .

node:strategy-f38f3a2661ee a owl:Class ;
    rdfs:label "Earthworks then seeding then mowing" ;
    obo:IAO_0000115 "A planned process whose required parts are, in order: step 1: Earthworks recontouring; step 2: Hand seeding of native mix A; step 3: Mowing for weed control." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:hand_seeding_native_mix_a ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:mowing_weed_control ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:earthworks_recontouring ],
        OBI:0000011 .

node:strategy-f970cca73021 a owl:Class ;
    rdfs:label "Standard site preparation" ;
    obo:IAO_0000115 "A planned process whose required parts are, in order: step 1: Removal of invasive shrubs; step 2: Earthworks recontouring." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:removal_of_invasive_shrubs ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom node:earthworks_recontouring ],
        OBI:0000011 .

