    rdfs:subClassOf warp:EvidenceBalanceEnum ;
    skos:definition "The included evidence mostly supports the causal relationship." .

<https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#disputes> a owl:Class ;
    rdfs:label "disputes" ;
    rdfs:subClassOf warp:EvidenceDirectionEnum .

<https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#neutral> a owl:Class ;
    rdfs:label "neutral" ;
