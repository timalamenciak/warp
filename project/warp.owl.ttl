    rdfs:subClassOf warp:DirectionEvidenceEnum ;
    skos:definition "Direction established by DAG or structural equation model." .

<https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#temporal_precedence> a owl:Class ;
