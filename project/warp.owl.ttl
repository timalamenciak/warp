warp:Recurrence a owl:Class ;
    rdfs:label "Recurrence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$" ] ) ] ;
            owl:onProperty warp:every ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty warp:times ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:until ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:times ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:every ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:until ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:times ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:every ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:until ] ;
    skos:definition "A repeating strategy component: every, how many times, until when." ;
    skos:exactMatch warp:Recurrence ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

