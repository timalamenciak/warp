warp:ImplementationQualifiers a owl:Class ;
    rdfs:label "ImplementationQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:area_treated ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Period ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ExternalId ;
            owl:onProperty warp:external_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:implemented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:funded_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:external_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:funded_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:reported_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:area_treated ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ] ) ] ;
            owl:onProperty warp:reported_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:reported_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ImplementationStatusEnum ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:implemented_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:area_treated ] ;
    skos:definition "The predicate layer of an implementation statement. The plan document is the statement's specified_in." ;
    skos:exactMatch warp:ImplementationQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

