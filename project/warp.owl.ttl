<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#ongoing> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "ongoing" ;
    skos:definition "The process/event is ongoing." ;
    warp:fcm_sign "neutral" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "continuation of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#present> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "present" ;
    skos:definition "The entity or attribute is present (binary state)." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "presence" ;
    warp:rosetta_prefix "presence of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#removed> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "removed" ;
    skos:definition "The entity has been removed from the system (extirpation, management removal)." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "membership_change" ;
    warp:rosetta_prefix "removal of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#terminated> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "terminated" ;
    skos:definition "The process/event ended." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "cessation of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#unchanged> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "unchanged" ;
    skos:definition "The attribute stayed the same, reported as a measured state of the outcome variable itself (e.g. \"water table depth remained stable at 30 cm\"). Use it on a positive, non-negated claim — for example that a cause maintained or buffered a variable, or that a stable variable caused something else. Do not use it to encode a null result (\"X had no effect on Y\"): record that as negated: true with causal_language: no_relationship, leaving the object node's qualifier as it would be for a positive finding. The comparison the stability was assessed against belongs in CausalEdge.comparator, not here — controls and baselines are ComparatorTypeEnum values." ;
    warp:fcm_sign "neutral" ;
    warp:qualifier_family "directional_change" ;
    warp:rosetta_prefix "no change in" .

warp:StrategyComponent a owl:Class ;
    rdfs:label "StrategyComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:optional ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:optional ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty warp:step ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Recurrence ;
            owl:onProperty warp:repeat ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:lag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:step ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:step ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:repeat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:StrategyRoleEnum ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:lag ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$" ] ) ] ;
            owl:onProperty warp:lag ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:optional ] ;
    skos:definition "One part of a strategy. Exported to RDF as an individual of its own (comp:<strategy>/<n>), so order, lag, repeats and role are addressable; in OWL only the action, as `has part some <action>`, and only when the part is required." ;
    skos:exactMatch warp:StrategyComponent ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:StrategyDefinition a owl:Class ;
    rdfs:label "StrategyDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:StrategyComponent ;
            owl:onProperty warp:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:replaces ],
        [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty warp:components ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:replaces ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:canonical_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoDocument ;
            owl:onProperty warp:specified_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:canonical_node ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:specified_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:canonical_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:identity_rule_version ],
        warp:NodeDefinition ;
    skos:definition "A management strategy: a set of management actions carried out together, in a stated order. Its parts are references to ordinary action nodes (or to another strategy, nested one level deep); the strategy holds only their order. Annotators give each definition a local node ID; scripts/derive_strategies.py (warp-strategy-identity/1) computes the canonical node from the sorted (step, action) pairs of the required parts after flattening, records it here, and rewrites references so statements about two descriptions of the same work meet in one proposition." ;
    skos:exactMatch warp:StrategyDefinition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "No objective field, on purpose. What counts as restoration success is contested, and the same actions are aimed at different outcomes by different people. A node with an objective would build one view of success into the graph. Aims stay on statements, where they belong to a claimant, and in EcoStudyResult.stated_goal." .

<https://w3id.org/ecoweaver/warp/StrategyRoleEnum#establishment> a owl:NamedIndividual,
        warp:StrategyRoleEnum ;
    rdfs:label "establishment" ;
    warp:warp_cost_phase "initial" .

<https://w3id.org/ecoweaver/warp/StrategyRoleEnum#follow_up> a owl:NamedIndividual,
