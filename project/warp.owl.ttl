causal_mosaic:object a owl:ObjectProperty .

causal_mosaic:predicate a owl:ObjectProperty .

causal_mosaic:schema_version a owl:DatatypeProperty .

causal_mosaic:source_document a owl:ObjectProperty .

causal_mosaic:subject a owl:ObjectProperty .

causal_mosaic:title a owl:DatatypeProperty .

warp:ClaimStrengthEnum a owl:Class ;
    rdfs:label "ClaimStrengthEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#no_relationship> <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#associational> <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#uncertain_causal> <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#direct_causal> ) ;
    skos:definition "Four-level causal language strength scale, adapted from Yu et al. (2019). Captures the epistemic commitment of the text, not the actual strength of evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#associational>,
        <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#direct_causal>,
        <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#no_relationship>,
        <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#uncertain_causal> .

