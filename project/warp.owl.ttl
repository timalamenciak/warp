<https://example.org/sepio-model/DataItem> a owl:Class ;
    rdfs:label "DataItem" ;
    dcterms:title "Data Item" ;
    ns1:status <Informative> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/variabilityMeasures> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/confidenceInterval> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/unit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/unit> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/unit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/confidenceInterval> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/variabilityMeasures> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/confidenceInterval> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/componentDataItem> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/componentDataItem> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "An Information Entity representing an individual piece of data, generated or acquired through methods which reliably produce truthful information about something." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Examples include raw observations or measurements such as an allele count, or patient's weight, derived calculations such as frequency or mean, and computed statistical scores/metrics such as p-values and z-scores." .

<https://example.org/sepio-model/contributions> a owl:ObjectProperty .

<https://example.org/sepio-model/qualifier> a owl:ObjectProperty .

<https://example.org/sepio-model/specifiedBy> a owl:DatatypeProperty,
        owl:ObjectProperty .

<https://example.org/sepio-model/urls> a owl:DatatypeProperty .

causal_mosaic:source_spans a owl:ObjectProperty .

warp:EcoAgent a owl:Class ;
    rdfs:label "EcoAgent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:agent_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:agent_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AgentKindEnum ;
            owl:onProperty warp:agent_kind ],
        <https://example.org/sepio-model/Agent> ;
    skos:definition "A person, organization, community or software agent. Use an ORCID or ROR id where one exists and the agent agrees; otherwise a local id (warp:agent/...), which may be a pseudonym." ;
    skos:exactMatch warp:EcoAgent ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:EcoContribution a owl:Class ;
    rdfs:label "EcoContribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contributor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ContributionRoleEnum ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:contributor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:contributor ],
        <https://example.org/sepio-model/Contribution> ;
    skos:definition "One agent's part in making a statement, judging an evidence line, or recording either. The role says which." ;
    skos:exactMatch warp:EcoContribution ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:MeasurementRelationEnum a owl:Class ;
    rdfs:label "MeasurementRelationEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#direct> <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#proxy> <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#derived> ) ;
    skos:definition "How what a parameter option measures relates to the node it supplies. Causal models should allow for measurement error when the relation is proxy or derived." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#derived>,
        <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#direct>,
        <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#proxy> .

warp:AccessLevelEnum a owl:Class ;
    rdfs:label "AccessLevelEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/AccessLevelEnum#open> <https://w3id.org/ecoweaver/warp/AccessLevelEnum#attribution_required> <https://w3id.org/ecoweaver/warp/AccessLevelEnum#community_restricted> <https://w3id.org/ecoweaver/warp/AccessLevelEnum#restricted> ) ;
    skos:definition "How a statement and its content may be shared and reused." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AccessLevelEnum#attribution_required>,
        <https://w3id.org/ecoweaver/warp/AccessLevelEnum#community_restricted>,
        <https://w3id.org/ecoweaver/warp/AccessLevelEnum#open>,
        <https://w3id.org/ecoweaver/warp/AccessLevelEnum#restricted> .

warp:ContributingSoleEnum a owl:Class ;
    rdfs:label "ContributingSoleEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#sole_cause> <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#contributing_cause> <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#not_addressed> ) ;
    skos:definition "Whether the cause is presented as the sole cause or a contributing cause." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#contributing_cause>,
        <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#not_addressed>,
        <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#sole_cause> .

warp:ContributionRoleEnum a owl:Class ;
    rdfs:label "ContributionRoleEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#author> <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#evidence_assessor> <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#annotator> <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#reviewer> ) ;
    skos:definition "What an agent did toward a statement, evidence line or record. Specializes SEPIO Contribution.activityType." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "TODO: map values to Contribution Role Ontology (CRO) terms." ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#annotator>,
        <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#author>,
        <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#evidence_assessor>,
        <https://w3id.org/ecoweaver/warp/ContributionRoleEnum#reviewer> .

warp:DirectionStatusEnum a owl:Class ;
    rdfs:label "DirectionStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#asserted> <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#uncertain> <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#bidirectional> <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#not_addressed> ) ;
    skos:definition "Whether and how the direction of causation is stated." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#asserted>,
        <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#bidirectional>,
        <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#not_addressed>,
        <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#uncertain> .

warp:EcoProposition a owl:Class ;
    rdfs:label "EcoProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:raised_as_question ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SemanticUnitScopeEnum ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:PropositionStatusEnum ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:raised_as_question ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:derived_from_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoStatement ;
            owl:onProperty warp:derived_from_statements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:raised_as_question ],
        [ owl:unionOf ( warp:CausalProposition warp:InteractionProposition ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:identity_rule_version ],
        <https://example.org/sepio-model/Proposition> ;
    skos:definition "The possible fact a statement puts forward, independent of who asserts it. Derived by grouping statements under a versioned identity rule, or written by people as an open question. Each predicate group has a concrete subclass that constrains subject, predicate and object." ;
    skos:exactMatch warp:EcoProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "TODO: exact_mappings to the SEPIO OWL term for 'proposition'." .

warp:EcoStatement a owl:Class ;
    rdfs:label "EcoStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoEvidenceLine ;
            owl:onProperty warp:hasEvidenceLines ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:original_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoProposition ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceDirectionEnum ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:source_spans ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:recordMetadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CareMetadata ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoRecordMetadata ;
            owl:onProperty warp:recordMetadata ],
        [ owl:unionOf ( warp:CausalStatement warp:InteractionStatement warp:SynthesisAssessment ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TextSpan ;
            owl:onProperty warp:source_spans ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:original_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:original_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoContribution ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:hasEvidenceLines ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SemanticUnitScopeEnum ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:recordMetadata ],
        <https://example.org/sepio-model/Statement> ;
    skos:broadMatch IAO:0000030 ;
    skos:definition "A SEPIO Statement about an ecological relationship: a claim of purported truth made by a particular agent on a particular occasion. Annotated statements (CausalStatement, InteractionStatement) are in SEPIO Assertion Mode: they put a proposition forward as true and leave direction, strength and score empty. SynthesisAssessment is the Proposition Assessment Mode subclass." ;
    skos:exactMatch warp:EcoStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "Hedging (how cautiously something is said) belongs to the statement. Scope (what it is said about) belongs to the proposition, and is copied here so propositions can be derived from statements.",
        "Subject, predicate, object and negated are recorded on the statement as annotated, and normalized into a separate Proposition by scripts/derive_propositions.py. SEPIO allows either pattern; WARP uses both, with the Proposition authoritative for identity.",
        "TODO: add exact_mappings to the SEPIO OWL term for 'statement' once its IRI is confirmed; the upstream LinkML schema has no mappings yet." .

warp:EvidenceDirectionEnum a owl:Class ;
    rdfs:label "EvidenceDirectionEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#disputes> <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#neutral> ) ;
    skos:definition "SEPIO direction: whether a statement (in Proposition Assessment Mode) or an evidence line supports, disputes, or is neutral toward a proposition. NOT causal direction, which is CausalPredicateQualifiers.causal_direction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#disputes>,
        <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#neutral>,
        <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> .

warp:EvidenceObjectEnum a owl:Class ;
    rdfs:label "EvidenceObjectEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#correlation> <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#mechanism> <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#both> ) ;
    skos:definition "OBJECT of evidence per the Russo-Williamson Thesis: whether the evidence supports correlation (difference-making), mechanism (production), or both." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#both>,
        <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#correlation>,
        <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#mechanism> .

warp:EvidenceStrengthEnum a owl:Class ;
    rdfs:label "EvidenceStrengthEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#strong> <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#moderate> <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#weak> <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#not_assessed> ) ;
    skos:definition "Qualitative strength of the support an evidence line provides toward its target proposition, in the indicated direction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#moderate>,
        <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#strong>,
        <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#weak> .

warp:QualifierFamilyEnum a owl:Class ;
    rdfs:label "QualifierFamilyEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#directional_change> <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#presence> <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#membership_change> <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#process_phase> ) ;
    skos:definition "Groups StateOrChangeQualifierEnum values into mutually exclusive families. A set of qualifiers forms a valid state space only if all members share a family." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#directional_change>,
        <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#membership_change>,
        <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#presence>,
        <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#process_phase> .

warp:TokenTypeEnum a owl:Class ;
    rdfs:label "TokenTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/TokenTypeEnum#token> <https://w3id.org/ecoweaver/warp/TokenTypeEnum#type> <https://w3id.org/ecoweaver/warp/TokenTypeEnum#ambiguous> <https://w3id.org/ecoweaver/warp/TokenTypeEnum#not_addressed> ) ;
    skos:definition "Whether a causal claim is about a specific instance or a general type." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/TokenTypeEnum#ambiguous>,
        <https://w3id.org/ecoweaver/warp/TokenTypeEnum#not_addressed>,
        <https://w3id.org/ecoweaver/warp/TokenTypeEnum#token>,
        <https://w3id.org/ecoweaver/warp/TokenTypeEnum#type> .

warp:causal_language a owl:ObjectProperty ;
    rdfs:label "causal_language" ;
    skos:definition "How strongly the causal wording commits (statement-level hedging)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://example.org/sepio-model/Utility> a owl:Class ;
    rdfs:label "Utility" ;
    skos:definition "An abstract organizational class that groups classes acting as complex datatypes in the model - providing reusable collections of fields that can be plugged into other objects to capture sets of related information." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "The Utility class itself is abstract and has no direct attributes. Implementers would always use one of its concrete subtypes with specifically defined fields (e.g. Coding, Expression, Extension)." .

<https://example.org/sepio-model/label> a owl:DatatypeProperty .

<https://example.org/sepio-model/license> a owl:DatatypeProperty .

<https://example.org/sepio-model/object> a owl:DatatypeProperty .

<https://example.org/sepio-model/predicate> a owl:ObjectProperty .

<https://example.org/sepio-model/subject> a owl:DatatypeProperty .

<https://example.org/sepio-model/systemVersion> a owl:DatatypeProperty .

causal_mosaic:annotator a owl:DatatypeProperty .

causal_mosaic:entity_term a owl:DatatypeProperty .

