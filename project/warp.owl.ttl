            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:agent_subtype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:agent_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AgentKindEnum ;
            owl:onProperty warp:agent_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:agent_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:agent_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:agent_subtype ],
        <https://example.org/sepio-model/Agent> ;
    skos:definition "A person, organization, community or software agent. Use an ORCID or ROR id where one exists and the agent agrees; otherwise a local id (warp:agent/...), which may be a pseudonym." ;
    skos:exactMatch warp:EcoAgent ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:status a owl:ObjectProperty .

warp:CausalPredicateEnum a owl:Class ;
    rdfs:label "CausalPredicateEnum" ;
    skos:definition """Controlled predicate vocabulary for causal edges, grounded primarily in CAMO and cross-linked to Biolink / RO where possible. Each predicate carries a sign and transitivity property for FCM rendering.\r
FCM sign composition. The predicate's sign annotation and the nodes' fcm_sign annotations (StateOrChangeQualifierEnum) combine by one of two conventions, chosen once per rendering and never mixed:\r
(1) State level: FCM concepts are CAMO nodes as annotated ("decreased X" and "increased X" are different concepts). Edge sign = predicate sign. Node qualifiers are not applied; they are already part of each concept's identity. CausalEdge.fcm_weight is stored at this level.\r
(2) Variable level: nodes are first collapsed to variables (entity + measured_attribute, qualifier dropped). Edge sign = subject fcm_sign x predicate sign x object fcm_sign, with positive = +1 and negative = -1. A node with no qualifier counts as +1, as do the process_phase values occurred and ongoing (fcm_sign neutral), since the node is the variable's reference state. An edge with an unchanged node on either end has no variable-level sign and is left out.\r
Worked examples, variable level: "increased X prevents Y" = (+1)(-1)(+1) = negative; "decreased X causes Y" = (-1)(+1)(+1) = negative (the same finding, same sign); "decreased X causes decreased Y" = (-1)(+1)(-1) = positive; "removed X disrupts increased Y" = (-1)(-1)(+1) = positive. Applying node signs at the state level, or using only the object sign at the variable level, flips edges.\r
Only predicates whose sign is positive or negative carry an FCM sign. unspecified, variable, pathway, modifier and temporal predicates need an explicit fcm_weight or are left out of the FCM. Negated edges (null results, causal_language: no_relationship) produce no FCM arc.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/precedes>,
        camo:associated_with,
        camo:causes,
        camo:contributes_to,
        camo:correlated_with,
        camo:disrupts,
        camo:enables,
        camo:mediates,
        camo:moderates,
        camo:prevents,
        camo:regulates .

warp:EcoProposition a owl:Class ;
    rdfs:label "EcoProposition" ;
    rdfs:subClassOf [ owl:unionOf ( warp:CausalProposition warp:CostProposition warp:CriteriaProposition warp:ImplementationProposition warp:InteractionProposition warp:RecommendationProposition warp:ToleranceProposition ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:derived_from_statements ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:PropositionStatusEnum ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoStatement ;
            owl:onProperty warp:derived_from_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:identity_rule_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SemanticUnitScopeEnum ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:propositionText ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:propositionText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:raised_as_question ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:raised_as_question ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:propositionText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:identity_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:raised_as_question ],
        <https://example.org/sepio-model/Proposition> ;
    skos:definition "The possible fact a statement puts forward, independent of who asserts it. Derived by grouping statements under a versioned identity rule, or written by people as an open question. Each predicate group has a concrete subclass that constrains subject, predicate and object." ;
    skos:exactMatch warp:EcoProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "TODO: exact_mappings to the SEPIO OWL term for 'proposition'." .

warp:StateOrChangeQualifierEnum a owl:Class ;
    rdfs:label "StateOrChangeQualifierEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#increased> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#decreased> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#present> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#absent> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#introduced> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#removed> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#unchanged> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#occurred> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#initiated> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#terminated> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#ongoing> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#interrupted> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#aborted> ) ] ;
    skos:definition "Qualifier indicating the state or change in the variable's attribute. Corresponds to ELMO's direction_qualifier slot. Together with measured_attribute and the entity ontology term, forms the full semantic content of a node: \"state or change qualifier of attribute of entity.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#aborted>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#absent>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#decreased>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#increased>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#initiated>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#interrupted>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#introduced>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#occurred>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#ongoing>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#present>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#removed>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#terminated>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#unchanged> .

<https://example.org/sepio-model/Coding> a owl:Class ;
    rdfs:label "Coding" ;
    dcterms:title "Coding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/code> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/system> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/code> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/system> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/system> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/code> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "A structured representation of a code for a defined concept in a terminology or code system." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Coding supports use of terms form ontologies/terminologies in structured object that reports id, label, and metadata about system it came from.  follows FHIR approach.  Used in model when implementers are free to create own value sets of terms which get reported within coding objects in SEPIO data. Validation requires additional tooling - as constraints are not defined in schema itself.",
        "Either a code, label, or both must be provided." .

warp:WarpEvidenceTypeEnum a owl:Class ;
    rdfs:label "WarpEvidenceTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#randomized_experiment> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#natural_experiment> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#quasi_experiment> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#observational_longitudinal> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#observational_cross_sectional> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#mechanistic_study> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#structural_equation_model> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#meta_analysis> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#systematic_review> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#modeling_simulation> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#expert_judgment> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#case_study> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#theoretical> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#indigenous_knowledge> <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#practitioner_experience> ) ] ;
    skos:definition "Kind of study or reasoning behind an evidence line. Every value of CAMO's EvidenceTypeEnum, with the same descriptions and mappings, plus not_stated. Kept as a profile enum (decision D3) so CAMO is not edited; tests/test_evidence_types.py fails if CAMO gains a value this enum lacks, so re-vendoring cannot silently drop one." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "TODO: propose not_stated to CAMO (and to an evidence ontology); see TODOS.md." ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#case_study>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#expert_judgment>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#indigenous_knowledge>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#mechanistic_study>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#meta_analysis>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#modeling_simulation>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#natural_experiment>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#observational_cross_sectional>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#observational_longitudinal>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#practitioner_experience>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#quasi_experiment>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#randomized_experiment>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#structural_equation_model>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#systematic_review>,
        <https://w3id.org/ecoweaver/warp/WarpEvidenceTypeEnum#theoretical> .

warp:EvidenceTypeEnum a owl:Class ;
    rdfs:label "EvidenceTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#randomized_experiment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#natural_experiment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#quasi_experiment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_longitudinal> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_cross_sectional> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#mechanistic_study> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#structural_equation_model> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#meta_analysis> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#systematic_review> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#modeling_simulation> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#expert_judgment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#case_study> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#theoretical> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#indigenous_knowledge> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#practitioner_experience> ) ] ;
    skos:definition """TYPE of evidence per Illari's type/object distinction: what kind of study or reasoning produced the evidence.\r
ECO grounding: the Evidence and Conclusion Ontology is built around molecular and clinical assays and has no equivalent for any of these study designs, so no value uses meaning (which asserts equivalence). Where ECO has a parent term, it is given as a broad_mapping. Values with no ECO parent (natural_experiment, the observational designs, mechanistic_study, structural_equation_model, case_study, indigenous_knowledge) are left unmapped rather than forced onto an unrelated term. IDs verified against ECO via OLS, 2026-09-24.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#case_study>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#expert_judgment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#indigenous_knowledge>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#mechanistic_study>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#meta_analysis>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#modeling_simulation>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#natural_experiment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_cross_sectional>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_longitudinal>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#practitioner_experience>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#quasi_experiment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#randomized_experiment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#structural_equation_model>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#systematic_review>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#theoretical> .

causal_mosaic:status a owl:ObjectProperty .

