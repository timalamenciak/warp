causal_mosaic:StudyCoordinates a owl:Class ;
    rdfs:label "StudyCoordinates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:longitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:geodetic_datum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_west ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_east ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_north ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:elevation_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -1.8e+02 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1.8e+02 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:longitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_south ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_south ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:elevation_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -9e+01 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 9e+01 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:latitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:latitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:elevation_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_south ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:latitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_east ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CoordinateLocationBasisEnum ;
            owl:onProperty causal_mosaic:coordinate_location_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:geodetic_datum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:longitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:coordinate_uncertainty_m ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_north ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_west ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_north ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:coordinate_uncertainty_m ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:coordinate_location_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_east ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_west ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:geodetic_datum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:coordinate_uncertainty_m ] ;
    skos:definition "Structured coordinate representation for a study location. At minimum, provide latitude and longitude as a centroid when coordinates are reported. Optionally provide a bounding box for larger study areas and elevation. Coordinates should be in WGS 84 (EPSG:4326), which is what GPS devices and most ecology papers report." ;
    skos:exactMatch causal_mosaic:StudyCoordinates ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:account_coverage a owl:ObjectProperty ;
    rdfs:label "account_coverage" ;
    skos:definition "Philosophical accounts of causation represented by the evidence contributing to this aggregate relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:applied_to a owl:ObjectProperty ;
    rdfs:label "applied_to" ;
    skos:definition """The entity or entities that this node is directed at, acts upon, or whose scope the measurement spans. Covers two roles depending on node type:\r
(1) Scope role (composite_variable; earlier annotations may use environmental_variable): one or more taxa or ecological guilds whose measurements are aggregated or grouped — for example, "richness of liverworts, Sphagnum, and true mosses" (list the NCBITaxon ID for each group) or "abundance of native species" (free text "native species", tracked in NAO). NCBITaxon IDs for higher-rank taxa enable downstream traversal to all taxon nodes sharing that ID without requiring a structural edge. Free-text values are accepted for functional groups and guilds with no NCBITaxon resolution (e.g., "native species", "shade-tolerant species", "invasive plants") and should be tracked in the project NAO list. Do not use on single-taxon nodes — use entity_type: taxon with the NCBITaxon ID in entity_term instead.\r
(2) Target role (environmental_process and management_intervention): the specific entity that the process or intervention is directed at or acts upon. Use when the node's meaning is only complete with reference to a target — for example, "herbivory on Sphagnum" or "invasive species removal of Alliaria petiolata".\r
Accepts any entity type (taxon, community, habitat, etc.) using the same entity_type / entity_term decomposition as CausalNode.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:note "For composite_variable nodes: list the taxa or guilds whose measurements are aggregated. For process and intervention nodes: name the directional target entity. Leave empty for processes with no directional target and for variables with no taxonomic scope (e.g., soil pH, water table level)." .

causal_mosaic:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    skos:definition "Authors of the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:bradford_hill_viewpoints a owl:ObjectProperty ;
    rdfs:label "bradford_hill_viewpoints" ;
    skos:definition "Bradford Hill viewpoints supported by the aggregated evidence base. Some viewpoints require qualitative judgment and may not be fully programmatically reassessable each time article-level causal edges change." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator a owl:ObjectProperty ;
    rdfs:label "comparator" ;
    skos:definition "What the effect described by this edge was assessed relative to. Answers \"compared with what?\" — a property of the causal inference, not an entity in the world, and therefore annotated here rather than as a control node. One entry per comparison arm, so designs with more than one contrast keep a separate description and comparator_node_id for each: a BACI design (e.g. Kramer et al. 1995) records one pre_treatment_baseline entry and one untreated_control or spatial_or_temporal_control entry. Use a single entry when the source reports one comparison." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:components a owl:ObjectProperty ;
    rdfs:label "components" ;
    skos:definition "For management_intervention nodes that apply a mixture or package, what it contained: one entry per component, with the taxon or material in counted_entity and its rate in the value fields (e.g. a seed mix of ten species with seeding rates). Defines what the intervention was; do not annotate components as separate nodes or edges unless the source reports results for them separately. This records what was applied. What was observed in an assemblage goes in composition on a composite_variable node." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:coordinate_location_basis a owl:ObjectProperty ;
    rdfs:label "coordinate_location_basis" ;
    skos:definition "Annotation of what the coordinate values represent. Select exact_site when the coordinates identify the study site or sampling location; select nearest_municipality when the coordinates are for the nearest municipality rather than the exact site." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:edges a owl:ObjectProperty ;
    rdfs:label "edges" ;
    skos:definition "All annotated causal relationships." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:entity_terms a owl:DatatypeProperty ;
    rdfs:label "entity_terms" ;
    skos:definition "Entity terms the option can apply to, as CURIEs (preferred) or free text. A broader term covers its members (e.g. wd:Q756, plants, covers every plant taxon); resolving members is left to the matching tool." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:entity_types a owl:ObjectProperty ;
    rdfs:label "entity_types" ;
    skos:definition "Entity types the option can apply to." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_base_assessments a owl:ObjectProperty ;
    rdfs:label "evidence_base_assessments" ;
    skos:definition "Derived evidence-base-level assessments over sets of article-level causal edges. These should be regenerated when new relevant CausalEdge records are added." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_objects a owl:ObjectProperty ;
    rdfs:label "evidence_objects" ;
    skos:definition "OBJECT of evidence: whether it supports correlation, mechanism, or both. Per the Russo-Williamson Thesis." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_types a owl:ObjectProperty ;
    rdfs:label "evidence_types" ;
    skos:definition "TYPE of evidence: what kind of study or reasoning." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:excluded_edge_ids a owl:DatatypeProperty ;
    rdfs:label "excluded_edge_ids" ;
    skos:definition "Article-level CausalEdge identifiers reviewed but excluded from this aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:included_edge_ids a owl:DatatypeProperty ;
    rdfs:label "included_edge_ids" ;
    skos:definition "Article-level CausalEdge identifiers included in this aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:measured_attributes a owl:DatatypeProperty ;
    rdfs:label "measured_attributes" ;
    skos:definition "Measured attributes the option can supply, as CURIEs (preferred, e.g. PATO terms) or free text." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:mediator_node_ids a owl:ObjectProperty ;
    rdfs:label "mediator_node_ids" ;
    skos:definition "Node IDs of mediating entities. These should also appear as separate nodes in the graph with their own edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    skos:definition "The members of the assemblage, one entry each." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:moderator_node_ids a owl:ObjectProperty ;
    rdfs:label "moderator_node_ids" ;
    skos:definition "Node IDs of moderating entities." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:nodes a owl:ObjectProperty ;
    rdfs:label "nodes" ;
    skos:definition "All causal entities (causes, effects, mediators, moderators)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:observation_seasons a owl:ObjectProperty ;
    rdfs:label "observation_seasons" ;
    skos:definition "Seasons during which the effect was observed, where it is seasonally restricted, e.g. [late_spring, summer]. Important for context-dependent effects that may not hold year-round. A window that spans seasons or years is not a season: record it in time_since_intervention_text or duration_text." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:options a owl:ObjectProperty ;
    rdfs:label "options" ;
    skos:definition "The parameter options in this catalog." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:parameter_options a owl:ObjectProperty ;
    rdfs:label "parameter_options" ;
    skos:definition "Ways the state or change this node represents could be measured or supplied as a parameter, given as ids of ParameterOption entries in a ParameterOptionCatalog. A list of possibilities, independent of any source document: it does not record what a study measured. Used to bind nodes to data streams in digital twins and to choose observable variables when building causal models. Options apply to the variable, so nodes sharing a variable_key should carry the same options, filtered to those whose value_type suits the node's qualifier family." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "calculated" ;
    warp:note "Populated from the parameter option catalog, not by annotators. References are by id; loom checks that each id exists in the catalog." .

causal_mosaic:philosophical_accounts a owl:ObjectProperty ;
    rdfs:label "philosophical_accounts" ;
    skos:definition "Which philosophical account(s) of causation does this claim invoke? A claim may invoke multiple accounts simultaneously." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:qualifier_families a owl:ObjectProperty ;
    rdfs:label "qualifier_families" ;
    skos:definition "Qualifier families of the nodes the option can supply. Should be consistent with the option's value_type (see ValueTypeEnum)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:scope_conditions a owl:DatatypeProperty ;
    rdfs:label "scope_conditions" ;
    skos:definition "Named conditions under which the relationship holds. E.g., 'in acidic soils', 'at elevations above 2000m', 'in temperate grasslands'." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:source_documents a owl:ObjectProperty ;
    rdfs:label "source_documents" ;
    skos:definition "All documents contributing to this graph. Edges reference entries here by document_id rather than carrying inline copies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_coordinates a owl:ObjectProperty ;
    rdfs:label "study_coordinates" ;
    skos:definition "Coordinate set or sets reported for the study. Use one entry per reported centroid or bounded study area. This supports multi-site studies without requiring site names that the source may not report. Coordinates enable map-based evidence gap maps, proximity-weighted retrieval (\"show me evidence from sites near mine\"), and spatial analysis of where causal relationships have been tested." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#attribution_required> a owl:NamedIndividual,
        warp:AccessLevelEnum ;
    rdfs:label "attribution_required" .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#community_restricted> a owl:NamedIndividual,
        warp:AccessLevelEnum ;
    rdfs:label "community_restricted" ;
    skos:definition "Shareable only within, or with the permission of, the knowledge holders' community." .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#open> a owl:NamedIndividual,
        warp:AccessLevelEnum ;
    rdfs:label "open" .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#restricted> a owl:NamedIndividual,
        warp:AccessLevelEnum ;
    rdfs:label "restricted" ;
    skos:definition "Not to be shared beyond the original context." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#acoustic_monitoring> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "acoustic_monitoring" ;
    skos:definition "Passive acoustic recorders or hydrophones (e.g. bird, bat or frog detection)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#camera_trap> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "camera_trap" ;
    skos:definition "Motion- or time-triggered cameras recording animals or vegetation." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#citizen_science> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "citizen_science" ;
    skos:definition "Observations contributed by volunteers or community platforms (e.g. iNaturalist, eBird, structured volunteer surveys)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#environmental_dna> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "environmental_dna" ;
    skos:definition "Detection of taxa from DNA in environmental samples (water, soil, air), including metabarcoding." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#expert_elicitation> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "expert_elicitation" ;
    skos:definition "Values supplied by expert judgement or structured elicitation, where no measurement is available." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#field_survey> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "field_survey" ;
    skos:definition "Direct observation or measurement by people in the field (e.g. quadrat cover, transect counts, plant height, point counts)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#in_situ_sensor> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "in_situ_sensor" ;
    skos:definition "An automated instrument deployed at the site that records continuously or at intervals (e.g. soil moisture probe, water level logger, weather station, flux tower)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#laboratory_assay> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "laboratory_assay" ;
    skos:definition "Analysis of collected samples in a laboratory (e.g. soil nutrient analysis, tissue chemistry, seed bank germination trials)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#management_record> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "management_record" ;
    skos:definition "Records kept by the people carrying out an action (e.g. burn logs, seeding records, removal tallies, grazing schedules). The usual way to supply management_intervention nodes." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#model_output> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "model_output" ;
    skos:definition "Values produced by a model, reanalysis or gridded data product rather than direct observation (e.g. climate reanalysis, species distribution model output)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#remote_sensing> a owl:NamedIndividual,
        warp:AcquisitionMethodEnum ;
    rdfs:label "remote_sensing" ;
    skos:definition "Measurement from satellite, airborne or drone platforms (e.g. multispectral imagery, LiDAR, radar)." .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#community_member> a owl:NamedIndividual,
        warp:AgentKindEnum ;
    rdfs:label "community_member" .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#indigenous_knowledge_holder> a owl:NamedIndividual,
        warp:AgentKindEnum ;
    rdfs:label "indigenous_knowledge_holder" .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#organization> a owl:NamedIndividual,
        warp:AgentKindEnum ;
    rdfs:label "organization" .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#practitioner> a owl:NamedIndividual,
        warp:AgentKindEnum ;
    rdfs:label "practitioner" .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#researcher> a owl:NamedIndividual,
        warp:AgentKindEnum ;
    rdfs:label "researcher" .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#synthesis_pipeline> a owl:NamedIndividual,
        warp:AgentKindEnum ;
    rdfs:label "synthesis_pipeline" ;
    skos:definition "An EcoWeaver or other automated synthesis process." .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#anova> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "anova" ;
    skos:definition "Analysis of variance, including one-way, two-way, multiway and repeated-measures forms." ;
    warp:exemplars "within-year ANOVAs; repeated-measures ANOVA; MANOVAR" ;
    warp:note "Unmapped pending verification of STATO's parent term for analysis of variance. Verified children: STATO:0000044 (one-way), STATO:0000045 (two-way), STATO:0000048 (multiway)." ;
    warp:preferred_label "analysis of variance" .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#bayesian> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "bayesian" ;
    skos:definition "A Bayesian model, reported with credible intervals or posterior summaries. Pairs with interval_type: credible." .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#descriptive_only> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "descriptive_only" ;
    skos:definition "Means, counts or proportions reported with no inferential test. Pairs with significance: not_tested." .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#multivariate_other> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "multivariate_other" ;
    skos:definition "Another multivariate analysis; name it in quantitative_value." .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#nonparametric> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "nonparametric" ;
    skos:definition "A rank-based or otherwise distribution-free test." .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#ordination> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "ordination" ;
    skos:definition "Ordination of a multivariate response, e.g. PCA, CCA or NMDS. A result on an ordination axis describes a synthetic variable rather than a measured one, so prefer a node for the measured variable where the source gives one. Deliberately unmapped: no verified STATO equivalent." ;
    warp:exemplars "canonical correspondence analysis; PCA axis 1" .

<https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#regression> a owl:NamedIndividual,
        warp:AnalysisMethodEnum ;
    rdfs:label "regression" ;
    skos:definition "Linear, generalized or nonlinear regression outside a mixed-model frame." .

<https://w3id.org/ecoweaver/warp/AreaSourceEnum#computed> a owl:NamedIndividual,
        warp:AreaSourceEnum ;
    rdfs:label "computed" .

<https://w3id.org/ecoweaver/warp/AreaSourceEnum#reported> a owl:NamedIndividual,
        warp:AreaSourceEnum ;
    rdfs:label "reported" .

<https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#outcome> a owl:NamedIndividual,
        warp:AssessmentBasisEnum ;
    rdfs:label "outcome" .

<https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#process> a owl:NamedIndividual,
        warp:AssessmentBasisEnum ;
    rdfs:label "process" .

<https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#trajectory> a owl:NamedIndividual,
        warp:AssessmentBasisEnum ;
    rdfs:label "trajectory" .

<https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#expert_judgement> a owl:NamedIndividual,
        warp:AssessmentMethodEnum ;
    rdfs:label "expert_judgement" .

<https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#field_assessment> a owl:NamedIndividual,
        warp:AssessmentMethodEnum ;
    rdfs:label "field_assessment" .

<https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#remote_sensing> a owl:NamedIndividual,
        warp:AssessmentMethodEnum ;
    rdfs:label "remote_sensing" .

<https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#rule_applied> a owl:NamedIndividual,
        warp:AssessmentMethodEnum ;
    rdfs:label "rule_applied" .

<https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#self_reported> a owl:NamedIndividual,
        warp:AssessmentMethodEnum ;
    rdfs:label "self_reported" .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#insufficient_evidence> a owl:NamedIndividual,
        warp:AssessmentStatusEnum ;
    rdfs:label "insufficient_evidence" ;
    skos:definition "There is not enough evidence to assess this criterion." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#mixed> a owl:NamedIndividual,
        warp:AssessmentStatusEnum ;
    rdfs:label "mixed" ;
    skos:definition "The evidence base contains conflicting signals for this criterion." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_assessed> a owl:NamedIndividual,
        warp:AssessmentStatusEnum ;
    rdfs:label "not_assessed" ;
    skos:definition "The criterion has not been assessed." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_satisfied> a owl:NamedIndividual,
        warp:AssessmentStatusEnum ;
    rdfs:label "not_satisfied" ;
    skos:definition "The criterion is not satisfied by the aggregated evidence base." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#partially_satisfied> a owl:NamedIndividual,
        warp:AssessmentStatusEnum ;
    rdfs:label "partially_satisfied" ;
    skos:definition "The criterion is partially satisfied by the aggregated evidence base." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#satisfied> a owl:NamedIndividual,
        warp:AssessmentStatusEnum ;
    rdfs:label "satisfied" ;
    skos:definition "The criterion is satisfied by the aggregated evidence base." .

<https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#ecosystem_unit> a owl:NamedIndividual,
        warp:AssessmentUnitEnum ;
    rdfs:label "ecosystem_unit" .

<https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#jurisdiction> a owl:NamedIndividual,
        warp:AssessmentUnitEnum ;
    rdfs:label "jurisdiction" .

<https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#site> a owl:NamedIndividual,
        warp:AssessmentUnitEnum ;
    rdfs:label "site" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#analogy> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "analogy" ;
    skos:definition "Similar cause-effect relationships are known in analogous systems." ;
    warp:maps_to_account "mechanistic" ;
    warp:maps_to_feature "stability" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#biological_gradient> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "biological_gradient" ;
    skos:definition "Dose-response relationship." ;
    warp:maps_to_account "probabilistic" ;
    warp:maps_to_feature "strength" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#coherence> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "coherence" ;
    skos:definition "Causal interpretation fits with broader knowledge." ;
    warp:maps_to_account "mechanistic" ;
    warp:maps_to_feature "stability" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#consistency> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "consistency" ;
    skos:definition "Replicated across different studies, populations, and contexts." ;
    warp:maps_to_account "regularity" ;
    warp:maps_to_feature "stability" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#experiment> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "experiment" ;
    skos:definition "Deliberate manipulation changes the outcome." ;
    warp:maps_to_account "interventionist" ;
    warp:maps_to_feature "direction" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#plausibility> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "plausibility" ;
    skos:definition "A known or plausible mechanism exists." ;
    warp:maps_to_account "mechanistic" ;
    warp:maps_to_feature "mediation" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#specificity> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "specificity" ;
    skos:definition "One-to-one mapping between cause and effect." ;
    warp:maps_to_account "probabilistic" ;
    warp:maps_to_feature "specificity" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#strength> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "strength" ;
    skos:definition "Large effect size or strong association." ;
    warp:maps_to_account "probabilistic" ;
    warp:maps_to_feature "strength" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#temporality> a owl:NamedIndividual,
        warp:BradfordHillViewpointEnum ;
    rdfs:label "temporality" ;
    skos:definition "Cause precedes effect (the only 'inarguable' viewpoint)." ;
    warp:maps_to_account "counterfactual | probabilistic | interventionist | transmission | mechanistic | regularity | inus_component | agency" ;
    warp:maps_to_feature "temporal_ordering" .

warp:CareMetadata a owl:Class ;
    rdfs:label "CareMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:consent_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:protocols ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:community ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:protocols ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:knowledge_holders ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:consent_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:community ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:local_contexts_labels ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AccessLevelEnum ;
            owl:onProperty warp:access_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:community ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:access_level ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:access_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:local_contexts_labels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:protocols ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:consent_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:knowledge_holders ] ;
    skos:definition "Governance metadata in the spirit of the CARE principles: who holds the knowledge, under what consent, and how it may be shared." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#high> a owl:NamedIndividual,
        warp:CertaintyGradeEnum ;
    rdfs:label "high" ;
    skos:definition "High certainty. Rosetta rendering: 'X increases Y'." ;
    warp:rosetta_verb_modifier "" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#low> a owl:NamedIndividual,
        warp:CertaintyGradeEnum ;
    rdfs:label "low" ;
    skos:definition "Low certainty. Rosetta rendering: 'X may increase Y'." ;
    warp:rosetta_verb_modifier "may" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#moderate> a owl:NamedIndividual,
        warp:CertaintyGradeEnum ;
    rdfs:label "moderate" ;
    skos:definition "Moderate certainty. Rosetta rendering: 'X probably increases Y'." ;
    warp:rosetta_verb_modifier "probably" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#not_assessed> a owl:NamedIndividual,
        warp:CertaintyGradeEnum ;
    rdfs:label "not_assessed" ;
    skos:definition "Certainty not formally assessed." .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> a owl:NamedIndividual,
        warp:CertaintyGradeEnum ;
    rdfs:label "very_low" ;
    skos:definition "Very low certainty. Rosetta rendering: 'The evidence is very uncertain about the effect of X on Y'." ;
    warp:rosetta_template "The evidence is very uncertain about the effect of {subject} on {object}" ;
    warp:rosetta_verb_modifier "" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#associational> a owl:NamedIndividual,
        warp:ClaimStrengthEnum ;
    rdfs:label "associational" ;
    skos:definition "Correlation or co-occurrence without causal verb." ;
    warp:exemplars "correlated with; associated with; co-occurred with; linked to" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#direct_causal> a owl:NamedIndividual,
        warp:ClaimStrengthEnum ;
    rdfs:label "direct_causal" ;
    skos:definition "Unhedged causal verb asserting direct causation." ;
    warp:exemplars "causes; leads to; results in; produces; drives; determines" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#no_relationship> a owl:NamedIndividual,
        warp:ClaimStrengthEnum ;
    rdfs:label "no_relationship" ;
    skos:definition "Explicitly states no causal or associational relationship: a null result. Always paired with negated: true on the same edge (and negated: true is used only with this value). The object node keeps the qualifier a positive finding would use; it is not set to \"unchanged\"." ;
    warp:exemplars "no significant effect; did not affect; no association was found" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#uncertain_causal> a owl:NamedIndividual,
        warp:ClaimStrengthEnum ;
    rdfs:label "uncertain_causal" ;
    skos:definition "Hedged causal language or conditional causation." ;
    warp:exemplars "may cause; could contribute to; suggests a causal role; possibly leads to" .

warp:ClaimantArea a owl:Class ;
    rdfs:label "ClaimantArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:claimant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:statement ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:claimant ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ImplementationStatement ;
            owl:onProperty warp:statement ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:claimant ] ;
    skos:definition "One claimant's reported area treated: disagreements are kept, attributed, not resolved." ;
    skos:exactMatch warp:ClaimantArea ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ClaimantStatus a owl:Class ;
    rdfs:label "ClaimantStatus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ] ) ] ;
            owl:onProperty warp:reported_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:statement ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:claimant ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ImplementationStatusEnum ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ImplementationStatement ;
            owl:onProperty warp:statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:claimant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:reported_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:statement ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:claimant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:reported_on ] ;
    skos:definition "One claimant's latest reported status of a project (latest reported_on within that claimant only)." ;
    skos:exactMatch warp:ClaimantStatus ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_dose_level> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "alternative_dose_level" ;
    skos:definition "A different level of the same treatment, rather than a different treatment. Distinguishes a contrast along one gradient from a contrast between treatments, which alternative_treatment otherwise conflates. Record the arm's level in comparator_dose or comparator_dose_level." ;
    warp:exemplars "versus 15 and 20 ramets/m2; relative to lower initial densities" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_treatment> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "alternative_treatment" ;
    skos:definition "A different active treatment arm, not an untreated one." ;
    warp:exemplars "compared with the simple seed mix; versus mowing" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_applicable> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "not_applicable" ;
    skos:definition "The claim is mechanistic, theoretical, or definitional and invokes no contrast." .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#passive_management_arm> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "passive_management_arm" ;
    skos:definition "An arm representing a real do-nothing or cease-disturbance decision that a practitioner could choose. Where this value is used the arm should also be annotated as its own node, referenced by comparator_node_id, because it is a management intervention in its own right rather than a bare comparison." ;
    warp:exemplars "natural recovery; unseeded natural regeneration; grazing withdrawal" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#pre_treatment_baseline> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "pre_treatment_baseline" ;
    skos:definition "The same units measured before the intervention; a before-after contrast rather than a between-arm one." ;
    warp:exemplars "compared with pre-treatment cover; relative to year 0" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#reference_undisturbed> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "reference_undisturbed" ;
    skos:definition "An undisturbed or intact system used as a recovery benchmark or restoration target rather than as an experimental arm." ;
    warp:exemplars "adjacent undisturbed prairie; remnant reference stand" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#spatial_or_temporal_control> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "spatial_or_temporal_control" ;
    skos:definition "An unimpacted site or period used as a control in an observational or quasi-experimental design." ;
    warp:exemplars "upstream reach; pre-invasion period; paired uninvaded catchment" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#untreated_control> a owl:NamedIndividual,
        warp:ComparatorTypeEnum ;
    rdfs:label "untreated_control" ;
    skos:definition "Concurrent units receiving no manipulation of the factor under test." ;
    warp:exemplars "no treatment (control); unsprayed plots; unfenced plots" .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#biomass> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "biomass" ;
    skos:definition "Share of total mass." .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#cover> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "cover" ;
    skos:definition "Share of ground or canopy area occupied." .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#density> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "density" ;
    skos:definition "Members reported as counts per unit area or volume. Reported as absolute counts rather than share." .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#detection_frequency> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "detection_frequency" ;
    skos:definition "Share of sampling occasions or units on which the member was detected, e.g. camera-trap or point-count detections." .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#frequency_of_occurrence> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "frequency_of_occurrence" ;
    skos:definition "Share of plots or quadrats in which the member occurs." .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#other> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "other" ;
    skos:definition "Another basis; name it in CompositionAnnotation.verbatim." .

<https://w3id.org/ecoweaver/warp/CompositionBasisEnum#relative_abundance> a owl:NamedIndividual,
        warp:CompositionBasisEnum ;
    rdfs:label "relative_abundance" ;
    skos:definition "Share of counted individuals in the assemblage." .

<https://w3id.org/ecoweaver/warp/ContributingSoleEnum#contributing_cause> a owl:NamedIndividual,
        warp:ContributingSoleEnum ;
    rdfs:label "contributing_cause" ;
    skos:definition "Presented as one of several contributing factors." .

<https://w3id.org/ecoweaver/warp/ContributingSoleEnum#sole_cause> a owl:NamedIndividual,
