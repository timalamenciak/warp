        <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#methods>,
        <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#results>,
        <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#supplementary>,
        <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#title> .

warp:BradfordHillViewpointEnum a owl:Class ;
    rdfs:label "BradfordHillViewpointEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#strength> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#consistency> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#specificity> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#temporality> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#biological_gradient> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#plausibility> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#coherence> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#experiment> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#analogy> ) ;
    skos:definition "Bradford Hill's nine 'viewpoints' (1965) for assessing causal claims from observational evidence. Maps onto the philosophical accounts." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#analogy>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#biological_gradient>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#coherence>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#consistency>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#experiment>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#plausibility>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#specificity>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#strength>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#temporality> .

warp:PhilosophicalAccountEnum a owl:Class ;
    rdfs:label "PhilosophicalAccountEnum" ;
    owl:unionOf ( camo:Counterfactual camo:ProbabilisticVariation camo:Interventionist camo:Transmission camo:Mechanistic camo:Regularity camo:INUSComponent camo:Agency ) ;
    skos:definition "The philosophical account of causation invoked by a causal claim, per Illari and Russo's (2014) mosaic. Each account offers a different lens on what it means for C to cause E." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values camo:Agency,
        camo:Counterfactual,
        camo:INUSComponent,
        camo:Interventionist,
        camo:Mechanistic,
        camo:ProbabilisticVariation,
        camo:Regularity,
        camo:Transmission .

<https://example.org/sepio-model/InformationEntity> a owl:Class ;
    rdfs:label "InformationEntity" ;
