warp:ToleranceQualifiers a owl:Class ;
    rdfs:label "ToleranceQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:range ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ToleranceResponseEnum ;
            owl:onProperty warp:response ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:range ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:optimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ScaledValue ;
            owl:onProperty warp:class_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:QuantityRange ;
            owl:onProperty warp:range ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:response ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:optimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:optimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CurvePoint ;
            owl:onProperty warp:response_curve ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:class_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:class_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:response_curve ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:response ] ;
    skos:definition "The predicate layer of a tolerance statement. None of it is in the identity key: two sources giving pH 6.0 to 8.5 and 6.5 to 8.0 agree that pH limits the species and differ on where, so they derive one proposition with two ranges. Never converted between units silently." ;
    skos:exactMatch warp:ToleranceQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

