<https://w3id.org/ecoweaver/warp/LifeStageEnum#germinant_or_seedling> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "germinant_or_seedling" ;
    skos:closeMatch PO:0007131 ;
    skos:definition "Newly germinated through to establishment, before the juvenile stage." ;
    warp:exemplars "late-spring seedlings; germinants" ;
    warp:preferred_label "seedling development stage" .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#juvenile> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "juvenile" ;
    skos:definition "Established but not yet reproductive: a rosette, sapling, nestling or fledgling." ;
    warp:exemplars "year 1 rosettes; year 2 rosettes; saplings" .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#mixed_or_whole_population> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "mixed_or_whole_population" ;
    skos:definition "All stages together, or a count the source does not break down by stage. The usual value for an unstaged abundance or cover measure, and the one to use rather than leaving the slot empty when the source plainly counted everything." .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#not_specified> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "not_specified" ;
    skos:definition "A stage is implied but the source does not name it." .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#ramet_or_clonal_unit> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "ramet_or_clonal_unit" ;
    skos:definition "A clonal unit counted as the individual, e.g. transplanted ramets. Deliberately unmapped: PO carries clonal structures but no clonal-unit stage." ;
    warp:exemplars "ramets of Sanguinaria canadensis" .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#reproductive_adult> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "reproductive_adult" ;
    skos:closeMatch UBERON:0018241 ;
    skos:definition "Flowering, fruiting or breeding individuals." ;
    warp:preferred_label "prime adult stage" .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#seed_or_seed_bank> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "seed_or_seed_bank" ;
    skos:closeMatch PO:0001170 ;
    skos:definition "Seed, propagule, or the seed bank as a store." ;
    warp:preferred_label "seed development stage" .

<https://w3id.org/ecoweaver/warp/LifeStageEnum#senescent_or_dead> a owl:NamedIndividual,
        warp:LifeStageEnum ;
    rdfs:label "senescent_or_dead" ;
    skos:definition "Senescing, standing dead, or recently dead individuals." .

<https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#derived> a owl:NamedIndividual,
        warp:MeasurementRelationEnum ;
    rdfs:label "derived" ;
    skos:definition "Computed from one or more other measured quantities (e.g. species richness computed from survey records, evapotranspiration from flux measurements)." .

<https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#direct> a owl:NamedIndividual,
        warp:MeasurementRelationEnum ;
    rdfs:label "direct" ;
    skos:definition "Measures the node's measured_attribute of its entity_term itself." .

<https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#proxy> a owl:NamedIndividual,
        warp:MeasurementRelationEnum ;
    rdfs:label "proxy" ;
    skos:definition "Measures a different quantity that correlates with the node's attribute (e.g. NDVI as a proxy for vegetation biomass)." .

<https://w3id.org/ecoweaver/warp/ModalityEnum#anticipated> a owl:NamedIndividual,
        warp:ModalityEnum ;
    rdfs:label "anticipated" ;
    skos:definition "A forecast or prediction about what will happen: \"if sportfish are stocked, abundance will decrease\". Never projected to OWL." .

<https://w3id.org/ecoweaver/warp/ModalityEnum#inferred> a owl:NamedIndividual,
        warp:ModalityEnum ;
    rdfs:label "inferred" ;
    skos:definition "Concluded from other statements or from theory rather than observed directly: a mechanism argued from physiology, a generalization drawn from several cases." .

<https://w3id.org/ecoweaver/warp/ModalityEnum#observed> a owl:NamedIndividual,
        warp:ModalityEnum ;
    rdfs:label "observed" ;
    skos:definition "Reports what was seen or measured: a field result, an experiment, a practitioner's observation." .

warp:MonetaryAmount a owl:Class ;
    rdfs:label "MonetaryAmount" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty warp:adjustment_base_year ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty warp:price_year ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty warp:adjustment_rate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:price_year ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty warp:currency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:conversion_rate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:adjustment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:conversion_rate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:adjustment_base_year ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty warp:conversion_rate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:adjustment ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostAdjustmentEnum ;
            owl:onProperty warp:adjustment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:adjustment_rate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:price_year ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:derived_from_amount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:adjustment_rate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:derived_from_amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:adjustment_base_year ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:derived_from_amount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty warp:value ] ;
    skos:definition "Standard 5: money in its original currency and price year. Exported as a named individual (not a blank node), because a transferred cost cites the amount it was computed from. An amount with a value needs currency and price year (check_cost.py); one with no value yet records that the source gives a figure not yet transcribed (TODO), and is flagged by the completeness report and refused by transfer." ;
    skos:exactMatch warp:MonetaryAmount ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

