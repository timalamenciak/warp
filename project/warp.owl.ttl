<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#occurred> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "occurred" ;
    skos:definition "The process/event took place." ;
