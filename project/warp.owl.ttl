        [ a owl:Restriction ;
            owl:allValuesFrom warp:ContributingSoleEnum ;
            owl:onProperty causal_mosaic:contributing_sole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:certainty_grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:MediationAnnotation ;
            owl:onProperty causal_mosaic:mediation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sufficiency ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CertaintyGradeEnum ;
            owl:onProperty causal_mosaic:certainty_grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:original_sentence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:proximate_distal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:context_dependence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:reversibility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidential_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:SourceDocument ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:temporal_ordering ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty causal_mosaic:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TextSpan ;
            owl:onProperty causal_mosaic:source_spans ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:negated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:ecosystem_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:determinism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:temporal_ordering ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:token_or_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:necessity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:contributing_sole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:fcm_weight_source ] ;
    skos:definition """An edge in the labeled property graph representing a causal relationship. Carries all four annotation layers as properties:
  Layer 1: Claim strength and linguistic expression
  Layer 2: Philosophical account classification
  Layer 3: Sixteen causal features
  Layer 4: Evidential basis
Plus rendering metadata for each downstream target.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ParameterOption a owl:Class ;
    rdfs:label "ParameterOption" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:typical_spatial_resolution_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(unit|UO):\\S+$" ] ) ] ) ] ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:typical_temporal_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty causal_mosaic:sensor_or_instrument ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^P(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$" ] ) ] ) ] ;
            owl:onProperty causal_mosaic:typical_temporal_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^camo_param:[A-Za-z0-9._-]+$" ] ) ] ) ] ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ApplicabilityScope ;
            owl:onProperty causal_mosaic:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ValueTypeEnum ;
            owl:onProperty causal_mosaic:value_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty causal_mosaic:observable_property ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:option_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:acquisition_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:measurement_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:option_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:acquisition_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:typical_spatial_resolution_m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:typical_temporal_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:value_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:option_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:MeasurementRelationEnum ;
            owl:onProperty causal_mosaic:measurement_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AcquisitionMethodEnum ;
            owl:onProperty causal_mosaic:acquisition_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:typical_spatial_resolution_m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:observable_property ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty causal_mosaic:protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sensor_or_instrument ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:value_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:sensor_or_instrument ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:measurement_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:scope ] ;
    skos:closeMatch sosa:Procedure ;
    skos:definition "One way of measuring or supplying a value for a node: a type of sensor, survey, assay, record or model, described independently of any study. Many nodes can share one option (e.g. quadrat percent cover applies to any plant cover node). An option says what could be measured, not what was measured." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:SourceDocument a owl:Class ;
    rdfs:label "SourceDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:year ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:study_country ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_period_start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:study_state_or_province ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:document_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_design ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_state_or_province ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:study_period_start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:study_duration_months ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:sample_size_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:document_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_coordinates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:pmid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:journal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:pmid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_state_or_province ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_country ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceTypeEnum ;
            owl:onProperty causal_mosaic:study_design ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:is_sampling_effort_reported ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sample_size_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:year ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:sample_size_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:study_temporal_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_design ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:sample_size_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:sample_size_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_duration_months ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_temporal_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_period_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:journal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:study_period_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:pmid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_temporal_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:StudyCoordinates ;
            owl:onProperty causal_mosaic:study_coordinates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sample_size_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:journal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sampling_effort_protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty causal_mosaic:year ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:study_country ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_period_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:document_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_duration_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:is_sampling_effort_reported ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty causal_mosaic:is_sampling_effort_reported ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:sampling_effort_protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:study_period_start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:sampling_effort_protocol ] ;
    skos:definition "Bibliographic metadata and study-level context for the source document. Supports RAG retrieval, evidence gap map construction, and spatiotemporal analysis of the evidence base. Spatial fields enable map-based evidence visualization and proximity-weighted retrieval. Temporal fields enable tracking of when evidence was collected and whether causal relationships vary over time." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:TextSpan a owl:Class ;
    rdfs:label "TextSpan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:start_char ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:paragraph_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:start_char ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:sentence_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty causal_mosaic:end_char ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:end_char ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:paragraph_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:paragraph_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DocumentSectionEnum ;
            owl:onProperty causal_mosaic:section ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:sentence_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:section ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:end_char ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:section ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sentence_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty causal_mosaic:start_char ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:text ] ;
    skos:definition "A span of text in the source document, for provenance and RAG." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:acquisition_method a owl:ObjectProperty ;
    rdfs:label "acquisition_method" ;
    skos:definition "Broad kind of data collection the option uses." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_certainty_grade a owl:ObjectProperty ;
    rdfs:label "aggregate_certainty_grade" ;
    skos:definition "Certainty grade assigned to the aggregate evidence-base assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_certainty_rationale a owl:DatatypeProperty ;
    rdfs:label "aggregate_certainty_rationale" ;
    skos:definition "Rationale for the aggregate certainty grade." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_effect_sign a owl:DatatypeProperty ;
    rdfs:label "aggregate_effect_sign" ;
    skos:definition "Aggregate direction/sign of the effect, if assessed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "positive, negative, mixed, neutral, unknown" .

causal_mosaic:aggregate_effect_size a owl:DatatypeProperty ;
    rdfs:label "aggregate_effect_size" ;
    skos:definition "Aggregate effect size or summary statistic, if available." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_fcm_weight a owl:DatatypeProperty ;
    rdfs:label "aggregate_fcm_weight" ;
    skos:definition "Aggregate FCM edge weight for the summarized relationship, normalized to the [-1, 1] fuzzy-cognitive-map convention." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_fcm_weight_source a owl:DatatypeProperty ;
    rdfs:label "aggregate_fcm_weight_source" ;
    skos:definition "Method or provenance note explaining how aggregate_fcm_weight was derived from the included evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "weighted_mean_of_member_edges, meta_analysis_effect_size, expert_elicitation, certainty_downweighted" .

causal_mosaic:annotation_confidence a owl:DatatypeProperty ;
    rdfs:label "annotation_confidence" ;
    skos:definition "Annotator confidence in the overall annotation, 0.0-1.0." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_guide_version a owl:DatatypeProperty ;
    rdfs:label "annotation_guide_version" ;
    skos:definition "Version of the annotation guide used to create the graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_notes a owl:DatatypeProperty ;
    rdfs:label "annotation_notes" ;
    skos:definition "Free-text notes from the annotator about this edge." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_protocol a owl:DatatypeProperty ;
    rdfs:label "annotation_protocol" ;
    skos:definition "DOI or URL of the annotation protocol document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_timestamp a owl:DatatypeProperty ;
    rdfs:label "annotation_timestamp" ;
    skos:definition "Date and time when the edge annotation was created." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessed_by a owl:DatatypeProperty ;
    rdfs:label "assessed_by" ;
    skos:definition "Identifier for the person, model, or workflow that generated the assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessment_method a owl:DatatypeProperty ;
    rdfs:label "assessment_method" ;
    skos:definition "Method used to generate the evidence-base assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "automated_rule, narrative_synthesis, systematic_review, meta_analysis, expert_review" .

causal_mosaic:assessment_notes a owl:DatatypeProperty ;
    rdfs:label "assessment_notes" ;
    skos:definition "Free-text notes about the aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessment_timestamp a owl:DatatypeProperty ;
    rdfs:label "assessment_timestamp" ;
    skos:definition "Date and time when the aggregate assessment was generated." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessment_version a owl:DatatypeProperty ;
    rdfs:label "assessment_version" ;
    skos:definition "Version of the assessment method or ruleset." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:bbox_east a owl:DatatypeProperty ;
    rdfs:label "bbox_east" ;
    skos:definition "Eastern boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bbox_north a owl:DatatypeProperty ;
    rdfs:label "bbox_north" ;
    skos:definition "Northern boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bbox_south a owl:DatatypeProperty ;
    rdfs:label "bbox_south" ;
    skos:definition "Southern boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bbox_west a owl:DatatypeProperty ;
    rdfs:label "bbox_west" ;
    skos:definition "Western boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bradford_hill_count a owl:DatatypeProperty ;
    rdfs:label "bradford_hill_count" ;
    skos:definition "Count of Bradford Hill viewpoints supported by the aggregated evidence base." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:catalog_id a owl:DatatypeProperty ;
    rdfs:label "catalog_id" ;
    skos:definition "Unique identifier for this catalog." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:catalog_version a owl:DatatypeProperty ;
    rdfs:label "catalog_version" ;
    skos:definition "Version of the catalog contents, changed whenever options are added, edited or deprecated. Independent of the schema version." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:causal_language a owl:ObjectProperty ;
    rdfs:label "causal_language" ;
    skos:altLabel "claim_strength" ;
    skos:definition "How strong is the causal language used?" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:causal_mosaic_version a owl:DatatypeProperty ;
    rdfs:label "causal_mosaic_version" ;
    skos:definition "Version of the CAMO annotation framework used." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:certainty_grade a owl:ObjectProperty ;
    rdfs:label "certainty_grade" ;
    skos:definition "GRADE-style certainty assessment for this individual causal claim. Controls downstream language in Rosetta Statement rendering." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator_description a owl:DatatypeProperty ;
    rdfs:label "comparator_description" ;
    skos:definition "The comparison arm as the source names it, verbatim or near-verbatim. E.g. \"natural (disturbed, unseeded)\", \"no treatment (control)\"." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator_node_id a owl:DatatypeProperty ;
    rdfs:label "comparator_node_id" ;
    skos:definition "Node ID of the comparison arm, where that arm is itself annotated as a node. Expected when comparator_type is passive_management_arm or alternative_treatment; normally empty otherwise." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator_type a owl:ObjectProperty ;
    rdfs:label "comparator_type" ;
    skos:definition "The basis against which the effect was assessed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:conflict_summary a owl:DatatypeProperty ;
    rdfs:label "conflict_summary" ;
    skos:definition "Summary of important conflicts or heterogeneity across included studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:context_dependence a owl:ObjectProperty ;
    rdfs:label "context_dependence" ;
    skos:definition "Annotation of scope conditions or context dependence for the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:context_dependence_summary a owl:DatatypeProperty ;
    rdfs:label "context_dependence_summary" ;
    skos:definition "Summary of contexts or scope conditions that affect the aggregate relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:contributing_sole a owl:ObjectProperty ;
    rdfs:label "contributing_sole" ;
    skos:definition "Whether the cause is presented as a sole cause or contributing cause." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:coordinate_uncertainty_m a owl:DatatypeProperty ;
    rdfs:label "coordinate_uncertainty_m" ;
    skos:definition "Uncertainty radius in metres around the centroid coordinates. If the paper reports coordinates to the nearest minute (~1850m) vs. second (~30m) vs. high-precision GPS (~5m), this field captures that. Follows Darwin Core dwc:coordinateUncertaintyInMeters." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/coordinateUncertaintyInMeters> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:created a owl:DatatypeProperty ;
    rdfs:label "created" ;
    skos:definition "Date and time when the graph metadata was created." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:determinism a owl:ObjectProperty ;
    rdfs:label "determinism" ;
    skos:definition "Whether the causal relationship frames the underlying process as deterministic or indeterministic, or uses probability only to express epistemic uncertainty." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    skos:definition "Annotation of causal direction and evidence for direction." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:document_id a owl:DatatypeProperty ;
    rdfs:label "document_id" ;
    skos:definition "Local identifier for this document within the graph. Use the DOI where one exists." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    skos:definition "Digital Object Identifier for the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:dose_response a owl:DatatypeProperty ;
    rdfs:label "dose_response" ;
    skos:definition "Is a dose-response or gradient relationship described?" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:duration_months a owl:DatatypeProperty ;
    rdfs:label "duration_months" ;
    skos:definition "Duration of the observed causal effect in months. E.g., 36 for \"within three years\", 6 for \"one growing season.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:duration_text a owl:DatatypeProperty ;
    rdfs:label "duration_text" ;
    skos:definition "Free-text description of the temporal extent as stated in the source. E.g., \"within three growing seasons\", \"over a 20-year period\", \"immediately following treatment.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ecosystem_context a owl:ObjectProperty ;
    rdfs:label "ecosystem_context" ;
    skos:definition "The IUCN Global Ecosystem Typology Level 3 ecosystem functional group in which this causal relationship was observed, represented by an ELMO ecosystem type term. Use this edge-level field for the ecosystem setting of the causal claim." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:elm_correspondence "ecosystem_context_qualifier" ;
    warp:examples "temperate_subhumid_grasslands, seagrass_meadows" .

causal_mosaic:ecosystem_scope a owl:ObjectProperty ;
    rdfs:label "ecosystem_scope" ;
    skos:definition "Ecosystem type scope, mapped to IUCN GET." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:effect_size_metric a owl:DatatypeProperty ;
    rdfs:label "effect_size_metric" ;
    skos:definition "Metric used for the aggregate effect size." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "risk ratio, odds ratio, standardized mean difference, correlation coefficient" .

causal_mosaic:effect_size_summary_method a owl:DatatypeProperty ;
    rdfs:label "effect_size_summary_method" ;
    skos:definition "Method used to summarize effect sizes across studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "meta_analysis, vote_counting, narrative_synthesis, expert_assessment" .

causal_mosaic:elevation_m a owl:DatatypeProperty ;
    rdfs:label "elevation_m" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/verbatimElevation> ;
    skos:definition "Elevation of the coordinate location in metres above sea level, if reported. Useful for montane and altitudinal gradient studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:elm_version a owl:DatatypeProperty ;
    rdfs:label "elm_version" ;
    skos:definition "Version of the Ecolink Model Ontology entity structure used." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:embedding_text a owl:DatatypeProperty ;
    rdfs:label "embedding_text" ;
    skos:definition "Concatenated text used for generating the embedding vector. Typically: name + description + synonym list." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:embedding_vector a owl:DatatypeProperty ;
    rdfs:label "embedding_vector" ;
    skos:definition "Pre-computed embedding vector for RAG retrieval. Stored as serialized float array. Generated by the indexing pipeline, not by annotators." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" ;
    warp:note "Serialized float32 array; decode with numpy/arrow" .

causal_mosaic:end_char a owl:DatatypeProperty ;
    rdfs:label "end_char" ;
    skos:definition "Character offset end." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:evidence_balance a owl:ObjectProperty ;
    rdfs:label "evidence_balance" ;
    skos:definition "Overall balance of the included evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_for_direction a owl:ObjectProperty ;
    rdfs:label "evidence_for_direction" ;
    skos:definition "Evidence used to establish the direction of causation." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:exclusion_rationale a owl:DatatypeProperty ;
    rdfs:label "exclusion_rationale" ;
    skos:definition "Free-text rationale for exclusions, if any." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:export_sha256 a owl:DatatypeProperty ;
    rdfs:label "export_sha256" ;
    skos:definition "SHA-256 hex digest of the YAML export, computed before provenance was embedded, for integrity verification." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:exported_at a owl:DatatypeProperty ;
    rdfs:label "exported_at" ;
    skos:definition "ISO 8601 timestamp when this export was produced." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:exporter_version a owl:DatatypeProperty ;
    rdfs:label "exporter_version" ;
    skos:definition "Version string of the software tool that produced this export (e.g. 'loom-1.2.0')." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:fcm_weight a owl:DatatypeProperty ;
    rdfs:label "fcm_weight" ;
    skos:definition "Numeric edge weight for Fuzzy Cognitive Map rendering. Range: -1.0 (strong negative) to +1.0 (strong positive). Stored at the state level: its sign is the predicate sign only, and the subject and object qualifiers are not applied, because they are part of each node's identity. A variable-level FCM multiplies this weight by the subject and object fcm_sign at render time (see the sign-composition rule in CausalPredicateEnum). Magnitude is derived from the predicate's fcm_default_weight, causal_language, and the strength annotation. Can be overridden by expert elicitation; record which in fcm_weight_source." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:fcm_weight_source a owl:DatatypeProperty ;
    rdfs:label "fcm_weight_source" ;
    skos:definition "How the FCM weight was determined." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "derived_from_schema, expert_elicitation, meta_analysis_effect_size" ;
    warp:loom_role "hidden" .

causal_mosaic:geodetic_datum a owl:DatatypeProperty ;
    rdfs:label "geodetic_datum" ;
    skos:definition "The geodetic datum used by the coordinates (WGS84 preferred)" ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/geodeticDatum> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:geographic_scope a owl:DatatypeProperty ;
    rdfs:label "geographic_scope" ;
    skos:definition "Geographic scope of the claim." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:graph_id a owl:DatatypeProperty ;
    rdfs:label "graph_id" ;
    skos:definition "Unique identifier for this graph or sub-graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:has_difference_making_evidence a owl:ObjectProperty ;
    rdfs:label "has_difference_making_evidence" ;
    skos:definition "Aggregate assessment of whether the evidence base contains difference-making evidence for the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:has_production_evidence a owl:ObjectProperty ;
    rdfs:label "has_production_evidence" ;
    skos:definition "Aggregate assessment of whether the evidence base contains production or mechanistic evidence for the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:heterogeneity a owl:DatatypeProperty ;
    rdfs:label "heterogeneity" ;
    skos:definition "Heterogeneity statistic or qualitative heterogeneity summary." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:inclusion_criteria a owl:DatatypeProperty ;
    rdfs:label "inclusion_criteria" ;
    skos:definition "Criteria used to decide which article-level edges belong in this aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:interaction_type a owl:ObjectProperty ;
    rdfs:label "interaction_type" ;
    skos:definition "Type of interaction or effect modification described." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:is_sampling_effort_reported a owl:DatatypeProperty ;
    rdfs:label "is_sampling_effort_reported" ;
    skos:closeMatch <http://rs.tdwg.org/eco/terms/isSamplingEffortReported> ;
    skos:definition "Whether the study reported its sampling effort at all. False is informative: it downgrades certainty rather than leaving a silent gap." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:journal a owl:DatatypeProperty ;
    rdfs:label "journal" ;
    skos:definition "Journal or publication venue for the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "Short human-readable name (e.g. \"Percent cover in fixed quadrats\", \"NDVI from Sentinel-2 imagery\")." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:lag_months a owl:DatatypeProperty ;
    rdfs:label "lag_months" ;
    skos:definition "Time lag between the cause and the onset of the effect, in months. E.g., if invasive removal happens in year 0 and native recovery begins in year 2, lag = 24. Null if the effect is immediate or lag is not reported." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:last_refreshed_at a owl:DatatypeProperty ;
    rdfs:label "last_refreshed_at" ;
    skos:definition "Date and time when the aggregate assessment was last refreshed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    skos:definition "Latitude of the study coordinate centroid in decimal degrees (WGS 84). Positive = North, negative = South. E.g., 43.2642 for southern Ontario." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/decimalLatitude> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    skos:definition "Longitude of the study coordinate centroid in decimal degrees (WGS 84). Positive = East, negative = West. E.g., -81.7567 for southern Ontario." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/decimalLongitude> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:measured_attribute a owl:DatatypeProperty ;
    rdfs:label "measured_attribute" ;
    skos:definition "The measurable attribute of the entity that participates in the causal relationship. Corresponds to ELMO's derivative_qualifier slot. Together with entity_term and state_or_change_qualifier, forms the full semantic content: \"state or change qualifier of attribute of entity.\" This is the authoritative ontology grounding for the measured attribute. Use PATO terms for qualities (abundance, density, cover, height), GO terms for process rates, or free text if no ontology term exists." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "PATO:0000070 (abundance), PATO:0000918 (width), PATO:0000574 (density), PATO:0001019 (mass), PATO:0000033 (concentration), PATO:0001708 (1-D extent/cover), GO:0008150 (biological process for rates)" .

causal_mosaic:measurement_relation a owl:ObjectProperty ;
    rdfs:label "measurement_relation" ;
    skos:definition "Whether the option measures the node's attribute directly, measures a proxy for it, or derives it from other quantities." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:mediation a owl:ObjectProperty ;
    rdfs:label "mediation" ;
    skos:definition "Annotation of any mediating pathway between cause and effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:moderation a owl:ObjectProperty ;
    rdfs:label "moderation" ;
    skos:definition "Annotation of any moderator or effect modifier for the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "Human-readable composed label for the node. Should express the full semantic content: \"Increased wolf population abundance\" or \"Prescribed burning process\" or \"Elevated soil nitrogen.\" This is what appears in Rosetta Statements and graph visualizations." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:necessity a owl:ObjectProperty ;
    rdfs:label "necessity" ;
    skos:definition "Whether the cause is characterized as necessary for the effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:needs_refresh a owl:DatatypeProperty ;
    rdfs:label "needs_refresh" ;
    skos:definition "True when new relevant article-level CausalEdge records have been added or changed since this assessment was last generated." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:negated a owl:DatatypeProperty ;
    rdfs:label "negated" ;
    skos:definition "True if the source reports that the relationship does NOT hold — a null result. This is the canonical null-result encoding, and it is always paired with causal_language: no_relationship: negated is true if and only if causal_language is no_relationship. Leave the object node as it would be for a positive finding (the tested direction if stated, otherwise no qualifier); never encode a null result by giving the object node the qualifier \"unchanged\"." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:canonical_null_result "Invariant: negated == (causal_language == no_relationship). Declared via equals_expression because LinkML rules cannot yet test a boolean slot; generated JSON Schema and Pydantic do not enforce it, so validating tools (e.g. loom) must check it." .

causal_mosaic:number_of_contradicting_edges a owl:DatatypeProperty ;
    rdfs:label "number_of_contradicting_edges" ;
    skos:definition "Number of included article-level edges contradicting the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_experimental_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_experimental_studies" ;
    skos:definition "Number of included studies using randomized, quasi-, or natural experimental designs." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_mechanistic_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_mechanistic_studies" ;
    skos:definition "Number of included studies providing mechanistic or production evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_observational_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_observational_studies" ;
    skos:definition "Number of included observational studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_studies" ;
    skos:definition "Number of distinct source studies represented in the included edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_supporting_edges a owl:DatatypeProperty ;
    rdfs:label "number_of_supporting_edges" ;
    skos:definition "Number of included article-level edges supporting the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:observable_property a owl:DatatypeProperty ;
    rdfs:label "observable_property" ;
    skos:closeMatch sosa:observedProperty ;
    skos:definition "What the option actually measures, as a CURIE (preferred) or free text. Required for proxy and derived options; for direct options it may be left empty, meaning the node's own measured_attribute. Prefer I-ADOPT variables, NVS P01 parameters, ECSO measurement types or EnvThes terms." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:observation_grain a owl:DatatypeProperty ;
    rdfs:label "observation_grain" ;
    skos:definition "The temporal grain at which the effect was measured. E.g., \"daily\", \"monthly\", \"seasonal\", \"annual\", \"decadal.\" Affects interpretability — a relationship detected at annual grain may not hold at daily grain." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "daily, weekly, monthly, seasonal, annual, decadal, centennial" .

causal_mosaic:ontology_framework a owl:DatatypeProperty ;
    rdfs:label "ontology_framework" ;
    skos:definition "Ontology and causal annotation frameworks used by this graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ontology_snapshot_id a owl:DatatypeProperty ;
    rdfs:label "ontology_snapshot_id" ;
    skos:definition "Identifier for the ontology term snapshot pinned to this graph at export time, enabling reproducible term lookups." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:option_description a owl:DatatypeProperty ;
    rdfs:label "option_description" ;
    skos:definition "Fuller explanation of the option: what is recorded, typical deployment, and known limitations." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:original_sentence a owl:DatatypeProperty ;
    rdfs:label "original_sentence" ;
    skos:definition "The full original sentence(s) from which this edge was extracted. Preserved for RAG retrieval and rendering validation." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:paragraph_id a owl:DatatypeProperty ;
    rdfs:label "paragraph_id" ;
    skos:definition "Paragraph identifier." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:pathway_description a owl:DatatypeProperty ;
    rdfs:label "pathway_description" ;
    skos:definition "Free-text description of the mediating pathway." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:pmid a owl:DatatypeProperty ;
    rdfs:label "pmid" ;
    skos:definition "PubMed identifier for the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:project a owl:DatatypeProperty ;
    rdfs:label "project" ;
    skos:definition "Project name (e.g., 'EcoWeaver', 'Grassland Systematic Map')." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:proportionality a owl:ObjectProperty ;
    rdfs:label "proportionality" ;
    skos:definition "Whether the cause is characterized at a proportional level of specificity." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:protocol a owl:DatatypeProperty ;
    rdfs:label "protocol" ;
    skos:closeMatch sosa:usedProcedure ;
    skos:definition "A standard method this option follows, as a DOI, URL or CURIE, or free text naming it (e.g. a GEO BON protocol, an LTER method, a protocols.io entry)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    skos:definition "Provenance metadata for the graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:proximate_distal a owl:ObjectProperty ;
    rdfs:label "proximate_distal" ;
    skos:definition "Whether the cause is positioned as proximate, distal, or both." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:qualitative_descriptor a owl:ObjectProperty ;
    rdfs:label "qualitative_descriptor" ;
    skos:definition "Qualitative descriptor of the causal relationship strength." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:quantitative_numeric a owl:DatatypeProperty ;
    rdfs:label "quantitative_numeric" ;
    skos:definition "Numeric value extracted for computation (e.g., FCM weight derivation). Use the primary effect size; specify the metric in quantitative_value." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:quantitative_value a owl:DatatypeProperty ;
    rdfs:label "quantitative_value" ;
    skos:definition "Effect size as reported: 'RR = 2.0', 'd = 0.8', '60% reduction'." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:refresh_reason a owl:DatatypeProperty ;
    rdfs:label "refresh_reason" ;
    skos:definition "Reason the assessment needs to be refreshed, if applicable." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:reversibility a owl:ObjectProperty ;
    rdfs:label "reversibility" ;
    skos:definition "Whether removing the cause is characterized as reversing the effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:russo_williamson_rationale a owl:DatatypeProperty ;
    rdfs:label "russo_williamson_rationale" ;
    skos:definition "Rationale for the aggregate Russo-Williamson assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:russo_williamson_satisfied a owl:ObjectProperty ;
    rdfs:label "russo_williamson_satisfied" ;
    skos:definition "Aggregate assessment of whether the evidence base satisfies the Russo-Williamson requirement for both difference-making and production evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sample_size_unit a owl:DatatypeProperty ;
    rdfs:label "sample_size_unit" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/sampleSizeUnit>,
        <http://rs.tdwg.org/eco/terms/samplingEffortUnit> ;
    skos:definition "The unit associated with sample_size_value. Recommended best practice is a controlled vocabulary." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "plots, sites, trapDays, personHours, years, individuals" .

causal_mosaic:sample_size_value a owl:DatatypeProperty ;
    rdfs:label "sample_size_value" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/sampleSizeValue>,
        <http://rs.tdwg.org/eco/terms/samplingEffortValue> ;
    skos:definition "The numeric value of the sample size or sampling effort reported by the study. Must have a corresponding sample_size_unit." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sampling_effort_protocol a owl:DatatypeProperty ;
    rdfs:label "sampling_effort_protocol" ;
    skos:closeMatch <http://rs.tdwg.org/eco/terms/samplingEffortProtocol> ;
    skos:definition "A description of, or reference to, the methods used to determine the reported sampling effort. Distinct from the survey method itself." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    skos:definition "Which kinds of node the option can apply to. Used to narrow the candidates when matching options to nodes, and to document intent." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:section a owl:ObjectProperty ;
    rdfs:label "section" ;
    skos:definition "The section of the source document this span was drawn from. Claims from discussion and conclusion sections are typically more speculative than those from results." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sensor_or_instrument a owl:DatatypeProperty ;
    rdfs:label "sensor_or_instrument" ;
    skos:closeMatch sosa:madeBySensor ;
    skos:definition "The instrument or device class used, as a CURIE (preferred) or free text. Prefer NVS L05 device categories or L22 instrument terms. Leave empty for methods with no instrument (e.g. expert_elicitation)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sentence_id a owl:DatatypeProperty ;
    rdfs:label "sentence_id" ;
    skos:definition "Sentence identifier." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:source_corpus a owl:DatatypeProperty ;
    rdfs:label "source_corpus" ;
    skos:definition "Description of the annotated corpus or literature set." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:specificity a owl:ObjectProperty ;
    rdfs:label "specificity" ;
    skos:definition "Whether the causal relationship is characterized as specific to particular causes or effects." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:stability a owl:ObjectProperty ;
    rdfs:label "stability" ;
    skos:definition "Whether the causal relationship is characterized as stable across contexts or conditions." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:start_char a owl:DatatypeProperty ;
    rdfs:label "start_char" ;
    skos:definition "Character offset start in source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:state_or_change_qualifier a owl:ObjectProperty ;
    rdfs:label "state_or_change_qualifier" ;
    skos:definition "Qualifier indicating the state or change in the attribute, including cases where the attribute is present, absent, or unchanged. \"unchanged\" describes a reported stable state, not a null result; null results are encoded on the edge (see CausalEdge.negated). Corresponds to ELMO's direction_qualifier slot. Combined with entity_term and measured_attribute to produce the node's full meaning: e.g., entity=Canis lupus, attribute=abundance, qualifier=increased gives \"increased abundance of Canis lupus.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:strength a owl:ObjectProperty ;
    rdfs:label "strength" ;
    skos:definition "Annotation of the reported strength or magnitude of the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_country a owl:DatatypeProperty ;
    rdfs:label "study_country" ;
    skos:definition "Country or countries where the study was conducted. Use country names or ISO 3166-1 alpha-2 codes where practical. If multiple countries are reported, separate them with semicolons." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/country> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_design a owl:ObjectProperty ;
    rdfs:label "study_design" ;
    skos:definition "Study design classification for EGM quality assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_duration_months a owl:DatatypeProperty ;
    rdfs:label "study_duration_months" ;
    skos:definition "Duration of the study in months. Computed from start/end if both are provided, or entered directly if the paper reports duration without specific dates. Useful for filtering: \"show me only studies with at least 24 months of monitoring.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "calculated" .

causal_mosaic:study_period_end a owl:DatatypeProperty ;
    rdfs:label "study_period_end" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/eventDate> ;
    skos:definition "End date of data collection. Same format as study_period_start." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:format "ISO 8601 (YYYY, YYYY-MM, or YYYY-MM-DD)" .

causal_mosaic:study_period_start a owl:DatatypeProperty ;
    rdfs:label "study_period_start" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/eventDate> ;
    skos:definition "Start date of data collection. Not the publication date — when the fieldwork or measurements actually began. ISO 8601 format. Can be year-only (2015), year-month (2015-06), or full date (2015-06-15). For paleontological or historical ecology studies, use negative years or descriptive text in study_temporal_note." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "2015, 2015-06, 2015-06-15" ;
    warp:format "ISO 8601 (YYYY, YYYY-MM, or YYYY-MM-DD)" .

causal_mosaic:study_state_or_province a owl:DatatypeProperty ;
    rdfs:label "study_state_or_province" ;
    skos:definition "State, province, territory, or comparable administrative region where the study was conducted. If multiple regions are reported, separate them with semicolons." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/stateProvince> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_temporal_note a owl:DatatypeProperty ;
    rdfs:label "study_temporal_note" ;
    skos:definition "Free-text note for temporal context that doesn't fit structured fields. E.g., \"data collected over three growing seasons\", \"historical records from 1850-1950\", \"pollen core spanning 6,700 years.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sufficiency a owl:ObjectProperty ;
    rdfs:label "sufficiency" ;
    skos:definition "Whether the cause is characterized as sufficient for the effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:temporal_extent a owl:ObjectProperty ;
    rdfs:label "temporal_extent" ;
    skos:definition "The temporal window over which this causal effect was observed. Distinct from the study period in source_document (when fieldwork was done): this captures the timescale of the causal relationship itself. E.g., \"native recovery occurred within three growing seasons of invasive removal.\" Enables filtering by effect duration and analysis of whether effect sizes vary with observation window." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:temporal_ordering a owl:ObjectProperty ;
    rdfs:label "temporal_ordering" ;
    skos:definition "Whether temporal ordering between cause and effect is addressed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:temporal_scope a owl:DatatypeProperty ;
    rdfs:label "temporal_scope" ;
    skos:definition "Temporal scope of the claim." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    skos:definition "Verbatim text." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:token_or_type a owl:ObjectProperty ;
    rdfs:label "token_or_type" ;
    skos:definition "Whether the claim concerns a specific causal instance or a general causal type." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:typical_spatial_resolution_m a owl:DatatypeProperty ;
    rdfs:label "typical_spatial_resolution_m" ;
    skos:definition "Typical spatial grain in metres (pixel size, plot or quadrat side, or sensor footprint)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:typical_temporal_resolution a owl:DatatypeProperty ;
    rdfs:label "typical_temporal_resolution" ;
    skos:definition "Typical interval between successive values, as an ISO 8601 duration (e.g. PT15M, P1D, P1Y)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    skos:definition "Unit of the values the option produces, as a QUDT unit (preferred) or UO term. Leave empty for unitless, binary or categorical values." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:value_type a owl:ObjectProperty ;
    rdfs:label "value_type" ;
    skos:definition "The kind of value the option produces." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:variable_key a owl:DatatypeProperty ;
    rdfs:label "variable_key" ;
    skos:definition "A calculated key for the causal node to assist  in BBN variable grouping." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "calculated" ;
    warp:note "Composed of entity_term plus measured_attribute plus applied_to" .

causal_mosaic:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    skos:definition "Publication year." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

warp:AccountFamilyEnum a owl:Class ;
    rdfs:label "AccountFamilyEnum" ;
    owl:unionOf ( camo:DifferenceMakingAccount camo:ProductionAccount camo:ComplementaryAccount ) ;
    skos:definition "The high-level family grouping from Illari and Russo's primary distinction (via Ned Hall 2004): difference-making asks WHETHER C makes a difference to E; production asks HOW C brings about E." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values camo:ComplementaryAccount,
        camo:DifferenceMakingAccount,
        camo:ProductionAccount .

warp:CausalProposition a owl:Class ;
    rdfs:label "CausalProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalPredicateEnum ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:object ],
        warp:EcoProposition ;
    skos:definition "A proposition put forward by causal statements." ;
    skos:exactMatch warp:CausalProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CausalStatement a owl:Class ;
    rdfs:label "CausalStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcosystemFunctionalGroupEnum ;
            owl:onProperty warp:ecosystem_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:comparator ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ComparatorAnnotation ;
            owl:onProperty warp:comparator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:causal_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:temporal_extent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:camo_edge_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TemporalExtent ;
            owl:onProperty warp:temporal_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:camo_edge_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ContextAnnotation ;
            owl:onProperty warp:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalPredicateEnum ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:camo_edge_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:temporal_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalPredicateQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:ecosystem_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:causal_language ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ClaimStrengthEnum ;
            owl:onProperty warp:causal_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:ecosystem_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:context ],
        warp:EcoStatement ;
    skos:definition "A statement that one ecological state, change or process makes a causal (or associational) difference to another. Subject and object are CAMO node shapes; the predicate is a CAMO predicate, refined by the causal features in predicate_qualifiers." ;
    skos:exactMatch warp:CausalStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "causal" ;
    warp:warp_proposition_class "CausalProposition" ;
    warp:warp_propositions_slot "causal_propositions" ;
    warp:warp_statements_slot "causal_statements" .

warp:CoordinateLocationBasisEnum a owl:Class ;
    rdfs:label "CoordinateLocationBasisEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#exact_site> <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#nearest_municipality> ) ;
    skos:definition "What the study coordinate values represent. Used to distinguish coordinates for the exact study site from approximate coordinates based on the nearest municipality when exact site coordinates are unavailable." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#exact_site>,
        <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#nearest_municipality> .

warp:InteractionProposition a owl:Class ;
    rdfs:label "InteractionProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionPredicateEnum ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:object ],
        warp:EcoProposition ;
    skos:definition "A proposition put forward by biotic interaction statements." ;
    skos:exactMatch warp:InteractionProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:InteractionStatement a owl:Class ;
    rdfs:label "InteractionStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionPredicateEnum ;
            owl:onProperty warp:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:negated ],
        warp:EcoStatement ;
    skos:definition "A statement that organisms of one population interact with organisms of another in a particular way: eating, pollinating, parasitizing. Subject and object are population nodes (template population_of_taxon)." ;
    skos:exactMatch warp:InteractionStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "interaction" ;
    warp:warp_proposition_class "InteractionProposition" ;
    warp:warp_propositions_slot "interaction_propositions" ;
    warp:warp_statements_slot "interaction_statements" .

warp:PropositionStatusEnum a owl:Class ;
    rdfs:label "PropositionStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#asserted> <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#open_question> ) ;
    skos:definition "Whether anyone has asserted the proposition yet." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#asserted>,
        <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#open_question> .

warp:SynthesisAssessment a owl:Class ;
    rdfs:label "SynthesisAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:strength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:evidence_balance ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CertaintyGradeEnum ;
            owl:onProperty warp:strength ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:evidence_balance ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceBalanceEnum ;
            owl:onProperty warp:evidence_balance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:strength ],
        warp:EcoStatement ;
    skos:definition "A statement in SEPIO Proposition Assessment Mode, about the state of the evidence for a proposition across many statements. Usually made by a synthesis pipeline or review team. Replaces CAMO EvidenceBaseAssessmentEdge." ;
    skos:exactMatch warp:SynthesisAssessment ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:access_level a owl:ObjectProperty ;
    rdfs:label "access_level" ;
    skos:definition "How the statement may be shared and reused." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:agent_kind a owl:ObjectProperty ;
    rdfs:label "agent_kind" ;
    skos:definition "The kind of knowledge the agent brings." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:camo_edge_id a owl:DatatypeProperty ;
    rdfs:label "camo_edge_id" ;
    skos:definition "Identifier of the CAMO CausalEdge this statement was migrated or projected from." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:care a owl:ObjectProperty ;
    rdfs:label "care" ;
    skos:definition "Consent, access and governance metadata. Required for statements whose author is an Indigenous knowledge holder or community member (checked by scripts/check_statements.py)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:causal_direction a owl:ObjectProperty ;
    rdfs:label "causal_direction" ;
    skos:definition "CAMO 'direction' (renamed)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:community a owl:DatatypeProperty ;
    rdfs:label "community" ;
    skos:definition "Community or nation with authority over the knowledge." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:consent_reference a owl:DatatypeProperty ;
    rdfs:label "consent_reference" ;
    skos:definition "Pointer to the consent or agreement under which the statement was recorded." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:context a owl:ObjectProperty ;
    rdfs:label "context" ;
    skos:definition "Conditions under which the statement is said to hold (scope conditions)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:contributing_sole a owl:ObjectProperty ;
    rdfs:label "contributing_sole" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:determinism a owl:ObjectProperty ;
    rdfs:label "determinism" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ecosystem_context a owl:ObjectProperty ;
    rdfs:label "ecosystem_context" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effect_on_object a owl:ObjectProperty ;
    rdfs:label "effect_on_object" ;
    skos:definition "Effect of the interaction on the object population." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effect_on_subject a owl:ObjectProperty ;
    rdfs:label "effect_on_subject" ;
    skos:definition "Effect of the interaction on the subject population." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effect_strength a owl:ObjectProperty ;
    rdfs:label "effect_strength" ;
    skos:definition "CAMO 'strength' (renamed)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_balance a owl:ObjectProperty ;
    rdfs:label "evidence_balance" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_object a owl:ObjectProperty ;
    rdfs:label "evidence_object" ;
    skos:definition "Whether the evidence bears on correlation (difference-making), mechanism (production), or both (Russo-Williamson). EcoWeaver extension to SEPIO; candidate for an upstream contribution." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_type a owl:ObjectProperty ;
    rdfs:label "evidence_type" ;
    skos:definition "Kind of study or reasoning (CAMO; ECO parents given as broad mappings there). Specializes SEPIO EvidenceLine.subtype, which is left empty." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:identity_key a owl:DatatypeProperty ;
    rdfs:label "identity_key" ;
    skos:definition "The normalized key that defines this proposition under the identity rule." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:identity_rule_version a owl:DatatypeProperty ;
    rdfs:label "identity_rule_version" ;
    skos:definition "Which identity rule produced this grouping. Changing the rule regroups statements, so it must be recorded." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "The term's label, used to build the node's generated label. Optional; the CURIE is used if missing." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:mediation a owl:ObjectProperty ;
    rdfs:label "mediation" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:moderation a owl:ObjectProperty ;
    rdfs:label "moderation" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:necessity a owl:ObjectProperty ;
    rdfs:label "necessity" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:node a owl:ObjectProperty ;
    rdfs:label "node" ;
    skos:definition "The CAMO node being defined." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:original_text a owl:DatatypeProperty ;
    rdfs:label "original_text" ;
    skos:definition "The statement as worded in its source (verbatim sentence, notebook line, transcript passage). Distinct from statementText, which is the normalized rendering." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:profile_version a owl:DatatypeProperty ;
    rdfs:label "profile_version" ;
    skos:definition "Version of this profile the set conforms to." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:proportionality a owl:ObjectProperty ;
    rdfs:label "proportionality" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:protocols a owl:DatatypeProperty ;
    rdfs:label "protocols" ;
    skos:definition "Community protocols governing use, in the community's words." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:proximate_distal a owl:ObjectProperty ;
    rdfs:label "proximate_distal" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:raised_as_question a owl:DatatypeProperty ;
    rdfs:label "raised_as_question" ;
    skos:definition "True if people created this proposition as an open question before any statement asserted it. Such propositions keep their id and are never deleted by re-derivation; they revert to open_question if their statements are removed." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:reversibility a owl:ObjectProperty ;
    rdfs:label "reversibility" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    skos:definition "What the agent did. Specializes SEPIO Contribution.activityType, which is left empty." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:specificity a owl:ObjectProperty ;
    rdfs:label "specificity" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:stability a owl:ObjectProperty ;
    rdfs:label "stability" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

