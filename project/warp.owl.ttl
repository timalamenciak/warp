<https://w3id.org/ecoweaver/warp/DoseLevelEnum#absent> a owl:NamedIndividual,
        warp:DoseLevelEnum ;
    rdfs:label "absent" ;
    skos:definition "The driver was absent, or the intervention was not applied." ;
    warp:exemplars "no deer; unseeded; 0 ramets/m2" .

<https://w3id.org/ecoweaver/warp/DoseLevelEnum#high> a owl:NamedIndividual,
        warp:DoseLevelEnum ;
    rdfs:label "high" ;
    skos:definition "A high level, short of the highest the source names." ;
    warp:exemplars "high deer densities; heavy browsing pressure" .

<https://w3id.org/ecoweaver/warp/DoseLevelEnum#higher_than_comparator> a owl:NamedIndividual,
        warp:DoseLevelEnum ;
    rdfs:label "higher_than_comparator" ;
    skos:definition "Higher than the arm it is compared with, where the source does not say what that arm was. Prefer an ordinal value where the source names one." ;
