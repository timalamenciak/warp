        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcosystemAttributeEnum ;
            owl:onProperty warp:attributes_assessed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:specified_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ReferenceBasisEnum ;
            owl:onProperty warp:reference_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:human_caused ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:supersedes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaStatusEnum ;
            owl:onProperty warp:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaConceptEnum ;
            owl:onProperty warp:operationalizes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:reference_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:operationalizes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:reference_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:criteria_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoDocument ;
            owl:onProperty warp:specified_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:baseline_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaSet ;
            owl:onProperty warp:supersedes ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ThresholdKindEnum ;
            owl:onProperty warp:threshold_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:assessment_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:threshold_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:human_caused ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:criteria_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:issued_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:operationalizes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:baseline_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:supersedes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:human_caused ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:criteria_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:issued_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:threshold_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ] ) ] ;
            owl:onProperty warp:baseline_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:issued_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AssessmentUnitEnum ;
            owl:onProperty warp:assessment_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:threshold_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:threshold_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:assessment_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:assessment_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:attributes_assessed ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AssessmentBasisEnum ;
            owl:onProperty warp:assessment_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:threshold_text ] ;
    skos:definition "One body's versioned definition of a concept such as \"degraded area\": a particular, but an information record, not a node. A stated, versioned test that criteria statements apply, described only by a fixed set of definitional elements plus its verbatim text, so a definition never becomes its own small graph. Taxa, indicator variables and measured values never appear here: they belong in the evidence for a criteria statement. Deliberately not an OWL definition, so a verdict can never be inferred, and a definition can change without any record being rewritten." ;
    skos:exactMatch warp:CriteriaSet ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:DeonticForceEnum a owl:Class ;
    rdfs:label "DeonticForceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DeonticForceEnum#required> <https://w3id.org/ecoweaver/warp/DeonticForceEnum#recommended> <https://w3id.org/ecoweaver/warp/DeonticForceEnum#suggested> <https://w3id.org/ecoweaver/warp/DeonticForceEnum#optional> ) ] ;
    skos:definition "How strongly the guidance binds. Not part of identity." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DeonticForceEnum#optional>,
        <https://w3id.org/ecoweaver/warp/DeonticForceEnum#recommended>,
        <https://w3id.org/ecoweaver/warp/DeonticForceEnum#required>,
        <https://w3id.org/ecoweaver/warp/DeonticForceEnum#suggested> .

warp:EvidenceObjectEnum a owl:Class ;
    rdfs:label "EvidenceObjectEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#correlation> <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#mechanism> <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#both> ) ] ;
    skos:definition "OBJECT of evidence per the Russo-Williamson Thesis: whether the evidence supports correlation (difference-making), mechanism (production), or both." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#both>,
        <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#correlation>,
        <https://w3id.org/ecoweaver/warp/EvidenceObjectEnum#mechanism> .

warp:EvidenceStrengthEnum a owl:Class ;
    rdfs:label "EvidenceStrengthEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#strong> <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#moderate> <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#weak> <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#not_assessed> ) ] ;
    skos:definition "Qualitative strength of the support an evidence line provides toward its target proposition, in the indicated direction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#moderate>,
        <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#strong>,
        <https://w3id.org/ecoweaver/warp/EvidenceStrengthEnum#weak> .

warp:GeometryPrecisionEnum a owl:Class ;
    rdfs:label "GeometryPrecisionEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#exact> <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#generalized> <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#centroid> <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#withheld> ) ] ;
    skos:definition "How precise a site's recorded geometry is. Required: matching and area sums need to know." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#centroid>,
        <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#exact>,
        <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#generalized>,
        <https://w3id.org/ecoweaver/warp/GeometryPrecisionEnum#withheld> .

warp:ImplementationStatement a owl:Class ;
    rdfs:label "ImplementationStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ImplementationQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoStatement ;
    skos:definition "That a strategy (or action) was carried out at a site, over a period, as reported by an implementer, funder, program or researcher (the claimant). Scope is always assertional. Statements about the same work are grouped into a derived project by scripts/derive_projects.py (warp-impl-identity/1), not by the shared identity key. Annotator's test: does the source say this was done, or that it should be done? Planned work is an implementation statement only when committed to a specific site; otherwise it is a recommendation." ;
    skos:exactMatch warp:ImplementationStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_derived_by "derive_projects.py" ;
    warp:warp_group "implementation" ;
    warp:warp_identity_rule "warp-impl-identity/1" ;
    warp:warp_proposition_class "ImplementationProposition" ;
    warp:warp_propositions_slot "implementation_propositions" ;
    warp:warp_statements_slot "implementation_statements" .

warp:InteractionEffectEnum a owl:Class ;
    rdfs:label "InteractionEffectEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/InteractionEffectEnum#positive> <https://w3id.org/ecoweaver/warp/InteractionEffectEnum#negative> <https://w3id.org/ecoweaver/warp/InteractionEffectEnum#neutral> ) ] ;
    skos:definition "Sign of an interaction's effect on one partner." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/InteractionEffectEnum#negative>,
        <https://w3id.org/ecoweaver/warp/InteractionEffectEnum#neutral>,
        <https://w3id.org/ecoweaver/warp/InteractionEffectEnum#positive> .

warp:IntervalTypeEnum a owl:Class ;
    rdfs:label "IntervalTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#confidence> <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#credible> <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#standard_error_range> <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#standard_deviation_range> ) ] ;
    skos:definition "The kind of uncertainty interval reported around an effect size." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#confidence>,
        <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#credible>,
        <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#standard_deviation_range>,
        <https://w3id.org/ecoweaver/warp/IntervalTypeEnum#standard_error_range> .

warp:ModalityEnum a owl:Class ;
    rdfs:label "ModalityEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ModalityEnum#observed> <https://w3id.org/ecoweaver/warp/ModalityEnum#inferred> <https://w3id.org/ecoweaver/warp/ModalityEnum#anticipated> ) ] ;
    skos:definition "Whether a statement reports, infers or forecasts. Not hedging: hedging (causal_language) is how sure the speaker sounds; modality is what kind of statement it is. \"Stocking will reduce abundance\" may be said confidently and is still anticipated." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ModalityEnum#anticipated>,
        <https://w3id.org/ecoweaver/warp/ModalityEnum#inferred>,
        <https://w3id.org/ecoweaver/warp/ModalityEnum#observed> .

warp:ProximateDistalEnum a owl:Class ;
    rdfs:label "ProximateDistalEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ProximateDistalEnum#proximate> <https://w3id.org/ecoweaver/warp/ProximateDistalEnum#distal> <https://w3id.org/ecoweaver/warp/ProximateDistalEnum#both_specified> ) ] ;
    skos:definition "Whether the cause is positioned as proximate, distal, or both." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ProximateDistalEnum#both_specified>,
        <https://w3id.org/ecoweaver/warp/ProximateDistalEnum#distal>,
        <https://w3id.org/ecoweaver/warp/ProximateDistalEnum#proximate> .

warp:QualifierFamilyEnum a owl:Class ;
    rdfs:label "QualifierFamilyEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#directional_change> <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#presence> <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#membership_change> <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#process_phase> ) ] ;
    skos:definition "Groups StateOrChangeQualifierEnum values into mutually exclusive families. A set of qualifiers forms a valid state space only if all members share a family." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#directional_change>,
        <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#membership_change>,
        <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#presence>,
        <https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#process_phase> .

warp:ReferenceBasisEnum a owl:Class ;
    rdfs:label "ReferenceBasisEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#reference_ecosystem> <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#historical_baseline> <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#potential_natural_state> <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#policy_target> ) ] ;
    skos:definition "Degraded compared with what?" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#historical_baseline>,
