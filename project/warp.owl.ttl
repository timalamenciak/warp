    linkml:permissible_values <https://w3id.org/ecoweaver/warp/TenureEnum#indigenous>,
        <https://w3id.org/ecoweaver/warp/TenureEnum#mixed>,
        <https://w3id.org/ecoweaver/warp/TenureEnum#private>,
        <https://w3id.org/ecoweaver/warp/TenureEnum#public> .

warp:ThresholdKindEnum a owl:Class ;
