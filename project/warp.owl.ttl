        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#ordinal>,
        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#proportion> .

warp:CertaintyGradeEnum a owl:Class ;
    rdfs:label "CertaintyGradeEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#high> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#moderate> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#low> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#not_assessed> ) ;
