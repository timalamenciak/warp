warp:unit a owl:ObjectProperty .

causal_mosaic:CausalNode a owl:Class ;
    rdfs:label "CausalNode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:QuantityValue ;
            owl:onProperty causal_mosaic:spatial_grain ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TextSpan ;
            owl:onProperty causal_mosaic:source_spans ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:embedding_text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:life_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:composition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:life_stage_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EntityTypeEnum ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CompositionAnnotation ;
            owl:onProperty causal_mosaic:composition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:life_stage_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:AppliedToEntity ;
            owl:onProperty causal_mosaic:applied_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:embedding_vector ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:StateOrChangeQualifierEnum ;
            owl:onProperty causal_mosaic:state_or_change_qualifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:applied_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:source_spans ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:parameter_options ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:measured_attribute ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:life_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^(orcid:\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]|camo_agent:[A-Za-z0-9._-]+)$" ] ) ] ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:spatial_grain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:embedding_vector ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:QuantityValue ;
            owl:onProperty causal_mosaic:components ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:variable_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:variable_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:embedding_vector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:life_stage_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:LifeStageEnum ;
            owl:onProperty camo:life_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:state_or_change_qualifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:state_or_change_qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:embedding_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:nativeness_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:spatial_grain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:embedding_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:variable_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:measured_attribute ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:composition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:NativenessBasisEnum ;
            owl:onProperty causal_mosaic:nativeness_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:measured_attribute ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:nativeness_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ParameterOption ;
            owl:onProperty causal_mosaic:parameter_options ] ;
    skos:definition """A node in the labeled property graph representing a causally active ecological entity — specifically, a state or change in state of an environmental variable or process. Merges ELMO's entity structure (Alamenciak et al. 2025) with CAMO's annotation requirements.\r
Key design principle: causation in ecology is represented between states or changes in state, not between things alone. A taxon does not cause anything by itself; the causally relevant annotation concerns the state or change of an attribute of a taxon. Therefore each node decomposes into:\r
\r
  entity: what thing (taxon, chemical, abiotic factor, process)\r
  attribute: what measurable property (abundance, cover, rate)\r
  qualifier: whether or how it changed (present, increased, etc.)\r
\r
The human-readable 'name' is the composed form: "Increased abundance of Canis lupus". The structured fields allow decomposed querying: "show me all claims involving Canis lupus" or "all claims about abundance changes" or "all claims where abundance decreased."\r
This pattern corresponds to ELMO's subject/object value + derivative qualifier + state/change qualifier structure.\r
For taxon-specific measurements a two-path model applies. Single-taxon measurements use entity_type: taxon, with the NCBITaxon ID in entity_term and the measured property in measured_attribute — the taxon node is both organism and measurement and participates directly in causal edges. Multi-taxon aggregates and ecological guilds ("native species", "shade-tolerant species") use entity_type: composite_variable with one or more NCBITaxon IDs or free-text guild names in applied_to. Causal edges are never used for taxon-to-measurement links; applied_to is a queryable annotation field only.""" ;
    skos:exactMatch causal_mosaic:CausalNode ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

warp:AnalysisMethodEnum a owl:Class ;
    rdfs:label "AnalysisMethodEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#anova> <http://purl.obolibrary.org/obo/STATO_0000454> <http://purl.obolibrary.org/obo/STATO_0000189> <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#regression> <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#ordination> <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#multivariate_other> <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#nonparametric> <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#bayesian> <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#descriptive_only> ) ] ;
    skos:definition "The analysis that produced the reported result. Not the study design, which is EvidenceTypeEnum: a controlled browsing experiment analysed with a mixed model is randomized_experiment there and mixed_model here. Values carry a STATO mapping only where a verified equivalent exists; the rest are left unmapped rather than attached to an approximate term." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <http://purl.obolibrary.org/obo/STATO_0000189>,
        <http://purl.obolibrary.org/obo/STATO_0000454>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#anova>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#bayesian>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#descriptive_only>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#multivariate_other>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#nonparametric>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#ordination>,
        <https://w3id.org/ecoweaver/warp/AnalysisMethodEnum#regression> .

warp:BradfordHillViewpointEnum a owl:Class ;
    rdfs:label "BradfordHillViewpointEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#strength> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#consistency> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#specificity> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#temporality> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#biological_gradient> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#plausibility> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#coherence> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#experiment> <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#analogy> ) ] ;
    skos:definition "Bradford Hill's nine 'viewpoints' (1965) for assessing causal claims from observational evidence. Maps onto the philosophical accounts." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#analogy>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#biological_gradient>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#coherence>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#consistency>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#experiment>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#plausibility>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#specificity>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#strength>,
        <https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#temporality> .

warp:LifeStageEnum a owl:Class ;
    rdfs:label "LifeStageEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/LifeStageEnum#seed_or_seed_bank> <https://w3id.org/ecoweaver/warp/LifeStageEnum#germinant_or_seedling> <https://w3id.org/ecoweaver/warp/LifeStageEnum#juvenile> <https://w3id.org/ecoweaver/warp/LifeStageEnum#ramet_or_clonal_unit> <https://w3id.org/ecoweaver/warp/LifeStageEnum#reproductive_adult> <https://w3id.org/ecoweaver/warp/LifeStageEnum#senescent_or_dead> <https://w3id.org/ecoweaver/warp/LifeStageEnum#mixed_or_whole_population> <https://w3id.org/ecoweaver/warp/LifeStageEnum#not_specified> ) ] ;
    skos:definition "The life stage of the organism a node measures, as a coarse facet that cross-taxon queries can group on. Deliberately coarse: developmental stage vocabularies are kingdom-specific, so the precise term belongs in life_stage_term - a PO development-stage term for plants, a UBERON life-cycle-stage term for animals - while this enum stays usable across a graph that annotates plants, birds and mammals together. Values are mapped close, never exact, because each spans kingdoms and the source terms do not." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/LifeStageEnum#germinant_or_seedling>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#juvenile>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#mixed_or_whole_population>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#not_specified>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#ramet_or_clonal_unit>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#reproductive_adult>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#seed_or_seed_bank>,
        <https://w3id.org/ecoweaver/warp/LifeStageEnum#senescent_or_dead> .

warp:place a owl:ObjectProperty ;
    rdfs:label "place" ;
    skos:definition "The REGION the statement is about, as an IRI from a registered place scheme: an ISO 3166-2 code for a province or state (ISO3166-2:CA-SK); a Wikidata item for a municipality, park, lake or territory (wd:Q...); a GeoNames or Getty TGN entry where Wikidata has none; an ENVO ecoregion individual; or, failing all of these, a locally minted place: concept with a TODO to replace it. Never a bare name, never a coordinate pair standing in for an area. Not the kind of ecosystem, which is ecosystem_context. Part of the identity key for tolerance and cost statements (decision D18). How to find an IRI: docs/values.md." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_allowed_prefixes "ISO3166-2 wd geonames tgn ENVO place TODO" .

warp:DoseLevelEnum a owl:Class ;
    rdfs:label "DoseLevelEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DoseLevelEnum#absent> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#low> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#intermediate> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#high> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#very_high> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#higher_than_comparator> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#lower_than_comparator> <https://w3id.org/ecoweaver/warp/DoseLevelEnum#not_specified> ) ] ;
    skos:definition "A driver or intervention level that the source names without quantifying, e.g. \"heavy browsing pressure\" or \"intermediate densities\". The first five values are ordinal, running from absent to very_high along one scale; the two relative values are for sources that compare with an arm they do not state. Use CausalEdge.dose for a reported quantity and CausalEdge.dose_level for a named level; a source giving both takes both. These values are deliberately unmapped: no OBO ontology carries an ordinal driver-intensity scale, and PATO magnitude qualities describe an outcome rather than a driver's level, so mapping to them would assert something false." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DoseLevelEnum#absent>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#high>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#higher_than_comparator>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#intermediate>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#low>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#lower_than_comparator>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#not_specified>,
        <https://w3id.org/ecoweaver/warp/DoseLevelEnum#very_high> .

