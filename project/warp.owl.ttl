        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:contributing_sole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:mediation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:moderation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:determinism ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ProximateDistalEnum ;
            owl:onProperty warp:proximate_distal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:determinism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:necessity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:proximate_distal ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty warp:specificity ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty warp:necessity ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:StrengthAnnotation ;
            owl:onProperty warp:effect_strength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:temporal_ordering ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:moderation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:sufficiency ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty warp:temporal_ordering ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:philosophical_accounts ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:PhilosophicalAccountEnum ;
            owl:onProperty warp:philosophical_accounts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:stability ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ReversibilityEnum ;
            owl:onProperty warp:reversibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty warp:stability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:sufficiency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contributing_sole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:reversibility ],
        [ a owl:Restriction ;
