    skos:definition "Reported descriptively; no test was applied." .

warp:SiteDefinition a owl:Class ;
    rdfs:label "SiteDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:GeometryPrecisionEnum ;
            owl:onProperty warp:geometry_precision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:ecosystem_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:tenure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CareMetadata ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoDocument ;
            owl:onProperty warp:specified_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:TenureEnum ;
            owl:onProperty warp:tenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:ecosystem_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:jurisdiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:geometry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:geometry_precision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:specified_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:tenure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:area_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:area_source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:geometry_precision ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AreaSourceEnum ;
            owl:onProperty warp:area_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:jurisdiction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:jurisdiction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:label ],
        warp:NodeDefinition ;
    skos:definition "One piece of ground: the place a strategy is carried out, or whose condition is assessed. A node, so any group can point at it, but unlike every other node a particular, not a kind of thing (decisions D7, D11). Its ID is under site:, never node:, and it is written to OWL as a named individual in project/sites.ttl, typed by its ecosystem types, with its label and jurisdiction. Geometry never goes into a generated output. Checked by scripts/check_sites.py." ;
    skos:exactMatch warp:SiteDefinition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#aborted> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "aborted" ;
    skos:definition "The process/event was stopped before completion (e.g., management intervention)." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "aborted" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#absent> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "absent" ;
    skos:definition "The entity or attribute is absent (binary state)." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "presence" ;
    warp:rosetta_prefix "absence of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#decreased> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "decreased" ;
    skos:definition "The attribute value decreases." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "directional_change" ;
    warp:rosetta_prefix "decreased" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#increased> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "increased" ;
    skos:definition "The attribute value increases." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "directional_change" ;
    warp:rosetta_prefix "increased" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#initiated> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "initiated" ;
    skos:definition "The process/event was started." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "initiation of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#interrupted> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "interrupted" ;
