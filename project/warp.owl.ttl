<https://example.org/sepio-model/Entity> a owl:Class ;
    rdfs:label "Entity" ;
    dcterms:title "Entity" ;
    ns1:status "Draft" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/identifiers> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/identifiers> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Extension> ;
            owl:onProperty <https://example.org/sepio-model/extensions> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/type> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/alternativeLabels> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/alternativeLabels> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/extensions> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/type> ] ;
    skos:definition "Anything that exists, has existed, or will exist." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Entity is the root class of the 'gks-common' core information model. All common classes that have ids and other general metadata like label,  description, type, or extensions descend from this class and inherit its attributes." .

warp:AgentKindEnum a owl:Class ;
    rdfs:label "AgentKindEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AgentKindEnum#researcher> <https://w3id.org/ecoweaver/warp/AgentKindEnum#practitioner> <https://w3id.org/ecoweaver/warp/AgentKindEnum#indigenous_knowledge_holder> <https://w3id.org/ecoweaver/warp/AgentKindEnum#community_member> <https://w3id.org/ecoweaver/warp/AgentKindEnum#organization> <https://w3id.org/ecoweaver/warp/AgentKindEnum#synthesis_pipeline> ) ] ;
    skos:definition "The kind of knowledge an agent brings. Lets practitioners and Indigenous knowledge holders make statements in their own right, not only be sources of evidence for other people's statements. A different axis from SEPIO Agent.subtype (person, organization, software)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AgentKindEnum#community_member>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#indigenous_knowledge_holder>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#organization>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#practitioner>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#researcher>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#synthesis_pipeline> .

warp:CostPhaseEnum a owl:Class ;
    rdfs:label "CostPhaseEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CostPhaseEnum#initial> <https://w3id.org/ecoweaver/warp/CostPhaseEnum#follow_up> <https://w3id.org/ecoweaver/warp/CostPhaseEnum#maintenance> <https://w3id.org/ecoweaver/warp/CostPhaseEnum#monitoring> <https://w3id.org/ecoweaver/warp/CostPhaseEnum#whole_project> ) ] ;
    skos:definition "The phase of the work a cost belongs to. In the identity key: initial and maintenance costs never merge. Strategy roles map onto these (StrategyRoleEnum's warp_cost_phase)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CostPhaseEnum#follow_up>,
        <https://w3id.org/ecoweaver/warp/CostPhaseEnum#initial>,
        <https://w3id.org/ecoweaver/warp/CostPhaseEnum#maintenance>,
        <https://w3id.org/ecoweaver/warp/CostPhaseEnum#monitoring>,
        <https://w3id.org/ecoweaver/warp/CostPhaseEnum#whole_project> .

warp:EcosystemAttributeEnum a owl:Class ;
    rdfs:label "EcosystemAttributeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#absence_of_threats> <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#physical_conditions> <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#species_composition> <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#structural_diversity> <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#ecosystem_function> <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#external_exchanges> ) ] ;
    skos:definition "Which aspects of an ecosystem a definition assesses: SER's six key ecosystem attributes. PROVISIONAL (proposal Q4): the vocabulary may be replaced by IUCN Red List of Ecosystems criteria, FAO FERM, or whatever the federal process settles on." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#absence_of_threats>,
        <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#ecosystem_function>,
        <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#external_exchanges>,
        <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#physical_conditions>,
        <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#species_composition>,
        <https://w3id.org/ecoweaver/warp/EcosystemAttributeEnum#structural_diversity> .

warp:EntityTypeEnum a owl:Class ;
    rdfs:label "EntityTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( BFO:0000019 BFO:0000019 BFO:0000015 <https://w3id.org/elmo/cas/ConservationAction> <https://w3id.org/ecoweaver/warp/EntityTypeEnum#taxon> ) ] ;
    skos:definition "The type of ecological entity at the core of a node, following ELMO's distinction between environmental variables and environmental processes. This classification determines how the node's attribute and state/change qualifier are interpreted." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values BFO:0000015,
        BFO:0000019,
        <https://w3id.org/ecoweaver/warp/EntityTypeEnum#taxon>,
        <https://w3id.org/elmo/cas/ConservationAction> .

warp:EvidenceDirectionEnum a owl:Class ;
    rdfs:label "EvidenceDirectionEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#disputes> <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#neutral> ) ] ;
    skos:definition "SEPIO direction: whether a statement (in Proposition Assessment Mode) or an evidence line supports, disputes, or is neutral toward a proposition. NOT causal direction, which is CausalPredicateQualifiers.causal_direction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#disputes>,
        <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#neutral>,
        <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> .

warp:ImplementationStatusEnum a owl:Class ;
    rdfs:label "ImplementationStatusEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#planned> <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#in_progress> <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#completed> <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#maintained> <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#abandoned> ) ] ;
    skos:definition "The state of the work as of reported_on. Later reports supersede, within one claimant." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#abandoned>,
        <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#completed>,
        <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#in_progress>,
        <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#maintained>,
        <https://w3id.org/ecoweaver/warp/ImplementationStatusEnum#planned> .

warp:SemanticUnitScopeEnum a owl:Class ;
    rdfs:label "SemanticUnitScopeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#assertional> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#contingent> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#prototypical> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#universal> ) ] ;
    skos:definition "The scope of what a statement asserts, following Vogt's semantic unit types for statement units. Scope is part of a proposition's identity: \"X reduced Y on this plot\" and \"X typically reduces Y\" are different propositions. Definitions below are working glosses and must be checked against Vogt's own definitions before release." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "Matches CAMO 0.10.0's scope values. For legacy token_or_type, migration default: token -> assertional; type -> prototypical (most ecological generalizations hold typically, with exceptions, rather than universally); ambiguous/not_addressed -> unclear." ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#assertional>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#contingent>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#prototypical>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#universal> .

warp:StrategyRoleEnum a owl:Class ;
    rdfs:label "StrategyRoleEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#site_preparation> <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#establishment> <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#follow_up> <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#maintenance> <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#monitoring> ) ] ;
    skos:definition "What a strategy component does in the strategy. Each value names the cost phase it falls in (warp_cost_phase), so a phase-level cost can say which components it covers (R10)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#establishment>,
        <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#follow_up>,
        <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#maintenance>,
        <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#monitoring>,
        <https://w3id.org/ecoweaver/warp/StrategyRoleEnum#site_preparation> .

warp:ToleranceResponseEnum a owl:Class ;
    rdfs:label "ToleranceResponseEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#occurrence> <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#germination> <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#establishment> <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#growth> <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#survival> <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#reproduction> ) ] ;
    skos:definition "What a tolerance range was judged against." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#establishment>,
        <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#germination>,
        <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#growth>,
        <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#occurrence>,
        <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#reproduction>,
        <https://w3id.org/ecoweaver/warp/ToleranceResponseEnum#survival> .

warp:ValueTypeEnum a owl:Class ;
    rdfs:label "ValueTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ValueTypeEnum#continuous> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#count> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#proportion> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#binary> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#ordinal> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#categorical> ) ] ;
    skos:definition "The kind of value a parameter option produces. The compatible_qualifier_families annotation lists the QualifierFamilyEnum families whose nodes that value type can supply; a pipe-separated list, checked by ci.py." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ValueTypeEnum#binary>,
        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#categorical>,
        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#continuous>,
        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#count>,
        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#ordinal>,
        <https://w3id.org/ecoweaver/warp/ValueTypeEnum#proportion> .

causal_mosaic:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:verbatim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:maximum_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^(unit|UO):\\S+$" ] ) ] ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:unit_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:minimum_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:unit_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:counted_entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:counted_entity ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:numeric_value ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:minimum_value ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:maximum_value ] ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:verbatim ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:unit_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:numeric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:minimum_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:verbatim ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:AppliedToEntity ;
            owl:onProperty causal_mosaic:counted_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:minimum_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:maximum_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:maximum_value ] ;
    skos:definition "A reported quantity: a single value or a range, its unit, and the entity being counted or measured. Used for intervention doses (CausalEdge.dose), intervention components (CausalNode.components) and sampling grain (CausalNode.spatial_grain). Give numeric_value for a single value, or minimum_value and/or maximum_value for a range or threshold (\"5 or more\" is minimum_value 5 with no maximum)." ;
    skos:exactMatch causal_mosaic:QuantityValue ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

warp:CompositionBasisEnum a owl:Class ;
    rdfs:label "CompositionBasisEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#relative_abundance> <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#cover> <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#biomass> <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#density> <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#detection_frequency> <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#frequency_of_occurrence> <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#other> ) ] ;
    skos:definition "What a reported membership share measures. An assemblage share is only interpretable against its basis: 90% of individuals is not 90% of cover and not 90% of detections." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#biomass>,
        <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#cover>,
        <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#density>,
        <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#detection_frequency>,
        <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#frequency_of_occurrence>,
        <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#other>,
        <https://w3id.org/ecoweaver/warp/CompositionBasisEnum#relative_abundance> .

warp:EvidenceBalanceEnum a owl:Class ;
    rdfs:label "EvidenceBalanceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#supportive> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#mixed> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#conflicting> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#insufficient> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#no_evidence> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#not_assessed> ) ] ;
    skos:definition "Overall balance of evidence across included article-level causal edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#conflicting>,
        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#insufficient>,
        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#mixed>,
        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#no_evidence>,
        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#supportive> .

warp:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:unit ] ;
    skos:definition "A number with a unit. Where a proposal sketch says QuantityValue, it means this (R1). A count of things (46 protected areas) is a Count, not a Quantity: \"protected area\" is not a unit." ;
    skos:exactMatch warp:Quantity ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:specified_in a owl:ObjectProperty ;
    rdfs:label "specified_in" ;
    rdfs:range warp:EcoDocument ;
    skos:definition "Plan documents that specify what was, or is to be, done: a recovery strategy, a restoration plan, a work order. Referenced by id, not inlined. Used by strategies and implementation statements.",
        "The document the definition is written in." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:AssessmentStatusEnum a owl:Class ;
    rdfs:label "AssessmentStatusEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#satisfied> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#partially_satisfied> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_satisfied> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#mixed> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#insufficient_evidence> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_assessed> ) ] ;
    skos:definition "Aggregate assessment status for evidence-base-level criteria." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#insufficient_evidence>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#mixed>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_satisfied>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#partially_satisfied>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#satisfied> .

warp:CertaintyGradeEnum a owl:Class ;
    rdfs:label "CertaintyGradeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#high> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#moderate> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#low> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#not_assessed> ) ] ;
    skos:definition "GRADE-style certainty assessment for causal claims. Controls downstream language in Rosetta Statement rendering." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#high>,
        <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#low>,
        <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#moderate>,
        <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> .

warp:ComparatorTypeEnum a owl:Class ;
    rdfs:label "ComparatorTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#untreated_control> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#reference_undisturbed> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#pre_treatment_baseline> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_treatment> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#passive_management_arm> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#spatial_or_temporal_control> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_dose_level> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_applicable> ) ] ;
    skos:definition "The basis against which the effect described by an edge was assessed — what the claim is relative to. Experimental controls are recorded here rather than as nodes. A control is not a state or change in state, so it fails the CausalNode test, but it is not neutral either: the same reported effect means different things measured against untreated plots, against undisturbed remnant, or against the same plots before treatment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_dose_level>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_treatment>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_applicable>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#passive_management_arm>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#pre_treatment_baseline>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#reference_undisturbed>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#spatial_or_temporal_control>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#untreated_control> .

warp:DocumentSectionEnum a owl:Class ;
    rdfs:label "DocumentSectionEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#title> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#abstract> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#introduction> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#methods> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#results> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#discussion> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#conclusion> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#supplementary> ) ] ;
