<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#introduced> a owl:NamedIndividual,
        warp:StateOrChangeQualifierEnum ;
    rdfs:label "introduced" ;
    skos:definition "The entity has been introduced to the system (invasion, reintroduction)." ;
