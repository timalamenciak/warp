        <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#potential_natural_state>,
        <https://w3id.org/ecoweaver/warp/ReferenceBasisEnum#reference_ecosystem> .

warp:ReportingLevelEnum a owl:Class ;
    rdfs:label "ReportingLevelEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ReportingLevelEnum#intervention> <https://w3id.org/ecoweaver/warp/ReportingLevelEnum#program> <https://w3id.org/ecoweaver/warp/ReportingLevelEnum#organization> ) ] ;
    skos:definition "Whose costs: the action's own, a share of a program's, or of an organization's. In the identity key." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ReportingLevelEnum#intervention>,
        <https://w3id.org/ecoweaver/warp/ReportingLevelEnum#organization>,
        <https://w3id.org/ecoweaver/warp/ReportingLevelEnum#program> .

warp:ScopeEnum a owl:Class ;
    rdfs:label "ScopeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ScopeEnum#assertional> <https://w3id.org/ecoweaver/warp/ScopeEnum#contingent> <https://w3id.org/ecoweaver/warp/ScopeEnum#prototypical> <https://w3id.org/ecoweaver/warp/ScopeEnum#universal> ) ] ;
    skos:definition "What a claim is about, following Vogt's semantic unit types. Replaces TokenTypeEnum for new records. Values and definitions must match WARP's SemanticUnitScopeEnum, so that ingestion copies them unchanged." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ScopeEnum#assertional>,
        <https://w3id.org/ecoweaver/warp/ScopeEnum#contingent>,
        <https://w3id.org/ecoweaver/warp/ScopeEnum#prototypical>,
        <https://w3id.org/ecoweaver/warp/ScopeEnum#universal> .

warp:SignificanceEnum a owl:Class ;
    rdfs:label "SignificanceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://purl.obolibrary.org/obo/STATO_0000734> <http://purl.obolibrary.org/obo/STATO_0000735> <https://w3id.org/ecoweaver/warp/SignificanceEnum#marginal> <https://w3id.org/ecoweaver/warp/SignificanceEnum#not_tested> ) ] ;
    skos:definition "Whether the source reported this relationship as statistically significant. Separate from causal_language, which records how strongly the text commits causally, and from negated, which encodes a null result: a finding can be non-significant without the authors asserting that no relationship holds. The two non-verdict values matter as much as the verdicts, because without them an evidence gap map cannot tell \"tested and not significant\" from \"never tested\"." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <http://purl.obolibrary.org/obo/STATO_0000734>,
        <http://purl.obolibrary.org/obo/STATO_0000735>,
        <https://w3id.org/ecoweaver/warp/SignificanceEnum#marginal>,
        <https://w3id.org/ecoweaver/warp/SignificanceEnum#not_tested> .

warp:TenureEnum a owl:Class ;
    rdfs:label "TenureEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/TenureEnum#public> <https://w3id.org/ecoweaver/warp/TenureEnum#private> <https://w3id.org/ecoweaver/warp/TenureEnum#indigenous> <https://w3id.org/ecoweaver/warp/TenureEnum#mixed> ) ] ;
