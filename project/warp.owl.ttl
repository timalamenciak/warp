            owl:onProperty causal_mosaic:evidential_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:aggregate_certainty_rationale ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty causal_mosaic:last_refreshed_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:last_refreshed_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:has_difference_making_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:needs_refresh ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:needs_refresh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:assessed_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalPredicateEnum ;
            owl:onProperty causal_mosaic:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:context_dependence_summary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:assessed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:assessment_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:assessed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:aggregate_certainty_grade ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:assessment_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:assessment_timestamp ] ;
    skos:definition "A derived evidence-base-level assessment for a causal relationship, computed or curated from multiple article-level CausalEdge records that refer to the same or comparable subject-predicate-object relationship. This class is intended for synthesis and graph analysis, not for per-article annotation. It can be regenerated when the evidence base changes, reducing annotator effort by avoiding repeated aggregate judgments such as Russo-Williamson satisfaction on every article-level edge." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

