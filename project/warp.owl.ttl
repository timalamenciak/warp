warp:negated a owl:DatatypeProperty .

warp:predicate_qualifiers a owl:ObjectProperty .

warp:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:range warp:SemanticUnitScopeEnum ;
    skos:definition "Semantic unit type of what is stated or proposed. Part of a proposition's identity; copied onto statements so propositions can be derived from them." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://example.org/sepio-model/Entity> a owl:Class ;
    rdfs:label "Entity" ;
    dcterms:title "Entity" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/identifiers> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/extensions> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/alternativeLabels> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Extension> ;
            owl:onProperty <https://example.org/sepio-model/extensions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/alternativeLabels> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/identifiers> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/label> ] ;
    skos:definition "Anything that exists, has existed, or will exist." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Entity is the root class of the 'gks-common' core information model. All common classes that have ids and other general metadata like label,  description, type, or extensions descend from this class and inherit its attributes." .

warp:AgentKindEnum a owl:Class ;
    rdfs:label "AgentKindEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/AgentKindEnum#researcher> <https://w3id.org/ecoweaver/warp/AgentKindEnum#practitioner> <https://w3id.org/ecoweaver/warp/AgentKindEnum#indigenous_knowledge_holder> <https://w3id.org/ecoweaver/warp/AgentKindEnum#community_member> <https://w3id.org/ecoweaver/warp/AgentKindEnum#organization> <https://w3id.org/ecoweaver/warp/AgentKindEnum#synthesis_pipeline> ) ;
    skos:definition "The kind of knowledge an agent brings. Lets practitioners and Indigenous knowledge holders make statements in their own right, not only be sources of evidence for other people's statements. A different axis from SEPIO Agent.subtype (person, organization, software)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AgentKindEnum#community_member>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#indigenous_knowledge_holder>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#organization>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#practitioner>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#researcher>,
        <https://w3id.org/ecoweaver/warp/AgentKindEnum#synthesis_pipeline> .

warp:DeterminismEnum a owl:Class ;
    rdfs:label "DeterminismEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/DeterminismEnum#deterministic_process> <https://w3id.org/ecoweaver/warp/DeterminismEnum#indeterministic_process> <https://w3id.org/ecoweaver/warp/DeterminismEnum#epistemic_probability_only> <https://w3id.org/ecoweaver/warp/DeterminismEnum#ambiguous> <https://w3id.org/ecoweaver/warp/DeterminismEnum#not_addressed> ) ;
    skos:definition "Whether the causal relationship frames the underlying process as deterministic or indeterministic, or uses probability only to express epistemic uncertainty." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DeterminismEnum#ambiguous>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#deterministic_process>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#epistemic_probability_only>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#indeterministic_process>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#not_addressed> .

warp:EntityTypeEnum a owl:Class ;
    rdfs:label "EntityTypeEnum" ;
    owl:unionOf ( BFO:0000019 BFO:0000015 <https://w3id.org/elmo/cas/ConservationAction> <https://w3id.org/ecoweaver/warp/EntityTypeEnum#taxon> ) ;
    skos:definition "The type of ecological entity at the core of a node, following ELMO's distinction between environmental variables and environmental processes. This classification determines how the node's attribute and state/change qualifier are interpreted." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values BFO:0000015,
        BFO:0000019,
        <https://w3id.org/ecoweaver/warp/EntityTypeEnum#taxon>,
        <https://w3id.org/elmo/cas/ConservationAction> .

warp:ReversibilityEnum a owl:Class ;
    rdfs:label "ReversibilityEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/ReversibilityEnum#reversible> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#irreversible> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#partially_reversible> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#hysteresis> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#not_addressed> ) ;
    skos:definition "Whether removing the cause undoes the effect. Central to restoration ecology where hysteresis and alternative stable states are key concerns." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ReversibilityEnum#hysteresis>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#irreversible>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#not_addressed>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#partially_reversible>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#reversible> .

warp:ValueTypeEnum a owl:Class ;
    rdfs:label "ValueTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/ValueTypeEnum#continuous> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#count> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#proportion> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#binary> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#ordinal> <https://w3id.org/ecoweaver/warp/ValueTypeEnum#categorical> ) ;
    skos:definition "The kind of value a parameter option produces. The compatible_qualifier_families annotation lists the QualifierFamilyEnum families whose nodes that value type can supply; a pipe-separated list, checked by ci.py." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
