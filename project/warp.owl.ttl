<https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#saturating> a owl:NamedIndividual,
        warp:DoseResponseShapeEnum ;
    rdfs:label "saturating" ;
    skos:definition "The effect increases with dose and then levels off." .

<https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#threshold> a owl:NamedIndividual,
        warp:DoseResponseShapeEnum ;
    rdfs:label "threshold" ;
