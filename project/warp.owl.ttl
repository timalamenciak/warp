    rdfs:subClassOf warp:DirectionStatusEnum ;
    skos:definition "Direction of causation is asserted." .

<https://w3id.org/ecoweaver/warp/DirectionStatusEnum#bidirectional> a owl:Class ;
    rdfs:label "bidirectional" ;
    rdfs:subClassOf warp:DirectionStatusEnum ;
    skos:definition "Bidirectional or reciprocal causation is described." .

<https://w3id.org/ecoweaver/warp/DirectionStatusEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:DirectionStatusEnum ;
    skos:definition "Direction is not discussed." .

<https://w3id.org/ecoweaver/warp/DirectionStatusEnum#uncertain> a owl:Class ;
    rdfs:label "uncertain" ;
    rdfs:subClassOf warp:DirectionStatusEnum ;
    skos:definition "Direction is acknowledged as uncertain or debated." .

<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#abstract> a owl:Class ;
    rdfs:label "abstract" ;
    rdfs:subClassOf warp:DocumentSectionEnum ;
    skos:definition "Abstract." .

<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#conclusion> a owl:Class ;
    rdfs:label "conclusion" ;
    rdfs:subClassOf warp:DocumentSectionEnum ;
    skos:definition "Conclusion." .

<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#discussion> a owl:Class ;
    rdfs:label "discussion" ;
    rdfs:subClassOf warp:DocumentSectionEnum ;
    skos:definition "Discussion section." .

<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#introduction> a owl:Class ;
    rdfs:label "introduction" ;
    rdfs:subClassOf warp:DocumentSectionEnum ;
    skos:definition "Introduction or background." .

<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#methods> a owl:Class ;
