    linkml:permissible_values <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#antagonistic>,
        <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#not_specified>,
        <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#qualitative>,
        <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#quantitative>,
        <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#synergistic> .

warp:Period a owl:Class ;
    rdfs:label "Period" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:end ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ] ) ] ;
            owl:onProperty warp:end ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ] ) ] ;
            owl:onProperty warp:start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:start ] ;
    skos:definition "A calendar period. CAMO's TemporalExtent has no start or end, so this is a separate class (R2). Start and end are ISO 8601 strings at whatever granularity the source gives: a year (2023), a year and month (2024-05) or a full date (2026-03-31). An absent end means open or ongoing. Exporters write normalized xsd:dateTime bounds beside the verbatim strings; xsd:date, xsd:gYear and xsd:duration never reach a generated file, because they are not in the OWL 2 datatype map (decision D19). Overlap is computed on the bounds (scripts/warp_time.py), never by comparing strings." ;
    skos:exactMatch warp:Period ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ReversibilityEnum a owl:Class ;
    rdfs:label "ReversibilityEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ReversibilityEnum#reversible> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#irreversible> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#partially_reversible> <https://w3id.org/ecoweaver/warp/ReversibilityEnum#hysteresis> ) ] ;
    skos:definition "Whether removing the cause undoes the effect. Central to restoration ecology where hysteresis and alternative stable states are key concerns." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ReversibilityEnum#hysteresis>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#irreversible>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#partially_reversible>,
        <https://w3id.org/ecoweaver/warp/ReversibilityEnum#reversible> .

warp:StrengthQualitativeEnum a owl:Class ;
    rdfs:label "StrengthQualitativeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#strong> <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#moderate> <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#weak> <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#negligible> <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#not_specified> ) ] ;
    skos:definition "Qualitative categories for the reported strength of a causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#moderate>,
        <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#negligible>,
        <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#not_specified>,
        <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#strong>,
        <https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#weak> .

