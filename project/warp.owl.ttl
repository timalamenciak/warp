            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:document_id ] ;
    skos:definition "Bibliographic metadata and study-level context for the source document. Supports RAG retrieval, evidence gap map construction, and spatiotemporal analysis of the evidence base. Spatial fields enable map-based evidence visualization and proximity-weighted retrieval. Temporal fields enable tracking of when evidence was collected and whether causal relationships vary over time." ;
    skos:exactMatch causal_mosaic:SourceDocument ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:TemporalExtent a owl:Class ;
    rdfs:label "TemporalExtent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty camo:time_since_intervention_months ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:time_since_intervention_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:observation_grain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:time_since_intervention_months ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:time_since_intervention_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:duration_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:time_since_intervention_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:duration_months ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:time_since_intervention_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:observation_grain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:lag_months ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:duration_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SeasonEnum ;
            owl:onProperty causal_mosaic:observation_seasons ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:lag_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:duration_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:observation_seasons ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:lag_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:duration_months ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:observation_grain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:duration_text ] ;
    skos:definition """The temporal window over which a causal effect was observed or measured. Distinct from the study period (when was fieldwork done): this captures the timescale of the causal relationship itself. For example, a study conducted from 2015-2020 might report that invasive removal led to native recovery "within three growing seasons" — the study period is 5 years, but the temporal extent of the causal effect is 3 growing seasons (~18 months).\r
This is important for practitioners who need to know how long to wait for results, and for meta-analysts investigating whether effect sizes vary with observation duration.""" ;
    skos:exactMatch causal_mosaic:TemporalExtent ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:TextSpan a owl:Class ;
