warp:AcquisitionMethodEnum a owl:Class ;
    rdfs:label "AcquisitionMethodEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#in_situ_sensor> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#remote_sensing> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#field_survey> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#camera_trap> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#acoustic_monitoring> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#environmental_dna> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#laboratory_assay> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#citizen_science> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#management_record> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#model_output> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#expert_elicitation> ) ;
    skos:definition "Broad kind of data collection that a parameter option uses. When more than one value fits, choose the most specific (camera_trap rather than in_situ_sensor; environmental_dna rather than laboratory_assay)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#acoustic_monitoring>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#camera_trap>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#citizen_science>,
