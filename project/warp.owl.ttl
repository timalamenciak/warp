            owl:minCardinality 0 ;
            owl:onProperty warp:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:original_text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:recordMetadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SemanticUnitScopeEnum ;
            owl:onProperty warp:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:temporal_extent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:source_spans ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:dateAuthored ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CareMetadata ;
            owl:onProperty warp:care ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:statementText ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ModalityEnum ;
            owl:onProperty warp:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoDocument ;
            owl:onProperty warp:reportedIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:score ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoEvidenceLine ;
            owl:onProperty warp:hasEvidenceLines ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoRecordMetadata ;
            owl:onProperty warp:recordMetadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:temporal_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoProposition ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:statementText ],
        <https://example.org/sepio-model/Statement> ;
    skos:broadMatch IAO:0000030 ;
    skos:definition "A SEPIO Statement about an ecological relationship: a claim of purported truth made by a particular agent on a particular occasion. Annotated statements (CausalStatement, InteractionStatement) are in SEPIO Assertion Mode: they put a proposition forward as true and leave direction, strength and score empty. SynthesisAssessment is the Proposition Assessment Mode subclass." ;
    skos:exactMatch warp:EcoStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "Hedging (how cautiously something is said) belongs to the statement. Scope (what it is said about) belongs to the proposition, and is copied here so propositions can be derived from statements.",
        "Subject, predicate, object and negated are recorded on the statement as annotated, and normalized into a separate Proposition by scripts/derive_propositions.py. SEPIO allows either pattern; WARP uses both, with the Proposition authoritative for identity.",
        "TODO: add exact_mappings to the SEPIO OWL term for 'statement' once its IRI is confirmed; the upstream LinkML schema has no mappings yet." .

warp:EffectMetricEnum a owl:Class ;
    rdfs:label "EffectMetricEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/EffectMetricEnum#raw_mean_difference> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#standardized_mean_difference> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#log_response_ratio> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#percent_change> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#risk_ratio> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#odds_ratio> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#correlation_coefficient> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#regression_coefficient> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#variance_explained> <https://w3id.org/ecoweaver/warp/EffectMetricEnum#other> ) ] ;
    skos:definition "The metric of a reported effect size." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EffectMetricEnum#correlation_coefficient>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#log_response_ratio>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#odds_ratio>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#other>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#percent_change>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#raw_mean_difference>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#regression_coefficient>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#risk_ratio>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#standardized_mean_difference>,
        <https://w3id.org/ecoweaver/warp/EffectMetricEnum#variance_explained> .

warp:PhilosophicalAccountEnum a owl:Class ;
    rdfs:label "PhilosophicalAccountEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( camo:Counterfactual camo:ProbabilisticVariation camo:Interventionist camo:Transmission camo:Mechanistic camo:Regularity camo:INUSComponent camo:Agency ) ] ;
    skos:definition "The philosophical account of causation invoked by a causal claim, per Illari and Russo's (2014) mosaic. Each account offers a different lens on what it means for C to cause E." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values camo:Agency,
        camo:Counterfactual,
        camo:INUSComponent,
        camo:Interventionist,
        camo:Mechanistic,
        camo:ProbabilisticVariation,
        camo:Regularity,
        camo:Transmission .

warp:SeasonEnum a owl:Class ;
    rdfs:label "SeasonEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/SeasonEnum#early_spring> <https://w3id.org/ecoweaver/warp/SeasonEnum#mid_spring> <https://w3id.org/ecoweaver/warp/SeasonEnum#late_spring> <http://purl.obolibrary.org/obo/NCIT_C94731> <https://w3id.org/ecoweaver/warp/SeasonEnum#early_summer> <http://purl.obolibrary.org/obo/NCIT_C94732> <http://purl.obolibrary.org/obo/NCIT_C94733> <http://purl.obolibrary.org/obo/NCIT_C94730> <https://w3id.org/ecoweaver/warp/SeasonEnum#growing_season> <https://w3id.org/ecoweaver/warp/SeasonEnum#dormant_season> ) ] ;
    skos:definition "A season during which an effect was observed or measured. The four cardinal seasons map to NCIT, which defines them astronomically (equinox to solstice); the sub-seasons take their cardinal season as a broad mapping, because no ontology checked carries them as terms. Growing and dormant season are included because sources in strongly seasonal systems report by those rather than by calendar season. A window spanning seasons or years is not a season: record it in time_since_intervention_text or duration_text instead." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <http://purl.obolibrary.org/obo/NCIT_C94730>,
        <http://purl.obolibrary.org/obo/NCIT_C94731>,
        <http://purl.obolibrary.org/obo/NCIT_C94732>,
        <http://purl.obolibrary.org/obo/NCIT_C94733>,
        <https://w3id.org/ecoweaver/warp/SeasonEnum#dormant_season>,
        <https://w3id.org/ecoweaver/warp/SeasonEnum#early_spring>,
        <https://w3id.org/ecoweaver/warp/SeasonEnum#early_summer>,
        <https://w3id.org/ecoweaver/warp/SeasonEnum#growing_season>,
        <https://w3id.org/ecoweaver/warp/SeasonEnum#late_spring>,
        <https://w3id.org/ecoweaver/warp/SeasonEnum#mid_spring> .

<https://example.org/sepio-model/InformationEntity> a owl:Class ;
    rdfs:label "InformationEntity" ;
    dcterms:title "Information Entity" ;
    ns1:status "Draft" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/isAbout> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/reportedIn> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/recordMetadata> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Contribution> ;
            owl:onProperty <https://example.org/sepio-model/contributions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/dateAuthored> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/supportingMethods> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/derivedFrom> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/RecordMetadata> ;
            owl:onProperty <https://example.org/sepio-model/recordMetadata> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/informationQuality> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/recordMetadata> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/informationQuality> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/supportingMethods> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/specifiedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/InformationEntity> ;
            owl:onProperty <https://example.org/sepio-model/derivedFrom> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/sources> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/supportingMethodTypes> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/specifiedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/supportingMethodTypes> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/sources> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/dateAuthored> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/dateAuthored> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/informationQuality> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/reportedIn> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/contributions> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/isAbout> ],
        <https://example.org/sepio-model/Entity> ;
    skos:definition "An abstract (non-physical) entity that is about something - representing the underlying 'information content' conveyed by physical or digital information artifacts like books, web pages, data tables, or photographs." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "As abstract, non-physical entities, Information Entities represent information independent of any specific language, format, or physical/digital medium. They can be simultaneously concretized in many distinct physical artifacts (e.g. all physical copies of the first edition of \"War and Peace\" carry the same information content, and thus concretize the same Information Entity)." .

<https://example.org/sepio-model/name> a owl:DatatypeProperty .

<https://example.org/sepio-model/value> a owl:DatatypeProperty .

causal_mosaic:id a owl:DatatypeProperty .

warp:AcquisitionMethodEnum a owl:Class ;
    rdfs:label "AcquisitionMethodEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#in_situ_sensor> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#remote_sensing> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#field_survey> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#camera_trap> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#acoustic_monitoring> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#environmental_dna> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#laboratory_assay> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#citizen_science> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#management_record> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#model_output> <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#expert_elicitation> ) ] ;
    skos:definition "Broad kind of data collection that a parameter option uses. When more than one value fits, choose the most specific (camera_trap rather than in_situ_sensor; environmental_dna rather than laboratory_assay)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#acoustic_monitoring>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#camera_trap>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#citizen_science>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#environmental_dna>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#expert_elicitation>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#field_survey>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#in_situ_sensor>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#laboratory_assay>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#management_record>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#model_output>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#remote_sensing> .

warp:EcoAgent a owl:Class ;
