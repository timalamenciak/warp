        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#supportive> .

warp:SemanticUnitScopeEnum a owl:Class ;
    rdfs:label "SemanticUnitScopeEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#assertional> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#contingent> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#prototypical> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#universal> <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#unclear> ) ;
    skos:definition "The scope of what a statement asserts, following Vogt's semantic unit types for statement units. Scope is part of a proposition's identity: \"X reduced Y on this plot\" and \"X typically reduces Y\" are different propositions. Definitions below are working glosses and must be checked against Vogt's own definitions before release." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    skos:note "Replaces CAMO's token_or_type. Migration default: token -> assertional; type -> prototypical (most ecological generalizations hold typically, with exceptions, rather than universally); ambiguous/not_addressed -> unclear." ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#assertional>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#contingent>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#prototypical>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#unclear>,
        <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#universal> .

warp:AssessmentStatusEnum a owl:Class ;
    rdfs:label "AssessmentStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#satisfied> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#partially_satisfied> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_satisfied> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#mixed> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#insufficient_evidence> <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_assessed> ) ;
    skos:definition "Aggregate assessment status for evidence-base-level criteria." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#insufficient_evidence>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#mixed>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_satisfied>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#partially_satisfied>,
        <https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#satisfied> .

warp:ComparatorTypeEnum a owl:Class ;
    rdfs:label "ComparatorTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#untreated_control> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#reference_undisturbed> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#pre_treatment_baseline> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_treatment> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#passive_management_arm> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#spatial_or_temporal_control> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_reported> <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_applicable> ) ;
    skos:definition "The basis against which the effect described by an edge was assessed — what the claim is relative to. Experimental controls are recorded here rather than as nodes. A control is not a state or change in state, so it fails the CausalNode test, but it is not neutral either: the same reported effect means different things measured against untreated plots, against undisturbed remnant, or against the same plots before treatment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_treatment>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_applicable>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_reported>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#passive_management_arm>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#pre_treatment_baseline>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#reference_undisturbed>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#spatial_or_temporal_control>,
        <https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#untreated_control> .

warp:DocumentSectionEnum a owl:Class ;
    rdfs:label "DocumentSectionEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#title> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#abstract> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#introduction> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#methods> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#results> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#discussion> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#conclusion> <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#supplementary> ) ;
    skos:definition "Sections of a source document where a causal claim may appear." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#abstract>,
        <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#conclusion>,
        <https://w3id.org/ecoweaver/warp/DocumentSectionEnum#discussion>,
