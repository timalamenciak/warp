<https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#unimodal> a owl:NamedIndividual,
        warp:DoseResponseShapeEnum ;
    rdfs:label "unimodal" ;
    skos:definition "The effect peaks at an intermediate dose and weakens at higher doses." .

