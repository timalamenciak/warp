<https://w3id.org/ecoweaver/warp/DoseLevelEnum#lower_than_comparator> a owl:NamedIndividual,
        warp:DoseLevelEnum ;
    rdfs:label "lower_than_comparator" ;
    skos:definition "Lower than the arm it is compared with, where that arm is unstated." .

