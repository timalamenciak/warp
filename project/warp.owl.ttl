@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix ECO: <http://purl.obolibrary.org/obo/ECO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix camo: <https://w3id.org/camo/> .
@prefix causal_mosaic: <https://w3id.org/causal-mosaic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ns1: <http://purl.org/ontology/bibo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix warp: <https://w3id.org/ecoweaver/warp/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/sepio-model/Expression> a owl:Class ;
    rdfs:label "Expression" ;
    dcterms:title "Expression" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/systemURL> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/systemURL> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://example.org/sepio-model/systemURL> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "A structure for labels representing systematic expressions that describe an entity, as generated by formal nomenclatures (e.g. HGVS for genetic variants, ISCN for karyotypes, HLA nomenclature for HLA genes/alleles)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Similar to the 'Coding' data type, which provides the same fields but for coded values, as opposed to human-readable names." .

causal_mosaic:CausalGraph a owl:Class ;
    rdfs:label "CausalGraph" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty causal_mosaic:nodes ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:GraphProvenance ;
            owl:onProperty causal_mosaic:provenance ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:EvidenceBaseAssessmentEdge ;
            owl:onProperty causal_mosaic:evidence_base_assessments ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:schema_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:graph_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:graph_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:provenance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:nodes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:graph_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_base_assessments ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalEdge ;
            owl:onProperty causal_mosaic:edges ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:SourceDocument ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:schema_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:source_documents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:provenance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:edges ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:SourceDocument ;
            owl:onProperty causal_mosaic:source_documents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:schema_version ] ;
    skos:definition "A labeled property graph of causal claims extracted from scientific literature. The top-level container for nodes and edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ParameterOptionCatalog a owl:Class ;
    rdfs:label "ParameterOptionCatalog" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty causal_mosaic:catalog_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ParameterOption ;
            owl:onProperty causal_mosaic:options ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:catalog_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:catalog_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:options ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:catalog_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:catalog_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:catalog_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:title ] ;
    skos:definition "A versioned registry of parameter options: the sensor, survey, assay, record and model types that can measure or supply CAMO nodes. Kept in its own file and shared by all graphs; nodes refer to its entries by id through CausalNode.parameter_options." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

<https://w3id.org/ecoweaver/warp.owl.ttl> a owl:Ontology ;
    rdfs:label "warp" ;
    dcterms:license "CC0" ;
    dcterms:title "WARP: Weaving Assertions, Reasons and Provenance" ;
    ns1:status <Draft> ;
    pav:version "0.5.0" ;
    skos:definition "WARP (Weaving Assertions, Reasons and Provenance) is EcoWeaver's profile of the SEPIO Core Information Model for recording sourced, scoped statements about ecological relationships, their evidence, and syntheses across statements. Causal statements reuse the Causal Mosaic (CAMO) node shapes, predicates and causal features." .

warp:StatementSet a owl:Class ;
    rdfs:label "StatementSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:agents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:assessments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoDocument ;
            owl:onProperty warp:documents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:study_results ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:agents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:interaction_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:documents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:profile_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:causal_propositions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:node_definitions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:interaction_propositions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoStudyResult ;
            owl:onProperty warp:study_results ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:profile_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalProposition ;
            owl:onProperty warp:causal_propositions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionStatement ;
            owl:onProperty warp:interaction_statements ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionProposition ;
            owl:onProperty warp:interaction_propositions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:NodeDefinition ;
            owl:onProperty warp:node_definitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalStatement ;
            owl:onProperty warp:causal_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:profile_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SynthesisAssessment ;
            owl:onProperty warp:assessments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:causal_statements ] ;
    skos:definition "A set of statements with the nodes, propositions, evidence and sources they refer to. The unit of exchange (one file, one export)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://example.org/sepio-model/Activity> a owl:Class ;
    rdfs:label "Activity" ;
    dcterms:title "Activity" ;
    ns1:status <Informative> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/input> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Method> ;
            owl:onProperty <https://example.org/sepio-model/specifiedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Entity> ;
            owl:onProperty <https://example.org/sepio-model/input> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Agent> ;
            owl:onProperty <https://example.org/sepio-model/performedBy> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/output> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/date> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://example.org/sepio-model/date> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/specifiedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Entity> ;
            owl:onProperty <https://example.org/sepio-model/output> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/performedBy> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/date> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        <https://example.org/sepio-model/Entity> ;
    skos:definition "An action or set of actions performed by an agent, that occurs over a period of time. Activities may use, generate, modify, move, or destroy one or more entities." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Activities relevant to scientific knowledge generation, and include things like observations of the natural world, designing and performing experiments, data analysis and transformation, publishing research results, data curation and interpretation, and assessment and care of patients in clinical settings.  These activities may produce information that gets encoded in sharable artifacts which are used to generate scientific knowledge. Agents can play different types of roles in the generation and use of such artifacts." .

<https://example.org/sepio-model/Characteristic> a owl:Class ;
    rdfs:label "Characteristic" ;
    dcterms:title "Characteristic" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/valueOperator> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/valueOperator> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/values> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/values> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/valueOperator> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "An object holding a name-value pair used to describe a trait or role of an individual member of a StudyGroup." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This flexible key-value like object is where specific inclusion or exclusion criteria for membership in a StudyGroup are formally defined.  It should be used to capture characteristics that inhere in individual members of the StudyGroup (e.g. inherent traits like their sex, race, or age, or roles assigned to them in a particular context such as being a control in a study)." .

<https://example.org/sepio-model/DataSet> a owl:Class ;
    rdfs:label "DataSet" ;
    dcterms:title "Data Set" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/license> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/releaseDate> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/license> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/license> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/releaseDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/releaseDate> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "A collection of related data items or records that are organized together in a common format or structure, to enable their computational manipulation as a unit." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Instances of this class represent a *specific version* of a given dataset. Examples include the  gnomAD version 3.1.2 dataset carrying allele population frequencies, or a specific version of a VCF file that describes variations observed in a particular patient and various annotations made on them, or a SIFT dataset of computational predictions functional impact for a set of variants." .

<https://example.org/sepio-model/Document> a owl:Class ;
    rdfs:label "Document" ;
    dcterms:title "Document" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/pmid> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/pmid> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/doi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/license> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/license> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/license> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/pmid> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/urls> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/urls> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/doi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/doi> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "A collection of information, usually in a text-based or graphic human-readable form, intended to be read and understood together as a whole." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "As an abstract InformationEntity, a Document instance is defined by the informational content it conveys, not a particular physical concretization of this information. A single Document instance can simultaneously be concretized in different languages, formats, and physical mediums." .

<https://example.org/sepio-model/Extension> a owl:Class ;
    rdfs:label "Extension" ;
    dcterms:title "Extension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/extensionDescription> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/extensionDescription> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/extensionDescription> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "A data structure that allows custom attributes to be defined for an Entity, to capture information unique to a given content provider, or not currently supported by the core specification." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Extension objects allow for  descriptions of an class with additional attributes unique to a content provider",
        "The modeling pattern and use of Extensions is based on that defined by the FHIR Speciufication - see https://build.fhir.org/extensibility.html" .

<https://example.org/sepio-model/Method> a owl:Class ;
    rdfs:label "Method" ;
    dcterms:title "Method" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/urls> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/urls> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "A set of instructions that specify how to achieve some objective." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "In scientific research, these include things like experimental protocols, study designs, data analysis parameters,  curation guidelines, cohort selection criteria, and rule sets." .

<https://example.org/sepio-model/Statement> a owl:Class ;
    rdfs:label "Statement" ;
    dcterms:title "Statement" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
