    skos:definition "The text explicitly states this feature." .

<https://w3id.org/ecoweaver/warp/FeatureAssertionEnum#explicitly_denied> a owl:Class ;
    rdfs:label "explicitly_denied" ;
    rdfs:subClassOf warp:FeatureAssertionEnum ;
    skos:definition "The text explicitly states this feature does NOT hold." .

<https://w3id.org/ecoweaver/warp/FeatureAssertionEnum#implicitly_assumed> a owl:Class ;
    rdfs:label "implicitly_assumed" ;
    rdfs:subClassOf warp:FeatureAssertionEnum ;
    skos:definition "The feature is strongly implied but not directly stated." .

<https://w3id.org/ecoweaver/warp/FeatureAssertionEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:FeatureAssertionEnum ;
    skos:definition "The text does not address this feature." .

<https://w3id.org/ecoweaver/warp/InteractionEffectEnum#negative> a owl:Class ;
    rdfs:label "negative" ;
    rdfs:subClassOf warp:InteractionEffectEnum .

<https://w3id.org/ecoweaver/warp/InteractionEffectEnum#neutral> a owl:Class ;
    rdfs:label "neutral" ;
    rdfs:subClassOf warp:InteractionEffectEnum .

<https://w3id.org/ecoweaver/warp/InteractionEffectEnum#not_reported> a owl:Class ;
    rdfs:label "not_reported" ;
    rdfs:subClassOf warp:InteractionEffectEnum .

<https://w3id.org/ecoweaver/warp/InteractionEffectEnum#positive> a owl:Class ;
    rdfs:label "positive" ;
    rdfs:subClassOf warp:InteractionEffectEnum .

<https://w3id.org/ecoweaver/warp/InteractionTypeEnum#antagonistic> a owl:Class ;
    rdfs:label "antagonistic" ;
    rdfs:subClassOf warp:InteractionTypeEnum ;
    skos:definition "Combined effect less than sum of individual effects." .

<https://w3id.org/ecoweaver/warp/InteractionTypeEnum#not_specified> a owl:Class ;
    rdfs:label "not_specified" ;
    rdfs:subClassOf warp:InteractionTypeEnum ;
    skos:definition "Interaction noted but type not characterized." .

<https://w3id.org/ecoweaver/warp/InteractionTypeEnum#qualitative> a owl:Class ;
    rdfs:label "qualitative" ;
    rdfs:subClassOf warp:InteractionTypeEnum ;
    skos:definition "Direction of effect changes across levels of moderator." .

<https://w3id.org/ecoweaver/warp/InteractionTypeEnum#quantitative> a owl:Class ;
    rdfs:label "quantitative" ;
    rdfs:subClassOf warp:InteractionTypeEnum ;
    skos:definition "Magnitude but not direction changes across levels." .

<https://w3id.org/ecoweaver/warp/InteractionTypeEnum#synergistic> a owl:Class ;
    rdfs:label "synergistic" ;
    rdfs:subClassOf warp:InteractionTypeEnum ;
    skos:definition "Combined effect greater than sum of individual effects." .

<https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#derived> a owl:Class ;
    rdfs:label "derived" ;
    rdfs:subClassOf warp:MeasurementRelationEnum ;
    skos:definition "Computed from one or more other measured quantities (e.g. species richness computed from survey records, evapotranspiration from flux measurements)." .

<https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#direct> a owl:Class ;
    rdfs:label "direct" ;
    rdfs:subClassOf warp:MeasurementRelationEnum ;
    skos:definition "Measures the node's measured_attribute of its entity_term itself." .

<https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#proxy> a owl:Class ;
    rdfs:label "proxy" ;
    rdfs:subClassOf warp:MeasurementRelationEnum ;
    skos:definition "Measures a different quantity that correlates with the node's attribute (e.g. NDVI as a proxy for vegetation biomass)." .

<https://w3id.org/ecoweaver/warp/PropositionStatusEnum#asserted> a owl:Class ;
    rdfs:label "asserted" ;
    rdfs:subClassOf warp:PropositionStatusEnum ;
    skos:definition "At least one statement puts this proposition forward." .

<https://w3id.org/ecoweaver/warp/PropositionStatusEnum#open_question> a owl:Class ;
    rdfs:label "open_question" ;
    rdfs:subClassOf warp:PropositionStatusEnum ;
    skos:definition "Created directly, with no statements yet: an empty evidence gap map cell, or a practitioner's question." .

<https://w3id.org/ecoweaver/warp/ProximateDistalEnum#both_specified> a owl:Class ;
    rdfs:label "both_specified" ;
    rdfs:subClassOf warp:ProximateDistalEnum ;
    skos:definition "Both proximate and distal positions are identified." .

<https://w3id.org/ecoweaver/warp/ProximateDistalEnum#distal> a owl:Class ;
    rdfs:label "distal" ;
    rdfs:subClassOf warp:ProximateDistalEnum ;
    skos:definition "Upstream or root cause." .

<https://w3id.org/ecoweaver/warp/ProximateDistalEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:ProximateDistalEnum ;
    skos:definition "Not discussed." .

<https://w3id.org/ecoweaver/warp/ProximateDistalEnum#proximate> a owl:Class ;
    rdfs:label "proximate" ;
    rdfs:subClassOf warp:ProximateDistalEnum ;
    skos:definition "Immediate or direct trigger." .

<https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#directional_change> a owl:Class ;
    rdfs:label "directional_change" ;
    rdfs:subClassOf warp:QualifierFamilyEnum ;
    skos:definition "Change in a continuous attribute. Yields a delta variable, not a level. Values: increased, decreased, unchanged." .

<https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#membership_change> a owl:Class ;
    rdfs:label "membership_change" ;
    rdfs:subClassOf warp:QualifierFamilyEnum ;
    skos:definition "Transition in binary presence. Values: introduced, removed." .

<https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#presence> a owl:Class ;
    rdfs:label "presence" ;
    rdfs:subClassOf warp:QualifierFamilyEnum ;
    skos:definition "Binary state of an entity or attribute. Values: present, absent." .

<https://w3id.org/ecoweaver/warp/QualifierFamilyEnum#process_phase> a owl:Class ;
    rdfs:label "process_phase" ;
    rdfs:subClassOf warp:QualifierFamilyEnum ;
    skos:definition "Stage of a process or event. Values: occurred, initiated, terminated, ongoing, interrupted, aborted." .

<https://w3id.org/ecoweaver/warp/ReversibilityEnum#hysteresis> a owl:Class ;
    rdfs:label "hysteresis" ;
    rdfs:subClassOf warp:ReversibilityEnum ;
    skos:definition "Recovery follows a different trajectory than degradation." .

<https://w3id.org/ecoweaver/warp/ReversibilityEnum#irreversible> a owl:Class ;
    rdfs:label "irreversible" ;
    rdfs:subClassOf warp:ReversibilityEnum ;
    skos:definition "E persists even after C is removed." .

<https://w3id.org/ecoweaver/warp/ReversibilityEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:ReversibilityEnum ;
    skos:definition "Not discussed." .

<https://w3id.org/ecoweaver/warp/ReversibilityEnum#partially_reversible> a owl:Class ;
    rdfs:label "partially_reversible" ;
    rdfs:subClassOf warp:ReversibilityEnum ;
    skos:definition "Partial recovery upon removal of C." .

<https://w3id.org/ecoweaver/warp/ReversibilityEnum#reversible> a owl:Class ;
    rdfs:label "reversible" ;
    rdfs:subClassOf warp:ReversibilityEnum ;
    skos:definition "Removing C reverses E." .

<https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#assertional> a owl:Class ;
    rdfs:label "assertional" ;
    rdfs:subClassOf warp:SemanticUnitScopeEnum ;
    skos:definition "About particular things: this plot, this population, this burn. Field observations and case reports are usually assertional." .

<https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#contingent> a owl:Class ;
    rdfs:label "contingent" ;
    rdfs:subClassOf warp:SemanticUnitScopeEnum ;
    skos:definition "About some, but not necessarily all, instances of a type: something that can or does sometimes happen." .

<https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#prototypical> a owl:Class ;
    rdfs:label "prototypical" ;
    rdfs:subClassOf warp:SemanticUnitScopeEnum ;
    skos:definition "About what typically holds for instances of a type, allowing exceptions. The usual scope of an ecological generalization." .

<https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#unclear> a owl:Class ;
    rdfs:label "unclear" ;
    rdfs:subClassOf warp:SemanticUnitScopeEnum ;
    skos:definition "The scope cannot be determined from the source. Informative: it blocks aggregation into scoped propositions until resolved." .

<https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#universal> a owl:Class ;
    rdfs:label "universal" ;
    rdfs:subClassOf warp:SemanticUnitScopeEnum ;
    skos:definition "About all instances of a type, without exception." .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#aborted> a owl:Class ;
    rdfs:label "aborted" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The process/event was stopped before completion (e.g., management intervention)." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "aborted" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#absent> a owl:Class ;
    rdfs:label "absent" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The entity or attribute is absent (binary state)." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "presence" ;
    warp:rosetta_prefix "absence of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#decreased> a owl:Class ;
    rdfs:label "decreased" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The attribute value decreases." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "directional_change" ;
    warp:rosetta_prefix "decreased" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#increased> a owl:Class ;
    rdfs:label "increased" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The attribute value increases." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "directional_change" ;
    warp:rosetta_prefix "increased" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#initiated> a owl:Class ;
    rdfs:label "initiated" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The process/event was started." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "initiation of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#interrupted> a owl:Class ;
    rdfs:label "interrupted" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The process/event began but was halted prematurely." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "interrupted" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#introduced> a owl:Class ;
    rdfs:label "introduced" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The entity has been introduced to the system (invasion, reintroduction)." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "membership_change" ;
    warp:rosetta_prefix "introduction of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#occurred> a owl:Class ;
    rdfs:label "occurred" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The process/event took place." ;
    warp:fcm_sign "neutral" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#ongoing> a owl:Class ;
    rdfs:label "ongoing" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The process/event is ongoing." ;
    warp:fcm_sign "neutral" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "continuation of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#present> a owl:Class ;
    rdfs:label "present" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The entity or attribute is present (binary state)." ;
    warp:fcm_sign "positive" ;
    warp:qualifier_family "presence" ;
    warp:rosetta_prefix "presence of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#removed> a owl:Class ;
    rdfs:label "removed" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The entity has been removed from the system (extirpation, management removal)." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "membership_change" ;
    warp:rosetta_prefix "removal of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#terminated> a owl:Class ;
    rdfs:label "terminated" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The process/event ended." ;
    warp:fcm_sign "negative" ;
    warp:qualifier_family "process_phase" ;
    warp:rosetta_prefix "cessation of" .

<https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#unchanged> a owl:Class ;
    rdfs:label "unchanged" ;
    rdfs:subClassOf warp:StateOrChangeQualifierEnum ;
    skos:definition "The attribute stayed the same, reported as a measured state of the outcome variable itself (e.g. \"water table depth remained stable at 30 cm\"). Use it on a positive, non-negated claim — for example that a cause maintained or buffered a variable, or that a stable variable caused something else. Do not use it to encode a null result (\"X had no effect on Y\"): record that as negated: true with causal_language: no_relationship, leaving the object node's qualifier as it would be for a positive finding. The comparison the stability was assessed against belongs in CausalEdge.comparator, not here — controls and baselines are ComparatorTypeEnum values." ;
    warp:fcm_sign "neutral" ;
    warp:qualifier_family "directional_change" ;
    warp:rosetta_prefix "no change in" .

<https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#moderate> a owl:Class ;
    rdfs:label "moderate" ;
    rdfs:subClassOf warp:StrengthQualitativeEnum ;
    skos:definition "Medium effect size." .

<https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#negligible> a owl:Class ;
    rdfs:label "negligible" ;
    rdfs:subClassOf warp:StrengthQualitativeEnum ;
    skos:definition "Trivially small effect." .

<https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#not_specified> a owl:Class ;
    rdfs:label "not_specified" ;
    rdfs:subClassOf warp:StrengthQualitativeEnum ;
    skos:definition "Strength not characterized." .

<https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#strong> a owl:Class ;
    rdfs:label "strong" ;
    rdfs:subClassOf warp:StrengthQualitativeEnum ;
    skos:definition "Large effect size or strong association." .

<https://w3id.org/ecoweaver/warp/StrengthQualitativeEnum#weak> a owl:Class ;
    rdfs:label "weak" ;
    rdfs:subClassOf warp:StrengthQualitativeEnum ;
    skos:definition "Small effect size or weak association." .

<https://w3id.org/ecoweaver/warp/TokenTypeEnum#ambiguous> a owl:Class ;
    rdfs:label "ambiguous" ;
    rdfs:subClassOf warp:TokenTypeEnum ;
    skos:definition "Cannot determine if token or type." .

<https://w3id.org/ecoweaver/warp/TokenTypeEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:TokenTypeEnum ;
    skos:definition "Not relevant or not discussed." .

<https://w3id.org/ecoweaver/warp/TokenTypeEnum#token> a owl:Class ;
    rdfs:label "token" ;
    rdfs:subClassOf warp:TokenTypeEnum ;
    skos:definition "Singular claim: this specific C caused this specific E." .

<https://w3id.org/ecoweaver/warp/TokenTypeEnum#type> a owl:Class ;
    rdfs:label "type" ;
    rdfs:subClassOf warp:TokenTypeEnum ;
    skos:definition "General claim: C-type causes E-type." .

<https://w3id.org/ecoweaver/warp/ValueTypeEnum#binary> a owl:Class ;
    rdfs:label "binary" ;
    rdfs:subClassOf warp:ValueTypeEnum ;
    skos:definition "Two states (e.g. detected / not detected, occurred / did not occur)." ;
    warp:compatible_qualifier_families "presence|membership_change|process_phase" .

<https://w3id.org/ecoweaver/warp/ValueTypeEnum#categorical> a owl:Class ;
    rdfs:label "categorical" ;
    rdfs:subClassOf warp:ValueTypeEnum ;
    skos:definition "Unordered classes (e.g. land cover type, process stage)." ;
    warp:compatible_qualifier_families "presence|membership_change|process_phase" .

<https://w3id.org/ecoweaver/warp/ValueTypeEnum#continuous> a owl:Class ;
    rdfs:label "continuous" ;
    rdfs:subClassOf warp:ValueTypeEnum ;
    skos:definition "A real-valued measurement (e.g. concentration, height, depth)." ;
    warp:compatible_qualifier_families "directional_change" .

<https://w3id.org/ecoweaver/warp/ValueTypeEnum#count> a owl:Class ;
    rdfs:label "count" ;
    rdfs:subClassOf warp:ValueTypeEnum ;
    skos:definition "A non-negative integer count (e.g. number of individuals or stems)." ;
    warp:compatible_qualifier_families "directional_change|presence" .

<https://w3id.org/ecoweaver/warp/ValueTypeEnum#ordinal> a owl:Class ;
    rdfs:label "ordinal" ;
    rdfs:subClassOf warp:ValueTypeEnum ;
    skos:definition "Ordered classes (e.g. cover classes, abundance ranks, condition scores)." ;
    warp:compatible_qualifier_families "directional_change" .

<https://w3id.org/ecoweaver/warp/ValueTypeEnum#proportion> a owl:Class ;
    rdfs:label "proportion" ;
    rdfs:subClassOf warp:ValueTypeEnum ;
    skos:definition "A fraction or percentage (e.g. percent cover, survival rate)." ;
    warp:compatible_qualifier_families "directional_change" .

warp:agents a owl:ObjectProperty ;
    rdfs:label "agents" ;
    skos:definition "People, organizations, communities and software that make, record or assess statements. Referred to by id from contributions and CARE metadata." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:assessments a owl:ObjectProperty ;
    rdfs:label "assessments" ;
    skos:definition "Synthesis assessments over propositions." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:causal_propositions a owl:ObjectProperty ;
    rdfs:label "causal_propositions" ;
    skos:definition "Causal propositions: derived by scripts/derive_propositions.py, or written by people as open questions." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:causal_statements a owl:ObjectProperty ;
    rdfs:label "causal_statements" ;
    skos:definition "Causal statements as annotated (one per source assertion)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:comparator a owl:ObjectProperty ;
    rdfs:label "comparator" ;
    skos:definition "What the effect was assessed relative to." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:derived_from_statements a owl:ObjectProperty ;
    rdfs:label "derived_from_statements" ;
    skos:definition "Statements grouped under this proposition." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:documents a owl:ObjectProperty ;
    rdfs:label "documents" ;
    skos:definition "Sources referenced by statements and evidence lines." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_item_refs a owl:DatatypeProperty ;
    rdfs:label "evidence_item_refs" ;
    skos:definition "Evidence items referenced by identifier: other statements, study results, documents, dataset records. Use instead of SEPIO's hasEvidenceItems, which inlines whole objects. Each must resolve to an id in the files checked together (scripts/check_statements.py)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:fillers a owl:ObjectProperty ;
    rdfs:label "fillers" ;
    skos:definition "One filler per template variable." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:interaction_propositions a owl:ObjectProperty ;
    rdfs:label "interaction_propositions" ;
    skos:definition "Biotic interaction propositions (derived or open questions)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:interaction_statements a owl:ObjectProperty ;
    rdfs:label "interaction_statements" ;
    skos:definition "Biotic interaction statements as annotated." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:knowledge_holders a owl:ObjectProperty ;
    rdfs:label "knowledge_holders" ;
    skos:definition "People or groups recognised as holding this knowledge, by agent id. Often the statement's author, but not always: knowledge relayed by a community member may be held by an elder or by the community." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:local_contexts_labels a owl:DatatypeProperty ;
    rdfs:label "local_contexts_labels" ;
    skos:definition "Local Contexts TK/BC label or notice URIs, where applied." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:node_definitions a owl:ObjectProperty ;
    rdfs:label "node_definitions" ;
    skos:definition "Logical definitions of nodes: which node template each node fills, and with what. Expanded to OWL and DOSDP fill tables by scripts/expand_nodes.py. See docs/node-templates.md." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:nodes a owl:ObjectProperty ;
    rdfs:label "nodes" ;
    skos:definition "CAMO node shapes referred to by statements and propositions." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:philosophical_accounts a owl:ObjectProperty ;
    rdfs:label "philosophical_accounts" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:source_spans a owl:ObjectProperty ;
    rdfs:label "source_spans" ;
    skos:definition "Text spans grounding the statement in its source document." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:study_results a owl:ObjectProperty ;
    rdfs:label "study_results" ;
    skos:definition "Summarized study arms or plot groups used as evidence items." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/elmo/cas/ConservationAction> a owl:Class ;
    rdfs:label "management_intervention" ;
    rdfs:subClassOf warp:EntityTypeEnum ;
    skos:definition "A deliberate human action intended to change an ecological outcome. A subtype of environmental_process with an implied human agent. Examples: invasive species removal, prescribed fire, seeding, hydrological restoration." .

