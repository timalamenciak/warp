<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#supplementary> a owl:Class ;
    rdfs:label "supplementary" ;
    rdfs:subClassOf warp:DocumentSectionEnum ;
    skos:definition "Supplementary materials." .

<https://w3id.org/ecoweaver/warp/DocumentSectionEnum#title> a owl:Class ;
    rdfs:label "title" ;
    rdfs:subClassOf warp:DocumentSectionEnum ;
    skos:definition "Paper title." .

warp:EcoDocument a owl:Class ;
    rdfs:label "EcoDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        <https://example.org/sepio-model/Document> ;
    skos:definition "A source: publication, report, field notebook, transcript, dataset landing page." ;
    skos:exactMatch warp:EcoDocument ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:EcoEvidenceLine a owl:Class ;
    rdfs:label "EcoEvidenceLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:targetProposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoContribution ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceDirectionEnum ;
            owl:onProperty warp:directionOfEvidenceProvided ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:evidence_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceTypeEnum ;
            owl:onProperty warp:evidence_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty warp:evidence_item_refs ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:directionOfEvidenceProvided ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:evidence_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceStrengthEnum ;
            owl:onProperty warp:strengthOfEvidenceProvided ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoProposition ;
            owl:onProperty warp:targetProposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:strengthOfEvidenceProvided ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:evidence_item_refs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:evidence_object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:directionOfEvidenceProvided ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:strengthOfEvidenceProvided ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:evidence_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:targetProposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceObjectEnum ;
            owl:onProperty warp:evidence_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        <https://example.org/sepio-model/EvidenceLine> ;
    skos:definition "One argument for or against a proposition, built from evidence items. The evidential basis lives here: study design, evidence object, and non-academic evidence such as practitioner experience and Indigenous knowledge. Direction and strength are a judgement: record who made it as a contribution with role evidence_assessor. Without one, the judgement is attributed to the annotator of the statement that holds the line (or, for a SynthesisAssessment, to its author)." ;
    skos:exactMatch warp:EcoEvidenceLine ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:EcoRecordMetadata a owl:Class ;
    rdfs:label "EcoRecordMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoContribution ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:contributions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contributions ],
        <https://example.org/sepio-model/RecordMetadata> ;
    skos:definition "Provenance of a WARP record (not of the knowledge it holds): who annotated it and when." ;
    skos:exactMatch warp:EcoRecordMetadata ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:EcoStudyResult a owl:Class ;
    rdfs:label "EcoStudyResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:focus ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:focus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:dataItems ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:sourceDataSet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:focus ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty warp:dataItems ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty warp:sourceDataSet ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:id ],
        <https://example.org/sepio-model/StudyResult> ;
    skos:definition "A summary of data from one study arm or plot group about one focus variable (mean, variability, n), traceable to source records. The recommended level of detail for evidence from datasets." ;
    skos:exactMatch warp:EcoStudyResult ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/ecoweaver/warp/EntityTypeEnum#taxon> a owl:Class ;
    rdfs:label "taxon" ;
    rdfs:subClassOf warp:EntityTypeEnum ;
    skos:definition """A taxon that is the subject of a causal claim. Refers to all members of that taxon, with the caveats specified in causal annotation layers.
Two-path model for taxon-specific measurements:
(1) Single-taxon measurement — use entity_type: taxon with the Wikidata QID in entity_term and the measured property in measured_attribute. The node is both the organism and the measurement (e.g., entity_term=Q30019, measured_attribute=cover, qualifier=increased gives "increased Sphagnum cover"). The taxon node participates directly in causal edges.
(2) Multi-taxon aggregate or ecological guild — use entity_type: environmental_variable with applied_to listing the relevant Wikidata QIDs or free-text guild names. Reserve this for cases where the measurement spans multiple taxa ("richness of liverworts, Sphagnum, and true mosses") or refers to an ecologically defined group with no single Wikidata resolution ("native species", "shade-tolerant species"). Edges remain purely causal; applied_to is a queryable annotation field, not a structural link.""" .

<https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#conflicting> a owl:Class ;
    rdfs:label "conflicting" ;
    rdfs:subClassOf warp:EvidenceBalanceEnum ;
    skos:definition "The included evidence contains direct conflict about the relationship." .

