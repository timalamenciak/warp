    warp:display_label "MFT1.2 Intertidal forests and shrublands" ;
    warp:iucn_get_code "MFT1.2" ;
    warp:ontology_curie "ELMO:3620205" ;
    warp:preferred_label "Intertidal forests and shrublands" .

ELMO:3620206 a owl:NamedIndividual,
        warp:EcosystemFunctionalGroupEnum ;
    rdfs:label "coastal_saltmarshes_and_reedbeds" ;
    skos:definition "Coastal saltmarshes and reedbeds." ;
    warp:display_label "MFT1.3 Coastal saltmarshes and reedbeds" ;
    warp:iucn_get_code "MFT1.3" ;
    warp:ontology_curie "ELMO:3620206" ;
    warp:preferred_label "Coastal saltmarshes and reedbeds" .

ELMO:3620230 a owl:NamedIndividual,
        warp:EcosystemFunctionalGroupEnum ;
    rdfs:label "tropical_alpine_grasslands_and_herbfields" ;
    skos:definition "Tropical alpine grasslands and herbfields." ;
    warp:display_label "T6.5 Tropical alpine grasslands and herbfields" ;
    warp:iucn_get_code "T6.5" ;
    warp:ontology_curie "ELMO:3620230" ;
    warp:preferred_label "Tropical alpine grasslands and herbfields" .

ELMO:3620231 a owl:NamedIndividual,
        warp:EcosystemFunctionalGroupEnum ;
    rdfs:label "annual_croplands" ;
    skos:definition "Annual croplands." ;
    warp:display_label "T7.1 Annual croplands" ;
    warp:iucn_get_code "T7.1" ;
    warp:ontology_curie "ELMO:3620231" ;
    warp:preferred_label "Annual croplands" .

ELMO:3620232 a owl:NamedIndividual,
        warp:EcosystemFunctionalGroupEnum ;
    rdfs:label "constructed_lacustrine_wetlands" ;
    skos:definition "Constructed lacustrine wetlands." ;
    warp:display_label "F3.2 Constructed lacustrine wetlands" ;
    warp:iucn_get_code "F3.2" ;
    warp:ontology_curie "ELMO:3620232" ;
    warp:preferred_label "Constructed lacustrine wetlands" .

ELMO:3620233 a owl:NamedIndividual,
        warp:EcosystemFunctionalGroupEnum ;
    rdfs:label "marine_aquafarms" ;
    skos:definition "Marine aquafarms." ;
    warp:display_label "M4.2 Marine aquafarms" ;
    warp:iucn_get_code "M4.2" ;
    warp:ontology_curie "ELMO:3620233" ;
    warp:preferred_label "Marine aquafarms" .

BFO:0000019 a owl:NamedIndividual,
        warp:EntityTypeEnum ;
    rdfs:label "composite_variable",
        "environmental_variable" ;
    skos:definition "A measurable aspect of ecosystem state at a point in time. Examples: bare soil cover, species abundance, soil pH, canopy height, phylogenetic diversity. Corresponds to \"state variables\" in ecological modeling (Jørgensen and Fath 2011; Palmeri et al. 2013).",
        "A measurable aspect of ecosystem state whose entity is an aggregate of several members: an assemblage, a community or an ecological guild. Still a state variable, but an aggregated one, so it shares environmental_variable's BFO quality grounding. Use it where the measured thing is the group rather than one member or a scalar environmental property. Examples: the cladoceran assemblage, the boreal predator assemblage, native forbs, browse-tolerant field-layer plants. The members, where the source names them, go in applied_to; where it also reports how much each accounts for, in composition, which only this node type may carry." .

IAO:0000136 a owl:ObjectProperty ;
    rdfs:label "about_project" ;
    skos:definition "DERIVED: the project individual, proj:<id>, this record is about." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<http://purl.obolibrary.org/obo/NCIT_C94732> a owl:NamedIndividual,
        warp:SeasonEnum ;
    rdfs:label "summer" ;
    skos:definition "Summer, without further subdivision." ;
    warp:preferred_label "Summer" .

<https://example.org/sepio-model/Agent> a owl:Class ;
    rdfs:label "Agent" ;
    dcterms:title "Agent" ;
    ns1:status "Draft" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        <https://example.org/sepio-model/Entity> ;
    skos:definition "An autonomous actor (person, organization, or software agent) that bears some form of responsibility for an activity taking place,  for the existence of an entity, or for another agent's activity." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Agents can belong to organizations, and act on behalf or in the context of an organizational affiliation when contributing to an entity. For example, curators generating these variant pathogenicity interpretations may do so in the context of their work with the ClinGen organization, which provides administrative, technical, and funding support for their contributions.",
        "Agents perform activities and make contributions to entities. An agent can be an individual person, an organization of multiple individuals acting together, or a computational agent such as a software program or automated pipeline." .

<https://example.org/sepio-model/Contribution> a owl:Class ;
    rdfs:label "Contribution" ;
    dcterms:title "Contribution" ;
    ns1:status "Draft" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/activityType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Agent> ;
            owl:onProperty <https://example.org/sepio-model/contributor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/activityType> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/contributionMadeTo> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/contributor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/InformationEntity> ;
            owl:onProperty <https://example.org/sepio-model/contributionMadeTo> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/contributionMadeTo> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/contributor> ],
        <https://example.org/sepio-model/Activity> ;
    skos:definition "An action or actions taken by a particular agent in the creation, modification, assessment, or deprecation of some entity (e.g. a Statement, Evidence Line, DataSet, Publication, etc.)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Contributions are used to organize information about when, where, how (e.g. what roles were played), and on whose behalf these actions were performed.",
        "The scope of a Contribution instance includes only the actions of a single agent in contributing to a single artifact, which may be performed in one continuous effort, or several discontinuous sessions of work.  The agent can be an individual person, a software agent, or a group or organization of individuals acting together.'" .

<https://example.org/sepio-model/Proposition> a owl:Class ;
    rdfs:label "Proposition" ;
    dcterms:title "Proposition" ;
    ns1:status "Informative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/subject> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/object> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subject> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty <https://example.org/sepio-model/negated> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/propositionText> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Qualifier> ;
            owl:onProperty <https://example.org/sepio-model/qualifier> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/negated> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/object> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/object> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/predicate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/propositionText> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/qualifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subject> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/predicate> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/propositionText> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/negated> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/predicate> ],
        <https://example.org/sepio-model/Entity> ;
    skos:definition "An abstract entity representing a possible fact that is either true or false." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Propositions are taken to represent the semantic content of sentences or larger lexical entities formulated in some natural or artificial language.  As abstract entities, Propositions capture a 'sharable' piece of meaning that can be put forth as true or false in many different Statement instances made by different Agents on different occasions.  Their identity and existence are independent of space and time, and of whether they are ever asserted to be true by some agent.",
        "Propositions may be used in two contexts in this model: (1) in Statements to represent the possible fact that is put forth as true, or  that is subjected to an assessment of the level of evidence supporting it; (2) in Evidence Lines to represent the possible fact that an argument built from evidence items is evaluated against." .

<https://example.org/sepio-model/code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    skos:definition "A symbol uniquely identifying the concept, as in a syntax defined by the code system.  CURIE format is preferred where possible (e.g. ‘SO:0000704’ is the CURIE form of the Sequence Ontology code for 'gene')." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/confidenceInterval> a owl:ObjectProperty ;
    rdfs:label "confidenceInterval" ;
    ns1:status "Informative" ;
    skos:definition "A measure of the probability that a parameter of interest will fall within a defined range of values around a mean or other statistical calculation." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Confidence intervals reflect the degree of uncertainty in a sampling method. They may be bounded on one or both sides, and are  computed for a designated confidence level (most often 95% or 99%.. For example, a Hazard Ratio of 0.47 might have a 95% confidence interval between 0.42 and 0.55, with a p-value of = 0.001.",
        "The DataItem used to represent a confidence interval will indicate what type of interval is reported (e.g. ''95% CI''), and will contain separate componentDataItems representing the upper and lower bounds of the interval (e.g. ''0.42'' and ''0.55'').'" .

<https://example.org/sepio-model/contributionMadeTo> a owl:ObjectProperty ;
    rdfs:label "contributionMadeTo" ;
    ns1:status "Informative" ;
    skos:definition "The artifact toward which the contribution was made." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/contributor> a owl:ObjectProperty ;
    rdfs:label "contributor" ;
    ns1:status "Draft" ;
    skos:definition "The Agent that made the contribution." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Note that this must be a single agent (which can be a Person, or an Organization).  If multiple Agents contributed to an entity, a separate Contribution instances MUST be created for each." .

<https://example.org/sepio-model/date> a owl:DatatypeProperty ;
    rdfs:label "date" ;
    ns1:status "Draft" ;
    skos:definition "The date that the Activity was completed." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "By convention, populate this attribute with the date the activity was completed (e.g.  in cases where the activity spans multiple days). The date SHOULD be formatted as a date string in ISO format \"YYYY-MM-DD\"." .

<https://example.org/sepio-model/dateAuthored> a owl:DatatypeProperty ;
    rdfs:label "dateAuthored" ;
    ns1:status "Draft" ;
    skos:definition "Indicates when the information content expressed in the Information Entity was generated." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "The term 'authored' as used in the model refers to the generation of 'information content' in the abstract  sense, as opposed to a concrete encoding of this information in a specific language or format. e.g. for a Statement, this attribute captures when the information content expressed in the Statement was first generated by an agent.  Information about when a particular concrete encoding of this information was created (e.g. as row in a table, or object in a json document) would live in a RecordMetadata object attached to the Information Entity)." .

<https://example.org/sepio-model/dateRecordCreated> a owl:DatatypeProperty ;
    rdfs:label "dateRecordCreated" ;
    ns1:status "Draft" ;
    skos:definition "The date the record was initially created." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    ns1:status "Draft" ;
    skos:definition "A free text description of the Entity." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/direction> a owl:DatatypeProperty ;
    rdfs:label "direction" ;
    ns1:status "Draft" ;
    skos:definition "A term indicating whether the Statement supports, disputes, or remains neutral w.r.t. the validity of the Proposition it evaluates." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Statements put forth a Proposition that expresses some possible fact about the world, and may provide an assessment of this proposition's validity (i.e. how likely it is to be true or false based on evaluated evidence). The semantics of the Proposition are captured in the 'subject',  'predicate', 'object', and optional 'qualifier' attributes. An assessment of the Proposition's validity can be captured using 'direction', 'strength', and 'score' attributes. The 'direction'  attribute is used to indicate whether the Statement's Proposition is *supported* by the agent's assessment (when evidence favors its validity), is *disputed* by the agent's assessment (when evidence argues against its validity), or remains *neutral* (when conflicting or insufficient evidence exists to assert one direction or the other).  (Enumerated values = 'supports', 'disputes', 'neutral')." .

<https://example.org/sepio-model/directionOfEvidenceProvided> a owl:DatatypeProperty ;
    rdfs:label "directionOfEvidenceProvided" ;
    ns1:status "Draft" ;
    skos:definition "The direction of support that the Evidence Line is determined to provide toward its target Proposition (supports, disputes, neutral)." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/doi> a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    ns1:status "Draft" ;
    skos:definition "A `Digital Object Identifier <https://www.doi.org/the-identifier/what-is-a-doi/>_` for the document." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/extensionDescription> a owl:DatatypeProperty ;
    rdfs:label "extensionDescription" ;
    skos:definition "A free text description of the intended meaning and use of the extension element, which may include the types of values it takes, and how to interpret these values in the context of the parent Class." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/focus> a owl:DatatypeProperty ;
    rdfs:label "focus" ;
    skos:definition "A specific subject or experimental unit in a Study, that data in the StudyResult object is about - e.g. a particular variant in a population allele frequency dataset like ExAC or gnomAD." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "The 'focus' of a StudyResult is the what anchors selection of all data items and provenance information that it contains. This focus may be a single participant or subject of a study (e.g. one patient in a clinical study, or one allele in a population frequency analysis). It may be a study group defined as an experimental unit in the study (e.g. a specific treatment arm of a clinical study). Or it may be a variable defined as a unit of analysis in the study (e.g. 'exposure to nicotine' in an analysis correlating this variable with clinical outcomes)." .

<https://example.org/sepio-model/id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    ns1:status "Draft" ;
    skos:definition "The 'logical' identifier of the entity in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference one object from another." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Note that it is common for implementers to create their own internal logical ids - typically a serially or randomly generated value like a UUID that is assigned to the data object as it is created in a system. But an implementer may choose to reuse an existing, globally unique id from an external system or authority for this purpose (e.g. an HGNC id for a Gene object) - as long as it is unique within the implementing system, and can be used to reference the identified object in this context." .

<https://example.org/sepio-model/informationQuality> a owl:ObjectProperty ;
    rdfs:label "informationQuality" ;
    ns1:status "Informative" ;
    skos:definition "A qualitative term indicating the scientific rigor or reliability with which the information was generated/collected." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Implementers should define a relevant source of codes or terms to use here, based on the needs of the domain or application.'",
        "The quality of information is intrinsic to the information itself, and not to a particular application of the information (e.g. as evidence for making an Assertion)",
        "The quality of information is one factor that goes into the confidence we have in the information''s veracity (i.e. that it is an accurate reflection of reality it intends to measure or describe). Other factors informing confidence may include who did it (we may just not trust some Agents), when (if data created 500 years ago, we may have less confidence in it), and for Assertions, the relevance and abundance of supporting evidence.",
        "This is typically based on the quality of design and execution of the study or curation activity that generated it (e.g. were relevant controls assessed to show instruments were working, were all samples taken care of and handled identically, are methods sound and well documented, etc.)." .

<https://example.org/sepio-model/interpretation> a owl:ObjectProperty ;
    rdfs:label "interpretation" ;
    ns1:status "Informative" ;
    skos:definition "The outcome of an interpretation of lower-level data item(s) in a StudyResult, that express some broader conclusion or insight that was made (e.g. that data indicates a result to be is high, normal, or low)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute allows basic interpretations / classifications to be included in a Study Result, such as binning a data item or items as being in or out of some normal range." .

<https://example.org/sepio-model/memberCount> a owl:DatatypeProperty ;
    rdfs:label "memberCount" ;
    ns1:status "Informative" ;
    skos:definition "The total number of individual members in the StudyGroup." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/negated> a owl:DatatypeProperty ;
    rdfs:label "negated" ;
    ns1:status "Informative" ;
    skos:definition "A boolean flag set to 'true' to represent a negation of the proposition expressed by the subject, predicate, object, and qualifier(s) (e.g. that \"Variant X is NOT pathogenic for Disease Y\")" ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Along with the 'subject', predicate', 'object', and 'qualifier' attributes, the 'negated' element contributes to the semantics of the 'possible fact' that a Proposition expresses." .

<https://example.org/sepio-model/pmid> a owl:DatatypeProperty ;
    rdfs:label "pmid" ;
    ns1:status "Draft" ;
    skos:definition "A `PubMed unique identifier <https://en.wikipedia.org/wiki/PubMed#PubMed_identifier>`_ for the document." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/proposition> a owl:ObjectProperty ;
    rdfs:label "proposition" ;
    ns1:status "Informative" ;
    skos:definition "A possible fact that the Statement assesses or puts forth as true." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute supports an alternate modeling pattern where the structured semantics of the possible fact asserted or evaluated by a Statement is encapsulated in a separate 'Proposition' object. In such a case, the subject-predicate-object-qualifier properties on the Statement are not utilized. A given implementation should decide which pattern to follow and drop attributes not required for their approach." .

<https://example.org/sepio-model/propositionText> a owl:DatatypeProperty ;
    rdfs:label "propositionText" ;
    ns1:status "Informative" ;
    skos:definition "A natural-language expression of the Proposition's meaning (i.e. the 'possible fact' it expresses)." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/recordIdentifier> a owl:DatatypeProperty ;
    rdfs:label "recordIdentifier" ;
    ns1:status "Draft" ;
    skos:definition "The identifier of the record described in the RecordMetadata object (required when the record described is not the one in the present system)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This is needed only when the RecordMetadata object describes an upstream source record, as opposed to the record in the present system, so it is clear what the metadata it contains is about.  e.g. when ClinGen ingests and transforms ClinVar data, it wants to maintain a record of when the source ClinVar record was submitted and by whom.  A RecordMetadata object could be created that describes this upstream source record, including information about its submission to ClinVar." .

<https://example.org/sepio-model/recordMetadata> a owl:ObjectProperty ;
    rdfs:label "recordMetadata" ;
    ns1:status "Draft" ;
    skos:definition "Provenance metadata about a specific concrete record of information as encoded/serialized in a particular data set or object (as opposed to provenance about the abstract information content the encoding carries)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute holds a structured RecordMetadata objects, which can be used to capture when, how, and by whom a record serialization was generated or modified; what upstream resources it was derived or retrieved from; and record-level administrative information such as versioning and lifecycle status." .

<https://example.org/sepio-model/recordVersion> a owl:DatatypeProperty ;
    rdfs:label "recordVersion" ;
    ns1:status "Draft" ;
    skos:definition "The version number of the record-level artifact the object describes." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/releaseDate> a owl:DatatypeProperty ;
    rdfs:label "releaseDate" ;
    ns1:status "Informative" ;
    skos:definition "Indicates when a version of a DataSet was formally released." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute may apply to version and distribution-level DataSet representations. It refers to when the data set was released, which may be different than the data set was generated." .

<https://example.org/sepio-model/score> a owl:DatatypeProperty ;
    rdfs:label "score" ;
    ns1:status "Draft" ;
    skos:definition "A quantitative score that indicates the strength of a Proposition's validity assessment in the direction indicated (i.e. how strongly supported or disputed the Proposition is believed to be).  Depending on its implementation, a score may reflect how *confident* that agent is that the Proposition is true or false, or the *strength of evidence* they believe supports or disputes it." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Statements put forth a Proposition that expresses some possible fact about the world, and may provide an assessment of this proposition's validity (i.e. how likely it is to be true or false based on evaluated evidence). The semantics of the Proposition are captured in the 'subject', 'predicate', 'object', and optional 'qualifier' attributes. The assessment of the Proposition's validity are captured in 'direction', 'strength', and 'score' attributes.  The 'score' attribute serves the same purpose as 'strength', but allows for a quantitative assessment based on a numerical score." .

<https://example.org/sepio-model/scoreOfEvidenceProvided> a owl:DatatypeProperty ;
    rdfs:label "scoreOfEvidenceProvided" ;
    ns1:status "Draft" ;
    skos:definition "A quantitative score indicating the strength of support that an Evidence Line is determined to provide for or against its target Proposition, evaluated relative to the direction indicated by the directionOfEvidenceProvided value." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "A given profile or implementation can define a scoring scale and rules that meet the needs of their domain or application." .

<https://example.org/sepio-model/specifiedBy> a owl:DatatypeProperty .

<https://example.org/sepio-model/statementText> a owl:DatatypeProperty ;
    rdfs:label "statementText" ;
    ns1:status "Draft" ;
    skos:definition "A natural-language expression of what a Statement asserts to be true." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute captures what a Statement says as human readable free text. e.g. that \"BRCA2 c.8023A>G is pathogenic for Breast Cancer\", or that \"there is moderate evidence supporting the pathogenicity of BRCA2 c.8023A>G for Breast Cancer\". This optional attribute can be used instead of, or as a complement to, a structured representation of Statement semantics that uses the subject-predicate-object-qualifier pattern." .

<https://example.org/sepio-model/strength> a owl:DatatypeProperty ;
    rdfs:label "strength" ;
    ns1:status "Draft" ;
    skos:definition "A term used to report the strength of a Proposition's assessment in the direction indicated (i.e. how strongly supported or disputed the Proposition is believed to be).  Implementers may choose to frame a strength assessment in terms of how *confident* an agent is that the Proposition is true or false, or in terms of the *strength of all evidence* they believe supports or disputes it." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Statements put forth a Proposition that expresses some possible fact about the world, and may provide an assessment of this proposition's validity (i.e. how likely it is to be true or false based on evaluated evidence). The semantics of the Proposition are captured in the 'subject,' 'predicate', 'object', and optional 'qualifier' attributes. An assessment of the Proposition's validity can be captured using 'direction',  'strength', and 'score' attributes. The 'strength' attribute is used to report the strength of this assessment in the direction indicated. Strength can be framed as a *level of confidence* that the Proposition is true or false, or as a *level of evidence* that supports or disputes it. Data creators can define the permissible values for the 'strength' attribute to indicate which of these facets is being assessed (e.g. 'high confidence' vs 'low confidence', or 'strong evidence' vs 'weak evidence') - or they can choose values that don't commit to one or the other if they don't want to make the distinction (e.g. 'high' vs 'medium' vs 'low')." .

<https://example.org/sepio-model/strengthOfEvidenceProvided> a owl:DatatypeProperty ;
    rdfs:label "strengthOfEvidenceProvided" ;
    ns1:status "Draft" ;
    skos:definition "The strength of support that an Evidence Line is determined to provide for or against its target Proposition, evaluated relative to the direction indicated by the directionOfEvidenceProvided." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Values of this attribute can be defined by for a given profile based on domain/application needs, but should be framed in qualitative terms (e.g. 'strong', 'moderate', 'weak'). The 'scoreOfEvidenceProvided' attribute can be used to report quantitative assessments of evidence provided." .

<https://example.org/sepio-model/studyGroup> a owl:ObjectProperty ;
    rdfs:label "studyGroup" ;
    skos:definition "A description of a specific group or population of subjects interrogated in the ResearchStudy that produced the data captured in the StudyResult." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "For example, in a StudyResult holding allele frequency data, this attribute points to a StudyGroup object that describes characteristics of the population that the frequency data was generated from (e.g. 'East Asian', 'Female')." .

<https://example.org/sepio-model/subjectClassification> a owl:ObjectProperty ;
    rdfs:label "subjectClassification" ;
    ns1:status "Draft" ;
    skos:definition "A single term or phrase summarizing the outcome of direction and strength assessments of a Statement's proposition, in terms of a classification of its subject." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Permissible values for this attribute are  typically selected to be succinct and familiar in the target community of practice - and can be provided to report of a statement's conclusion in user-friendly terms. For example, in a Statement assessing the proposition that \"BRCA2 c.8023A>G is pathogenic for Breast Cancer\", and reporting a direction of 'supports' and strength of 'likely', the term  'likely pathogenic' from the ACMG Variant Interpretation Guidelines would be used as a subject classification." .

<https://example.org/sepio-model/system> a owl:DatatypeProperty ;
    rdfs:label "system" ;
    skos:definition "The terminology/code system that defined the code.  May be reported as a free-text name (e.g. ‘Sequence Ontology’), but it is preferable to provide  a uri/url for the system. When the 'code' is reported as a CURIE, the 'system' should be reported as the uri that the CURIE's prefix expands to (e.g. 'http://purl.obofoundry.org/so.owl/' for the Sequence Ontology)." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/systemURL> a owl:ObjectProperty ;
    rdfs:label "systemURL" ;
    skos:definition "A URL for the nomenclature system" ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/targetProposition> a owl:ObjectProperty ;
    rdfs:label "targetProposition" ;
    ns1:status "Informative" ;
    skos:definition "The possible fact against which evidence items contained in an Evidence Line were collectively evaluated, in determining the overall strength and direction of support they provide. For example, in an ACMG Guideline-based assessment of variant pathogenicity, the support provided by distinct lines of evidence are assessed against a target proposition that some variant is pathogenic for a specific disease." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "An example based on the ACMG Guidelines for germline variant pathogenicity interpretation: Consider a curator assessing the evidence provided by population frequency data for a specific variant based on the ACMG criteria. In order to assign a strength (e.g. moderate vs strong) and direction (supports vs disputes) to this data as evidence, there must be some 'target proposition' toward which the evidence is assessed - which in this cases is the proposition that the variant is pathogenic for the disease of interest. If the PM2 criteria is deemed 'met', this indicates that the population frequency evidence provides 'moderate' (strength) 'support' (direction) for this target proposition." .

<https://example.org/sepio-model/title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:definition "The official title given to the document by its authors." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/type> a owl:DatatypeProperty ;
    rdfs:label "type" ;
    ns1:status "Draft" ;
    skos:definition "The name of the class that is instantiated by a data object representing the Entity." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "MUST be the label of a concrete class from the data model." .

<https://example.org/sepio-model/unit> a owl:ObjectProperty ;
    rdfs:label "unit" ;
    ns1:status "Informative" ;
    skos:definition "A unit of measure for the value (e.g. meters, grams, fluorescent units, seconds, mg/ml, etc.)" ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Implementers should define a relevant source or specific set of unit terms/codes to use here based on the needs of the domain or application." .

<https://example.org/sepio-model/valueOperator> a owl:DatatypeProperty ;
    rdfs:label "valueOperator" ;
    ns1:status "Informative" ;
    skos:definition "An operation that defines how to logically interpret a set of more than one Characteristic values ('AND', 'OR', 'NOT')." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "An 'AND' operator indicates that an individual exhibits all of the characteristic values listed.  An 'OR' operator indicates the individual exhibits one or more of the characteristic values listed. A 'NOT' indicates that the individual does not exhibit the characteristic value or values listed." .

<https://example.org/sepio-model/version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    ns1:status "Informative" ;
    skos:definition "The version of the DataSet, as assigned by its creator." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This property can capture version information for resources such as data sets and documents that get published and released as a unit for community use. These may go through rounds of revisions that add or modify content, but don't change the identity of the resource. Use this attribute in cases where version is not reflected in an identifier associated with the data set" .

camo:analysis_method a owl:ObjectProperty ;
    rdfs:label "analysis_method" ;
    skos:definition "The analysis that produced the reported result. Distinct from evidential_basis.evidence_types, which records the study design." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:comparator_dose a owl:ObjectProperty ;
    rdfs:label "comparator_dose" ;
    skos:definition "The level or range of the subject driver in this comparison arm, so that both ends of the contrast are recoverable. Pairs with CausalEdge.dose, which gives this edge's own level: the two together are what lets a dose-response curve be fitted and an effect size be recomputed. Expected when comparator_type is alternative_dose_level." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:comparator_dose_level a owl:ObjectProperty ;
    rdfs:label "comparator_dose_level" ;
    skos:definition "The arm's level on the ordinal scale, for sources that name it without a number, e.g. \"relative to lower initial densities\". Use alongside comparator_dose where the source gives both." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:context_dependence a owl:ObjectProperty ;
    rdfs:label "context_dependence" ;
    skos:definition "Annotation of scope conditions or context dependence for the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:contributing_sole a owl:ObjectProperty ;
    rdfs:label "contributing_sole" ;
    skos:definition "Whether the cause is presented as a sole cause or contributing cause." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:determinism a owl:ObjectProperty ;
    rdfs:label "determinism" ;
    skos:definition "Whether the causal relationship frames the underlying process as deterministic or indeterministic, or uses probability only to express epistemic uncertainty." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    skos:definition "Annotation of causal direction and evidence for direction." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:mediation a owl:ObjectProperty ;
    rdfs:label "mediation" ;
    skos:definition "Annotation of any mediating pathway between cause and effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:moderation a owl:ObjectProperty ;
    rdfs:label "moderation" ;
    skos:definition "Annotation of any moderator or effect modifier for the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:necessity a owl:ObjectProperty ;
    rdfs:label "necessity" ;
    skos:definition "Whether the cause is characterized as necessary for the effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:p_value a owl:DatatypeProperty ;
    rdfs:label "p_value" ;
    skos:definition "The reported p-value for the contrast this edge describes. Give the value for this specific contrast, not an omnibus test spanning several outcomes; where only an omnibus test is reported, leave this empty and record the test in analysis_method." ;
    skos:exactMatch OBI:0000175,
        <http://purl.obolibrary.org/obo/STATO_0000700> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:proportionality a owl:ObjectProperty ;
    rdfs:label "proportionality" ;
    skos:definition "Whether the cause is characterized at a proportional level of specificity." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:proximate_distal a owl:ObjectProperty ;
    rdfs:label "proximate_distal" ;
    skos:definition "Whether the cause is positioned as proximate, distal, or both." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:reversibility a owl:ObjectProperty ;
    rdfs:label "reversibility" ;
    skos:definition "Whether removing the cause is characterized as reversing the effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    skos:definition "What the claim is about: one case (assertional), some cases under stated conditions (contingent), typical cases (prototypical) or all cases (universal). Use instead of token_or_type. Most findings reported from a single study are assertional or contingent; general statements in an author's own voice are prototypical or universal." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:significance a owl:ObjectProperty ;
    rdfs:label "significance" ;
    skos:definition "Whether the source reported this relationship as statistically significant. Fill it even where no p-value is given: not_tested and not_reported are informative, and without this slot an edge whose causal_language is no_relationship cannot be told apart from a relationship the study never tested." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:specificity a owl:ObjectProperty ;
    rdfs:label "specificity" ;
    skos:definition "Whether the causal relationship is characterized as specific to particular causes or effects." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:stability a owl:ObjectProperty ;
    rdfs:label "stability" ;
    skos:definition "Whether the causal relationship is characterized as stable across contexts or conditions." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:strength a owl:ObjectProperty ;
    rdfs:label "strength" ;
    skos:definition "Annotation of the reported strength or magnitude of the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:sufficiency a owl:ObjectProperty ;
    rdfs:label "sufficiency" ;
    skos:definition "Whether the cause is characterized as sufficient for the effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:temporal_ordering a owl:ObjectProperty ;
    rdfs:label "temporal_ordering" ;
    skos:definition "Whether temporal ordering between cause and effect is addressed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

camo:time_since_intervention_months a owl:DatatypeProperty ;
    rdfs:label "time_since_intervention_months" ;
    skos:closeMatch time:numericDuration ;
    skos:definition "Elapsed time between the intervention, or the onset of the driver, and the measurement this edge reports, in months. \"in year 2\" is 24; \"six years after establishing the experiment\" is 72. Distinct from duration_months, which is how long the effect lasted, and from lag_months, which is how long it took to begin. Where a reading spans a window, give its end. This is the slot that lets readings from one study be ordered into a trajectory." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:note "close, not exact: OWL-Time pairs a numeric duration with a separate unit, whereas this slot fixes the unit to months." .

causal_mosaic:ComparatorAnnotation a owl:Class ;
    rdfs:label "ComparatorAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:DoseLevelEnum ;
            owl:onProperty camo:comparator_dose_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator_node_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:comparator_node_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:comparator_dose_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:comparator_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ComparatorTypeEnum ;
            owl:onProperty causal_mosaic:comparator_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:comparator_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:QuantityValue ;
            owl:onProperty camo:comparator_dose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:comparator_dose_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:comparator_dose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:comparator_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:comparator_node_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:comparator_dose ] ;
    skos:definition """One comparison arm of a causal edge; an edge lists one per arm (see CausalEdge.comparator). Controls are recorded here rather than as nodes: nodes represent states and changes in state, whereas a control represents what a measurement was contrasted with. Modelling a control as a node forces either a hub node shared across unrelated studies or a per-study singleton that can never merge, and neither survives type-level synthesis.\r
Where the comparison arm is itself a management decision a practitioner could take — natural regeneration, cessation of grazing — annotate it as an ordinary management_intervention or environmental_process node and point comparator_node_id at it. An arm that exists only to be measured against gets no node.\r
A factor applied to every arm including the comparator explains no between-arm difference and is not a cause the study tests; it should not be annotated as a cause in that document's graph.""" ;
    skos:exactMatch causal_mosaic:ComparatorAnnotation ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:CompositionMember a owl:Class ;
    rdfs:label "CompositionMember" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:dominance ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:rank ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:rank ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:dominance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:share ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty warp:share ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:dominance ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:rank ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:QuantityValue ;
            owl:onProperty causal_mosaic:share ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DominanceEnum ;
            owl:onProperty causal_mosaic:dominance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:rank ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:share ],
        causal_mosaic:EntityReference ;
    skos:definition "One member of an observed assemblage, with how much of the whole it accounts for. Inherits the entity_type / entity_term / life_stage decomposition from EntityReference, so a member is grounded the same way as an applied_to entry, and adds the member's amount. Give share when the source reports a number, dominance when it ranks members without one, and rank to preserve an explicit ordering." ;
    skos:exactMatch causal_mosaic:CompositionMember ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:DirectionAnnotation a owl:Class ;
    rdfs:label "DirectionAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_for_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DirectionEvidenceEnum ;
            owl:onProperty causal_mosaic:evidence_for_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DirectionStatusEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:evidence_for_direction ] ;
    skos:definition "Direction and asymmetry of the causal relationship." ;
    skos:exactMatch causal_mosaic:DirectionAnnotation ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:EntityReference a owl:Class ;
    rdfs:label "EntityReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:life_stage_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EntityTypeEnum ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:life_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:life_stage_term ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:life_stage_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:entity_term ],
        [ owl:unionOf ( causal_mosaic:AppliedToEntity causal_mosaic:CompositionMember ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:LifeStageEnum ;
            owl:onProperty camo:life_stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:life_stage ] ;
    skos:definition "The entity_type / entity_term / life_stage decomposition shared by the structured entity references: AppliedToEntity (applied_to entries) and CompositionMember (members of an observed assemblage). Abstract, so that the two stay separate range types: a CompositionMember is not accepted where an AppliedToEntity is expected, and the other way round." ;
    skos:exactMatch causal_mosaic:EntityReference ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:EvidentialBasis a owl:Class ;
    rdfs:label "EvidentialBasis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_objects ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceTypeEnum ;
            owl:onProperty causal_mosaic:evidence_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceObjectEnum ;
            owl:onProperty causal_mosaic:evidence_objects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_types ] ;
    skos:definition "Operationalizes Illari's type/object distinction and the Russo-Williamson Thesis at the article-annotation level. Tracks what kinds of evidence an individual source provides; aggregate criteria are assessed on EvidenceBaseAssessmentEdge." ;
    skos:exactMatch causal_mosaic:EvidentialBasis ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:MediationAnnotation a owl:Class ;
    rdfs:label "MediationAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:mediator_node_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:mediator_node_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:pathway_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:pathway_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:pathway_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ] ;
    skos:definition "Whether a mediating pathway is identified between cause and effect." ;
    skos:exactMatch causal_mosaic:MediationAnnotation ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ModerationAnnotation a owl:Class ;
    rdfs:label "ModerationAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:interaction_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionTypeEnum ;
            owl:onProperty causal_mosaic:interaction_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:moderator_node_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:interaction_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:moderator_node_ids ] ;
    skos:definition "Whether effect modification by a third variable is noted." ;
    skos:exactMatch causal_mosaic:ModerationAnnotation ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:StrengthAnnotation a owl:Class ;
    rdfs:label "StrengthAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:quantitative_numeric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:significance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:interval_upper ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:p_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:dose_response_shape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:interval_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty causal_mosaic:dose_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:quantitative_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:analysis_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:dose_response ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:interval_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:p_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:interval_upper ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:interval_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:interval_lower ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:interval_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:qualitative_descriptor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:interval_lower ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:StrengthQualitativeEnum ;
            owl:onProperty causal_mosaic:qualitative_descriptor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:analysis_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DoseResponseShapeEnum ;
            owl:onProperty causal_mosaic:dose_response_shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty camo:p_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:interval_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:dose_response_shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AnalysisMethodEnum ;
            owl:onProperty camo:analysis_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:interval_upper ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:qualitative_descriptor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:significance ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EffectMetricEnum ;
            owl:onProperty causal_mosaic:effect_metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:effect_metric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:alpha ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:quantitative_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:quantitative_numeric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:effect_metric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:quantitative_numeric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:alpha ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:dose_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:alpha ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:interval_lower ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:SignificanceEnum ;
            owl:onProperty camo:significance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:quantitative_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:IntervalTypeEnum ;
            owl:onProperty causal_mosaic:interval_type ] ;
    skos:definition "Effect size, magnitude, or dose-response characterization." ;
    skos:exactMatch causal_mosaic:StrengthAnnotation ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:acquisition_method a owl:ObjectProperty ;
    rdfs:label "acquisition_method" ;
    skos:definition "Broad kind of data collection the option uses." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_certainty_grade a owl:ObjectProperty ;
    rdfs:label "aggregate_certainty_grade" ;
    skos:definition "Certainty grade assigned to the aggregate evidence-base assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_certainty_rationale a owl:DatatypeProperty ;
    rdfs:label "aggregate_certainty_rationale" ;
    skos:definition "Rationale for the aggregate certainty grade." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_effect_sign a owl:DatatypeProperty ;
    rdfs:label "aggregate_effect_sign" ;
    skos:definition "Aggregate direction/sign of the effect, if assessed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "positive, negative, mixed, neutral, unknown" .

causal_mosaic:aggregate_effect_size a owl:DatatypeProperty ;
    rdfs:label "aggregate_effect_size" ;
    skos:definition "Aggregate effect size or summary statistic, if available." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_fcm_weight a owl:DatatypeProperty ;
    rdfs:label "aggregate_fcm_weight" ;
    skos:definition "Aggregate FCM edge weight for the summarized relationship, normalized to the [-1, 1] fuzzy-cognitive-map convention." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:aggregate_fcm_weight_source a owl:DatatypeProperty ;
    rdfs:label "aggregate_fcm_weight_source" ;
    skos:definition "Method or provenance note explaining how aggregate_fcm_weight was derived from the included evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "weighted_mean_of_member_edges, meta_analysis_effect_size, expert_elicitation, certainty_downweighted" .

causal_mosaic:alpha a owl:DatatypeProperty ;
    rdfs:label "alpha" ;
    skos:definition "The significance threshold the source used, where it states one, e.g. 0.05. Lets a significance verdict be re-derived from p_value." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_confidence a owl:DatatypeProperty ;
    rdfs:label "annotation_confidence" ;
    skos:definition "Annotator confidence in the overall annotation, 0.0-1.0." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_guide_version a owl:DatatypeProperty ;
    rdfs:label "annotation_guide_version" ;
    skos:definition "Version of the annotation guide used to create the graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_notes a owl:DatatypeProperty ;
    rdfs:label "annotation_notes" ;
    skos:definition "Free-text notes from the annotator about this edge." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_protocol a owl:ObjectProperty ;
    rdfs:label "annotation_protocol" ;
    skos:definition "DOI or URL of the annotation protocol document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:annotation_timestamp a owl:DatatypeProperty ;
    rdfs:label "annotation_timestamp" ;
    skos:definition "Date and time when the edge annotation was created." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessed_by a owl:DatatypeProperty ;
    rdfs:label "assessed_by" ;
    skos:definition "Identifier for the person, model, or workflow that generated the assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessment_method a owl:DatatypeProperty ;
    rdfs:label "assessment_method" ;
    skos:definition "Method used to generate the evidence-base assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "automated_rule, narrative_synthesis, systematic_review, meta_analysis, expert_review" .

causal_mosaic:assessment_notes a owl:DatatypeProperty ;
    rdfs:label "assessment_notes" ;
    skos:definition "Free-text notes about the aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessment_timestamp a owl:DatatypeProperty ;
    rdfs:label "assessment_timestamp" ;
    skos:definition "Date and time when the aggregate assessment was generated." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:assessment_version a owl:DatatypeProperty ;
    rdfs:label "assessment_version" ;
    skos:definition "Version of the assessment method or ruleset." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:basis a owl:ObjectProperty ;
    rdfs:label "basis" ;
    skos:definition "What the member shares measure. Required, because a share without its basis cannot be compared across studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:bbox_east a owl:DatatypeProperty ;
    rdfs:label "bbox_east" ;
    skos:definition "Eastern boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bbox_north a owl:DatatypeProperty ;
    rdfs:label "bbox_north" ;
    skos:definition "Northern boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bbox_south a owl:DatatypeProperty ;
    rdfs:label "bbox_south" ;
    skos:definition "Southern boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bbox_west a owl:DatatypeProperty ;
    rdfs:label "bbox_west" ;
    skos:definition "Western boundary of study area bounding box (decimal degrees)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "collapse" .

causal_mosaic:bradford_hill_count a owl:DatatypeProperty ;
    rdfs:label "bradford_hill_count" ;
    skos:definition "Count of Bradford Hill viewpoints supported by the aggregated evidence base." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:catalog_id a owl:ObjectProperty ;
    rdfs:label "catalog_id" ;
    skos:definition "Unique identifier for this catalog." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:catalog_version a owl:DatatypeProperty ;
    rdfs:label "catalog_version" ;
    skos:definition "Version of the catalog contents, changed whenever options are added, edited or deprecated. Independent of the schema version." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:causal_language a owl:ObjectProperty ;
    rdfs:label "causal_language" ;
    skos:altLabel "claim_strength" ;
    skos:definition "How strong is the causal language used?" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:causal_mosaic_version a owl:DatatypeProperty ;
    rdfs:label "causal_mosaic_version" ;
    skos:definition "Version of the CAMO annotation framework used." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:certainty_grade a owl:ObjectProperty ;
    rdfs:label "certainty_grade" ;
    skos:definition "GRADE-style certainty assessment for this individual causal claim. Controls downstream language in Rosetta Statement rendering." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator_description a owl:DatatypeProperty ;
    rdfs:label "comparator_description" ;
    skos:definition "The comparison arm as the source names it, verbatim or near-verbatim. E.g. \"natural (disturbed, unseeded)\", \"no treatment (control)\"." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator_node_id a owl:ObjectProperty ;
    rdfs:label "comparator_node_id" ;
    skos:definition "Node ID of the comparison arm, where that arm is itself annotated as a node. Expected when comparator_type is passive_management_arm or alternative_treatment; normally empty otherwise." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator_type a owl:ObjectProperty ;
    rdfs:label "comparator_type" ;
    skos:definition "The basis against which the effect was assessed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:composition a owl:ObjectProperty ;
    rdfs:label "composition" ;
    skos:definition """For composite_variable nodes, the reported composition of the assemblage: its members and how much of the whole each accounts for. Requires entity_type: composite_variable. Not part of variable_key.\r
Which slot to use. Where the source gives each member's share, or ranks the members, record a composition: a number goes in member.share, a ranking with no number in member.dominance or member.rank. Where the source only names the members, with no share and no ranking, there is no composition to record: list them in applied_to and put presence or disappearance in state_or_change_qualifier, which is what those slots are for. Every composition member must carry an amount in one of the three forms, so a bare membership list will be rejected here by design.\r
Use components, not composition, for what a management intervention applied, such as a seed mix and its rates.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:conflict_summary a owl:DatatypeProperty ;
    rdfs:label "conflict_summary" ;
    skos:definition "Summary of important conflicts or heterogeneity across included studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:context_dependence_summary a owl:DatatypeProperty ;
    rdfs:label "context_dependence_summary" ;
    skos:definition "Summary of contexts or scope conditions that affect the aggregate relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:coordinate_uncertainty_m a owl:DatatypeProperty ;
    rdfs:label "coordinate_uncertainty_m" ;
    skos:definition "Uncertainty radius in metres around the centroid coordinates. If the paper reports coordinates to the nearest minute (~1850m) vs. second (~30m) vs. high-precision GPS (~5m), this field captures that. Follows Darwin Core dwc:coordinateUncertaintyInMeters." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/coordinateUncertaintyInMeters> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:counted_entity a owl:ObjectProperty ;
    rdfs:label "counted_entity" ;
    skos:definition "What is counted or measured, when the unit alone does not say, e.g. ramets of Sanguinaria canadensis in \"9 ramets/m2\"." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:created a owl:DatatypeProperty ;
    rdfs:label "created" ;
    skos:definition "Date and time when the graph metadata was created." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:document_id a owl:DatatypeProperty ;
    rdfs:label "document_id" ;
    skos:definition "Local identifier for this document within the graph. Use the DOI where one exists." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    skos:definition "Digital Object Identifier for the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:dominance a owl:ObjectProperty ;
    rdfs:label "dominance" ;
    skos:definition "The member's ordinal standing where the source gives no number. Leave empty when share is given and the source adds no ranking." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:dose_response a owl:DatatypeProperty ;
    rdfs:label "dose_response" ;
    skos:definition "Is a dose-response or gradient relationship described? Kept for 0.8.0 records; when dose_response_shape is given, this should be true unless the shape is none (loom enforces this)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:dose_response_shape a owl:ObjectProperty ;
    rdfs:label "dose_response_shape" ;
    skos:definition "Shape of the dose-response relationship, when one is described." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:duration_months a owl:DatatypeProperty ;
    rdfs:label "duration_months" ;
    skos:definition "Duration of the observed causal effect in months. E.g., 36 for \"within three years\", 6 for \"one growing season.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:duration_text a owl:DatatypeProperty ;
    rdfs:label "duration_text" ;
    skos:definition "How long the effect lasted, as stated in the source. E.g., \"within three growing seasons\", \"over a 20-year period\", \"immediately following treatment.\" This slot is about the effect's duration only: when the measurement was taken belongs in time_since_intervention_text, the seasons it was observed in belong in observation_seasons, and the study's own fieldwork dates belong in source_document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ecosystem_context a owl:ObjectProperty ;
    rdfs:label "ecosystem_context" ;
    skos:definition "The IUCN Global Ecosystem Typology Level 3 ecosystem functional group in which this causal relationship was observed, represented by an ELMO ecosystem type term. Use this edge-level field for the ecosystem setting of the causal claim." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:elm_correspondence "ecosystem_context_qualifier" ;
    warp:examples "temperate_subhumid_grasslands, seagrass_meadows" .

causal_mosaic:ecosystem_scope a owl:ObjectProperty ;
    rdfs:label "ecosystem_scope" ;
    skos:definition "Ecosystem type scope, mapped to IUCN GET." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:effect_metric a owl:ObjectProperty ;
    rdfs:label "effect_metric" ;
    skos:definition "Metric of quantitative_numeric." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:effect_size_metric a owl:DatatypeProperty ;
    rdfs:label "effect_size_metric" ;
    skos:definition "Metric used for the aggregate effect size." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "risk ratio, odds ratio, standardized mean difference, correlation coefficient" .

causal_mosaic:effect_size_summary_method a owl:DatatypeProperty ;
    rdfs:label "effect_size_summary_method" ;
    skos:definition "Method used to summarize effect sizes across studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "meta_analysis, vote_counting, narrative_synthesis, expert_assessment" .

causal_mosaic:elevation_m a owl:DatatypeProperty ;
    rdfs:label "elevation_m" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/verbatimElevation> ;
    skos:definition "Elevation of the coordinate location in metres above sea level, if reported. Useful for montane and altitudinal gradient studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:elm_version a owl:DatatypeProperty ;
    rdfs:label "elm_version" ;
    skos:definition "Version of the Ecolink Model Ontology entity structure used." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:embedding_text a owl:DatatypeProperty ;
    rdfs:label "embedding_text" ;
    skos:definition "Concatenated text used for generating the embedding vector. Typically: name + description + synonym list." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:embedding_vector a owl:DatatypeProperty ;
    rdfs:label "embedding_vector" ;
    skos:definition "Pre-computed embedding vector for RAG retrieval. Stored as serialized float array. Generated by the indexing pipeline, not by annotators." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" ;
    warp:note "Serialized float32 array; decode with numpy/arrow" .

causal_mosaic:end_char a owl:DatatypeProperty ;
    rdfs:label "end_char" ;
    skos:definition "Character offset end." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:evidence_balance a owl:ObjectProperty ;
    rdfs:label "evidence_balance" ;
    skos:definition "Overall balance of the included evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_for_direction a owl:ObjectProperty ;
    rdfs:label "evidence_for_direction" ;
    skos:definition "Evidence used to establish the direction of causation." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:exclusion_rationale a owl:DatatypeProperty ;
    rdfs:label "exclusion_rationale" ;
    skos:definition "Free-text rationale for exclusions, if any." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:export_sha256 a owl:DatatypeProperty ;
    rdfs:label "export_sha256" ;
    skos:definition "SHA-256 hex digest of the YAML export, computed before provenance was embedded, for integrity verification." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:exported_at a owl:DatatypeProperty ;
    rdfs:label "exported_at" ;
    skos:definition "ISO 8601 timestamp when this export was produced." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:exporter_version a owl:DatatypeProperty ;
    rdfs:label "exporter_version" ;
    skos:definition "Version string of the software tool that produced this export (e.g. 'loom-1.2.0')." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:fcm_weight a owl:DatatypeProperty ;
    rdfs:label "fcm_weight" ;
    skos:definition "Numeric edge weight for Fuzzy Cognitive Map rendering. Range: -1.0 (strong negative) to +1.0 (strong positive). Stored at the state level: its sign is the predicate sign only, and the subject and object qualifiers are not applied, because they are part of each node's identity. A variable-level FCM multiplies this weight by the subject and object fcm_sign at render time (see the sign-composition rule in CausalPredicateEnum). Magnitude is derived from the predicate's fcm_default_weight, causal_language, and the strength annotation. Can be overridden by expert elicitation; record which in fcm_weight_source." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:fcm_weight_source a owl:DatatypeProperty ;
    rdfs:label "fcm_weight_source" ;
    skos:definition "How the FCM weight was determined." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "derived_from_schema, expert_elicitation, meta_analysis_effect_size" ;
    warp:loom_role "hidden" .

causal_mosaic:geodetic_datum a owl:DatatypeProperty ;
    rdfs:label "geodetic_datum" ;
    skos:definition "The geodetic datum used by the coordinates (WGS84 preferred)" ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/geodeticDatum> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:geographic_scope a owl:DatatypeProperty ;
    rdfs:label "geographic_scope" ;
    skos:definition "Geographic scope of the claim." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:graph_id a owl:DatatypeProperty ;
    rdfs:label "graph_id" ;
    skos:definition "Unique identifier for this graph or sub-graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:has_difference_making_evidence a owl:ObjectProperty ;
    rdfs:label "has_difference_making_evidence" ;
    skos:definition "Aggregate assessment of whether the evidence base contains difference-making evidence for the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:has_production_evidence a owl:ObjectProperty ;
    rdfs:label "has_production_evidence" ;
    skos:definition "Aggregate assessment of whether the evidence base contains production or mechanistic evidence for the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:heterogeneity a owl:DatatypeProperty ;
    rdfs:label "heterogeneity" ;
    skos:definition "Heterogeneity statistic or qualitative heterogeneity summary." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:inclusion_criteria a owl:DatatypeProperty ;
    rdfs:label "inclusion_criteria" ;
    skos:definition "Criteria used to decide which article-level edges belong in this aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:interaction_type a owl:ObjectProperty ;
    rdfs:label "interaction_type" ;
    skos:definition "Type of interaction or effect modification described." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:interval_level a owl:DatatypeProperty ;
    rdfs:label "interval_level" ;
    skos:definition "Coverage of the interval as a proportion, e.g. 0.95." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:interval_lower a owl:DatatypeProperty ;
    rdfs:label "interval_lower" ;
    skos:definition "Lower bound of the reported interval around quantitative_numeric." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:interval_type a owl:ObjectProperty ;
    rdfs:label "interval_type" ;
    skos:definition "Kind of interval reported." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:interval_upper a owl:DatatypeProperty ;
    rdfs:label "interval_upper" ;
    skos:definition "Upper bound of the reported interval around quantitative_numeric." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:is_sampling_effort_reported a owl:DatatypeProperty ;
    rdfs:label "is_sampling_effort_reported" ;
    skos:closeMatch <http://rs.tdwg.org/eco/terms/isSamplingEffortReported> ;
    skos:definition "Whether the study reported its sampling effort at all. False is informative: it downgrades certainty rather than leaving a silent gap." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:journal a owl:DatatypeProperty ;
    rdfs:label "journal" ;
    skos:definition "Journal or publication venue for the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "Short human-readable name (e.g. \"Percent cover in fixed quadrats\", \"NDVI from Sentinel-2 imagery\")." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:lag_months a owl:DatatypeProperty ;
    rdfs:label "lag_months" ;
    skos:definition "Time lag between the cause and the onset of the effect, in months. E.g., if invasive removal happens in year 0 and native recovery begins in year 2, lag = 24. Null if the effect is immediate or lag is not reported." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:last_refreshed_at a owl:DatatypeProperty ;
    rdfs:label "last_refreshed_at" ;
    skos:definition "Date and time when the aggregate assessment was last refreshed." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    skos:definition "Latitude of the study coordinate centroid in decimal degrees (WGS 84). Positive = North, negative = South. E.g., 43.2642 for southern Ontario." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/decimalLatitude> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    skos:definition "Longitude of the study coordinate centroid in decimal degrees (WGS 84). Positive = East, negative = West. E.g., -81.7567 for southern Ontario." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/decimalLongitude> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:maximum_value a owl:DatatypeProperty ;
    rdfs:label "maximum_value" ;
    skos:definition "Upper bound of a reported range, inclusive." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:measured_attribute a owl:DatatypeProperty ;
    rdfs:label "measured_attribute" ;
    skos:definition "The measurable attribute of the entity that participates in the causal relationship. Corresponds to ELMO's derivative_qualifier slot. Together with entity_term and state_or_change_qualifier, forms the full semantic content: \"state or change qualifier of attribute of entity.\" This is the authoritative ontology grounding for the measured attribute. Use PATO terms for qualities (abundance, density, cover, height), GO terms for process rates, or free text if no ontology term exists." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "PATO:0000070 (abundance), PATO:0000918 (width), PATO:0000574 (density), PATO:0001019 (mass), PATO:0000033 (concentration), PATO:0001708 (1-D extent/cover), GO:0008150 (biological process for rates)" .

causal_mosaic:measurement_relation a owl:ObjectProperty ;
    rdfs:label "measurement_relation" ;
    skos:definition "Whether the option measures the node's attribute directly, measures a proxy for it, or derives it from other quantities." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:minimum_value a owl:DatatypeProperty ;
    rdfs:label "minimum_value" ;
    skos:definition "Lower bound of a reported range or threshold, inclusive." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "Human-readable composed label for the node. Should express the full semantic content: \"Increased wolf population abundance\" or \"Prescribed burning process\" or \"Elevated soil nitrogen.\" This is what appears in Rosetta Statements and graph visualizations." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:nativeness_basis a owl:ObjectProperty ;
    rdfs:label "nativeness_basis" ;
    skos:definition "For nodes whose applied_to names native or non-native species, how nativeness was assigned." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:needs_refresh a owl:DatatypeProperty ;
    rdfs:label "needs_refresh" ;
    skos:definition "True when new relevant article-level CausalEdge records have been added or changed since this assessment was last generated." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:negated a owl:DatatypeProperty ;
    rdfs:label "negated" ;
    skos:definition "True if the source reports that the relationship does NOT hold — a null result. This is the canonical null-result encoding, and it is always paired with causal_language: no_relationship: negated is true if and only if causal_language is no_relationship. Leave the object node as it would be for a positive finding (the tested direction if stated, otherwise no qualifier); never encode a null result by giving the object node the qualifier \"unchanged\"." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:canonical_null_result "Invariant: negated == (causal_language == no_relationship). Declared via equals_expression because LinkML rules cannot yet test a boolean slot; generated JSON Schema and Pydantic do not enforce it, so validating tools (e.g. loom) must check it." .

causal_mosaic:number_of_contradicting_edges a owl:DatatypeProperty ;
    rdfs:label "number_of_contradicting_edges" ;
    skos:definition "Number of included article-level edges contradicting the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_experimental_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_experimental_studies" ;
    skos:definition "Number of included studies using randomized, quasi-, or natural experimental designs." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_mechanistic_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_mechanistic_studies" ;
    skos:definition "Number of included studies providing mechanistic or production evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_observational_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_observational_studies" ;
    skos:definition "Number of included observational studies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_studies a owl:DatatypeProperty ;
    rdfs:label "number_of_studies" ;
    skos:definition "Number of distinct source studies represented in the included edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:number_of_supporting_edges a owl:DatatypeProperty ;
    rdfs:label "number_of_supporting_edges" ;
    skos:definition "Number of included article-level edges supporting the relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:numeric_value a owl:DatatypeProperty ;
    rdfs:label "numeric_value" ;
    skos:definition "A single reported value." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:observable_property a owl:DatatypeProperty ;
    rdfs:label "observable_property" ;
    skos:closeMatch sosa:observedProperty ;
    skos:definition "What the option actually measures, as a CURIE (preferred) or free text. Required for proxy and derived options; for direct options it may be left empty, meaning the node's own measured_attribute. Prefer I-ADOPT variables, NVS P01 parameters, ECSO measurement types or EnvThes terms." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:observation_grain a owl:DatatypeProperty ;
    rdfs:label "observation_grain" ;
    skos:definition "The temporal grain at which the effect was measured. E.g., \"daily\", \"monthly\", \"seasonal\", \"annual\", \"decadal.\" Affects interpretability — a relationship detected at annual grain may not hold at daily grain." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "daily, weekly, monthly, seasonal, annual, decadal, centennial" .

causal_mosaic:ontology_framework a owl:DatatypeProperty ;
    rdfs:label "ontology_framework" ;
    skos:definition "Ontology and causal annotation frameworks used by this graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ontology_snapshot_id a owl:DatatypeProperty ;
    rdfs:label "ontology_snapshot_id" ;
    skos:definition "Identifier for the ontology term snapshot pinned to this graph at export time, enabling reproducible term lookups." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:option_description a owl:DatatypeProperty ;
    rdfs:label "option_description" ;
    skos:definition "Fuller explanation of the option: what is recorded, typical deployment, and known limitations." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:original_sentence a owl:DatatypeProperty ;
    rdfs:label "original_sentence" ;
    skos:definition "The full original sentence(s) from which this edge was extracted. Preserved for RAG retrieval and rendering validation." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:paragraph_id a owl:DatatypeProperty ;
    rdfs:label "paragraph_id" ;
    skos:definition "Paragraph identifier." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:pathway_description a owl:DatatypeProperty ;
    rdfs:label "pathway_description" ;
    skos:definition "Free-text description of the mediating pathway." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:pmid a owl:DatatypeProperty ;
    rdfs:label "pmid" ;
    skos:definition "PubMed identifier for the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:project a owl:DatatypeProperty ;
    rdfs:label "project" ;
    skos:definition "Project name (e.g., 'EcoWeaver', 'Grassland Systematic Map')." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:protocol a owl:DatatypeProperty ;
    rdfs:label "protocol" ;
    skos:closeMatch sosa:usedProcedure ;
    skos:definition "A standard method this option follows, as a DOI, URL or CURIE, or free text naming it (e.g. a GEO BON protocol, an LTER method, a protocols.io entry)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    skos:definition "Provenance metadata for the graph." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:qualitative_descriptor a owl:ObjectProperty ;
    rdfs:label "qualitative_descriptor" ;
    skos:definition "Qualitative descriptor of the causal relationship strength." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:quantitative_numeric a owl:DatatypeProperty ;
    rdfs:label "quantitative_numeric" ;
    skos:definition "Numeric value extracted for computation (e.g., FCM weight derivation). Use the primary effect size; give its metric in effect_metric." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:quantitative_value a owl:DatatypeProperty ;
    rdfs:label "quantitative_value" ;
    skos:definition "Effect size as reported: 'RR = 2.0', 'd = 0.8', '60% reduction'." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:rank a owl:DatatypeProperty ;
    rdfs:label "rank" ;
    skos:definition "The member's position in an ordering the source states explicitly, 1 for the first named, e.g. \"detected most frequently, followed by coyotes and lynx\". Independent of list order." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:refresh_reason a owl:DatatypeProperty ;
    rdfs:label "refresh_reason" ;
    skos:definition "Reason the assessment needs to be refreshed, if applicable." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:russo_williamson_rationale a owl:DatatypeProperty ;
    rdfs:label "russo_williamson_rationale" ;
    skos:definition "Rationale for the aggregate Russo-Williamson assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:russo_williamson_satisfied a owl:ObjectProperty ;
    rdfs:label "russo_williamson_satisfied" ;
    skos:definition "Aggregate assessment of whether the evidence base satisfies the Russo-Williamson requirement for both difference-making and production evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sample_size_unit a owl:DatatypeProperty ;
    rdfs:label "sample_size_unit" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/sampleSizeUnit>,
        <http://rs.tdwg.org/eco/terms/samplingEffortUnit> ;
    skos:definition "The unit associated with sample_size_value. Recommended best practice is a controlled vocabulary." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "plots, sites, trapDays, personHours, years, individuals" .

causal_mosaic:sample_size_value a owl:DatatypeProperty ;
    rdfs:label "sample_size_value" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/sampleSizeValue>,
        <http://rs.tdwg.org/eco/terms/samplingEffortValue> ;
    skos:definition "The numeric value of the sample size or sampling effort reported by the study. Must have a corresponding sample_size_unit." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sampling_effort_protocol a owl:DatatypeProperty ;
    rdfs:label "sampling_effort_protocol" ;
    skos:closeMatch <http://rs.tdwg.org/eco/terms/samplingEffortProtocol> ;
    skos:definition "A description of, or reference to, the methods used to determine the reported sampling effort. Distinct from the survey method itself." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    skos:definition "Which kinds of node the option can apply to. Used to narrow the candidates when matching options to nodes, and to document intent." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:section a owl:ObjectProperty ;
    rdfs:label "section" ;
    skos:definition "The section of the source document this span was drawn from. Claims from discussion and conclusion sections are typically more speculative than those from results." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sensor_or_instrument a owl:DatatypeProperty ;
    rdfs:label "sensor_or_instrument" ;
    skos:closeMatch sosa:madeBySensor ;
    skos:definition "The instrument or device class used, as a CURIE (preferred) or free text. Prefer NVS L05 device categories or L22 instrument terms. Leave empty for methods with no instrument (e.g. expert_elicitation)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:sentence_id a owl:DatatypeProperty ;
    rdfs:label "sentence_id" ;
    skos:definition "Sentence identifier." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:share a owl:ObjectProperty ;
    rdfs:label "share" ;
    skos:definition "How much of the whole this member accounts for, in the units named by CompositionAnnotation.basis. Use the QuantityValue range fields for a reported range, e.g. \"2-6% relative abundance\" is minimum_value 2 and maximum_value 6." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:source_corpus a owl:DatatypeProperty ;
    rdfs:label "source_corpus" ;
    skos:definition "Description of the annotated corpus or literature set." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:spatial_grain a owl:ObjectProperty ;
    rdfs:label "spatial_grain" ;
    skos:definition "For environmental_variable nodes, the area of the sampling unit the measurement was made on, e.g. 1 m2 quadrats. Matters most for area-dependent attributes such as species richness. Not part of variable_key." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:start_char a owl:DatatypeProperty ;
    rdfs:label "start_char" ;
    skos:definition "Character offset start in source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "hidden" .

causal_mosaic:state_or_change_qualifier a owl:ObjectProperty ;
    rdfs:label "state_or_change_qualifier" ;
    skos:definition "Qualifier indicating the state or change in the attribute, including cases where the attribute is present, absent, or unchanged. \"unchanged\" describes a reported stable state, not a null result; null results are encoded on the edge (see CausalEdge.negated). Corresponds to ELMO's direction_qualifier slot. Combined with entity_term and measured_attribute to produce the node's full meaning: e.g., entity=Canis lupus, attribute=abundance, qualifier=increased gives \"increased abundance of Canis lupus.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_country a owl:DatatypeProperty ;
    rdfs:label "study_country" ;
    skos:definition "Country or countries where the study was conducted. Use country names or ISO 3166-1 alpha-2 codes where practical. If multiple countries are reported, separate them with semicolons." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/country> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_design a owl:ObjectProperty ;
    rdfs:label "study_design" ;
    skos:definition "Study design classification for EGM quality assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_duration_months a owl:DatatypeProperty ;
    rdfs:label "study_duration_months" ;
    skos:definition "Duration of the study in months. Computed from start/end if both are provided, or entered directly if the paper reports duration without specific dates. Useful for filtering: \"show me only studies with at least 24 months of monitoring.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "calculated" .

causal_mosaic:study_period_end a owl:DatatypeProperty ;
    rdfs:label "study_period_end" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/eventDate> ;
    skos:definition "End date of data collection. Same format as study_period_start." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:format "ISO 8601 (YYYY, YYYY-MM, or YYYY-MM-DD)" .

causal_mosaic:study_period_start a owl:DatatypeProperty ;
    rdfs:label "study_period_start" ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/eventDate> ;
    skos:definition "Start date of data collection. Not the publication date — when the fieldwork or measurements actually began. ISO 8601 format. Can be year-only (2015), year-month (2015-06), or full date (2015-06-15). For paleontological or historical ecology studies, use negative years or descriptive text in study_temporal_note." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:examples "2015, 2015-06, 2015-06-15" ;
    warp:format "ISO 8601 (YYYY, YYYY-MM, or YYYY-MM-DD)" .

causal_mosaic:study_state_or_province a owl:DatatypeProperty ;
    rdfs:label "study_state_or_province" ;
    skos:definition "State, province, territory, or comparable administrative region where the study was conducted. If multiple regions are reported, separate them with semicolons." ;
    skos:exactMatch <http://rs.tdwg.org/dwc/terms/stateProvince> ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_temporal_note a owl:DatatypeProperty ;
    rdfs:label "study_temporal_note" ;
    skos:definition "Free-text note for temporal context that doesn't fit structured fields. E.g., \"data collected over three growing seasons\", \"historical records from 1850-1950\", \"pollen core spanning 6,700 years.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:temporal_extent a owl:ObjectProperty ;
    rdfs:label "temporal_extent" ;
    skos:definition "The temporal window over which this causal effect was observed. Distinct from the study period in source_document (when fieldwork was done): this captures the timescale of the causal relationship itself. E.g., \"native recovery occurred within three growing seasons of invasive removal.\" Enables filtering by effect duration and analysis of whether effect sizes vary with observation window." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:temporal_scope a owl:DatatypeProperty ;
    rdfs:label "temporal_scope" ;
    skos:definition "Temporal scope of the claim." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    skos:definition "Verbatim text." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:time_since_intervention_text a owl:DatatypeProperty ;
    rdfs:label "time_since_intervention_text" ;
    skos:definition "The measurement epoch as the source states it, e.g. \"in year 2\", \"by the second growing season\", \"results at year 3 of the experiment\". Use alongside time_since_intervention_months, and alone where the source is too vague to convert." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:total_share a owl:ObjectProperty ;
    rdfs:label "total_share" ;
    skos:definition "The share of the whole that the listed members jointly account for, where the source states it, e.g. \"comprised more than 87% of the cladoceran assemblage\" is minimum_value 87. Records that the list is partial without forcing an invented remainder." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:typical_spatial_resolution_m a owl:DatatypeProperty ;
    rdfs:label "typical_spatial_resolution_m" ;
    skos:definition "Typical spatial grain in metres (pixel size, plot or quadrat side, or sensor footprint)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:typical_temporal_resolution a owl:DatatypeProperty ;
    rdfs:label "typical_temporal_resolution" ;
    skos:definition "Typical interval between successive values, as an ISO 8601 duration (e.g. PT15M, P1D, P1Y)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:unit_text a owl:DatatypeProperty ;
    rdfs:label "unit_text" ;
    skos:definition "The unit as the source words it, for use only when no QUDT or UO term exists for it, e.g. \"ramets/m2\" or \"deer/km2\". unit stays an identifier; this slot makes the fallback explicit so a consumer can tell a resolvable unit from a free-text one. Do not fill it when unit is set. Differs from verbatim, which is the whole quantity (value and unit), not the unit alone." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:value_type a owl:ObjectProperty ;
    rdfs:label "value_type" ;
    skos:definition "The kind of value the option produces." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:variable_key a owl:DatatypeProperty ;
    rdfs:label "variable_key" ;
    skos:definition "A calculated key for the causal node to assist  in BBN variable grouping." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "calculated" ;
    warp:note "Composed of entity_term plus measured_attribute plus applied_to" .

causal_mosaic:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    skos:definition "Publication year." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

warp:AccountFamilyEnum a owl:Class ;
    rdfs:label "AccountFamilyEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( camo:DifferenceMakingAccount camo:ProductionAccount camo:ComplementaryAccount ) ] ;
    skos:definition "The high-level family grouping from Illari and Russo's primary distinction (via Ned Hall 2004): difference-making asks WHETHER C makes a difference to E; production asks HOW C brings about E." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values camo:ComplementaryAccount,
        camo:DifferenceMakingAccount,
        camo:ProductionAccount .

warp:AreaSourceEnum a owl:Class ;
    rdfs:label "AreaSourceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AreaSourceEnum#reported> <https://w3id.org/ecoweaver/warp/AreaSourceEnum#computed> ) ] ;
    skos:definition "Whether a site's area was reported by the source or computed from its geometry." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AreaSourceEnum#computed>,
        <https://w3id.org/ecoweaver/warp/AreaSourceEnum#reported> .

warp:CausalProposition a owl:Class ;
    rdfs:label "CausalProposition" ;
    rdfs:subClassOf warp:EcoProposition ;
    skos:definition "A proposition put forward by causal statements." ;
    skos:exactMatch warp:CausalProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CausalStatement a owl:Class ;
    rdfs:label "CausalStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:causal_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:camo_edge_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DoseLevelEnum ;
            owl:onProperty camo:dose_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:camo_edge_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CausalPredicateQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:dose_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:comparator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:causal_language ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ComparatorAnnotation ;
            owl:onProperty warp:comparator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:dose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:dose_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:camo_edge_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:QuantityValue ;
            owl:onProperty camo:dose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:dose ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ClaimStrengthEnum ;
            owl:onProperty warp:causal_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:negated ],
        warp:EcoStatement ;
    skos:definition "A statement that one ecological state, change or process makes a causal (or associational) difference to another. Subject and object are CAMO node shapes; the predicate is a CAMO predicate, refined by the causal features in predicate_qualifiers." ;
    skos:exactMatch warp:CausalStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "causal" ;
    warp:warp_proposition_class "CausalProposition" ;
    warp:warp_propositions_slot "causal_propositions" ;
    warp:warp_statements_slot "causal_statements" .

warp:ContributionEnum a owl:Class ;
    rdfs:label "ContributionEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ContributionEnum#direct> <https://w3id.org/ecoweaver/warp/ContributionEnum#precursor> ) ] ;
    skos:definition "Whether the action acts on the outcome directly or enables later actions that do (recovery strategies rank approaches partly by this)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ContributionEnum#direct>,
        <https://w3id.org/ecoweaver/warp/ContributionEnum#precursor> .

warp:CoordinateLocationBasisEnum a owl:Class ;
    rdfs:label "CoordinateLocationBasisEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#exact_site> <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#nearest_municipality> ) ] ;
    skos:definition "What the study coordinate values represent. Used to distinguish coordinates for the exact study site from approximate coordinates based on the nearest municipality when exact site coordinates are unavailable." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#exact_site>,
        <https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#nearest_municipality> .

warp:CostProposition a owl:Class ;
    rdfs:label "CostProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostIdentityQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoProposition ;
    skos:definition "A proposition put forward by cost statements: this action, this category or comparison, at this scope, place, phase and reporting level. Two costings of initial wattle removal in one region at intervention level share one, with two amounts; a synthesis reports their spread." ;
    skos:exactMatch warp:CostProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CriteriaConceptEnum a owl:Class ;
    rdfs:label "CriteriaConceptEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( concept:degraded_area concept:effective_restoration ) ] ;
    skos:definition "What is being defined. Each value's meaning is its SKOS concept IRI (project/local_terms.ttl, from vocab/local/criteria-concepts.yaml), so a concept exists once; the concepts are skos:Concept and never owl:Class (decision D14)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values concept:degraded_area,
        concept:effective_restoration .

warp:CriteriaProposition a owl:Class ;
    rdfs:label "CriteriaProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaIdentityQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoProposition ;
    skos:definition "A proposition put forward by criteria statements: this site or project, this concept, this criteria set, this period. Two assessors applying the same definition and disagreeing share one, one supporting and one disputing; \"qualifies under A\" and \"does not qualify under B\" are two, and do not contradict." ;
    skos:exactMatch warp:CriteriaProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CriteriaStatement a owl:Class ;
    rdfs:label "CriteriaStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceDirectionEnum ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoStatement ;
    skos:definition "That a site or project meets (or does not meet) a named, versioned definition, for an assessed period. The subject is a particular: a site individual (degradation) or a project individual (effectiveness), so no subject_proposition and no exactly_one_of rule (decision D17; R7 and R18 go away). The verdict is the statement's evidential direction (supports, disputes, neutral) and is required: criteria statements are the one annotated statement that fills it. \"Degraded\" with no definition named is context, not a criteria statement. Annotator's test: is someone applying a named, versioned definition to a site or project?" ;
    skos:exactMatch warp:CriteriaStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "criteria" ;
    warp:warp_identity_extras "predicate_qualifiers.criteria_set predicate_qualifiers.assessed_period" ;
    warp:warp_identity_rule "warp-criteria-identity/1" ;
    warp:warp_proposition_class "CriteriaProposition" ;
    warp:warp_propositions_slot "criteria_propositions" ;
    warp:warp_statements_slot "criteria_statements" .

warp:ExternalId a owl:Class ;
    rdfs:label "ExternalId" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:value ] ;
    skos:definition "An identifier in some registry or agreement scheme." ;
    skos:exactMatch warp:ExternalId ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ImplementationProposition a owl:Class ;
    rdfs:label "ImplementationProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:implemented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ClaimantStatus ;
            owl:onProperty warp:status_by_claimant ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Period ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:area_by_claimant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:funded_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ExternalId ;
            owl:onProperty warp:external_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:replaces ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:replaces ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty IAO:0000136 ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:implemented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:external_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty IAO:0000136 ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:funded_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:status_by_claimant ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ClaimantArea ;
            owl:onProperty warp:area_by_claimant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty IAO:0000136 ],
        warp:EcoProposition ;
    skos:definition "A derived project, as a grouping record: which implementation statements describe the same work (shared external ID, or same strategy, same site and overlapping periods), with each claimant's status and area kept and attributed, the union of implementers and funders, and the envelope of periods. It is about (IAO:0000136) the project individual, proj:<id>, which is the work itself: an occurrent, typed in project/projects.ttl by its strategy class and located at its site (decision D17). The record and the individual share their local ID." ;
    skos:exactMatch warp:ImplementationProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:InteractionProposition a owl:Class ;
    rdfs:label "InteractionProposition" ;
    rdfs:subClassOf warp:EcoProposition ;
    skos:definition "A proposition put forward by biotic interaction statements." ;
    skos:exactMatch warp:InteractionProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:InteractionStatement a owl:Class ;
    rdfs:label "InteractionStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:negated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoStatement ;
    skos:definition "A statement that organisms of one population interact with organisms of another in a particular way: eating, pollinating, parasitizing. Subject and object are population nodes (template population_of_taxon)." ;
    skos:exactMatch warp:InteractionStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "interaction" ;
    warp:warp_proposition_class "InteractionProposition" ;
    warp:warp_propositions_slot "interaction_propositions" ;
    warp:warp_statements_slot "interaction_statements" .

warp:NodeDefinition a owl:Class ;
    rdfs:label "NodeDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:season ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:fillers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:depth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:season ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:QuantityRange ;
            owl:onProperty warp:depth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:depth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:season ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:TemplateFiller ;
            owl:onProperty warp:fillers ] ;
    skos:definition "Says which node template a node fills and with which terms. The CAMO node stays the annotation record; this is its logical definition." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:PropositionStatusEnum a owl:Class ;
    rdfs:label "PropositionStatusEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#asserted> <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#open_question> ) ] ;
    skos:definition "Whether anyone has asserted the proposition yet." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#asserted>,
        <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#open_question> .

warp:QuantityRange a owl:Class ;
    rdfs:label "QuantityRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty warp:min ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:max ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:min ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:min ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:min ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty warp:max ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty warp:max ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:max ] ;
    skos:definition "An interval with a unit. Either end may be absent (one-sided ranges: \"tolerates pH above 5.5\"), but not both. When both are present, min is at most max (checked by scripts/check_values.py)." ;
    skos:exactMatch warp:QuantityRange ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:RecommendationProposition a owl:Class ;
    rdfs:label "RecommendationProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:RecommendationQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoProposition ;
    skos:definition "A proposition put forward by recommendation statements: this guidance, about this action, for this outcome, at this scope. Two agencies giving the same guidance share one; \"do\" and \"avoid\" for the same action and outcome are two, which may cite the same causal proposition: agreement about how the world works, disagreement about what to do." ;
    skos:exactMatch warp:RecommendationProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:RecommendationQualifiers a owl:Class ;
    rdfs:label "RecommendationQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:priority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:timing_of_influence ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ContributionEnum ;
            owl:onProperty warp:contribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:GuidanceEnum ;
            owl:onProperty warp:guidance ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ScaledValue ;
            owl:onProperty warp:timing_of_influence ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ScaledValue ;
            owl:onProperty warp:priority ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:timing_of_influence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:priority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:deontic_force ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DeonticForceEnum ;
            owl:onProperty warp:deontic_force ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:deontic_force ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:guidance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:guidance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:contribution ] ;
    skos:definition "The predicate layer of a recommendation statement. Only guidance is in the identity key; force, priority, timing and contribution vary across the statements of one proposition." ;
    skos:exactMatch warp:RecommendationQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:RecommendationStatement a owl:Class ;
    rdfs:label "RecommendationStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:justified_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoProposition ;
            owl:onProperty warp:justified_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:RecommendationQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoStatement ;
    skos:definition "Guidance: a source tells someone to do, avoid or consider an action because of an outcome. The subject is the action as the source names it (an action node, or a management strategy node), never the recommender: who gave the advice is the claimant (the author contribution), as in every group. The object is the outcome node, a change or target state. The advice is in predicate_qualifiers.guidance. Annotator's test: is the source telling someone what to do, or describing what happens? Describing is a causal statement." ;
    skos:exactMatch warp:RecommendationStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "recommendation" ;
    warp:warp_identity_extras "predicate_qualifiers.guidance" ;
    warp:warp_proposition_class "RecommendationProposition" ;
    warp:warp_propositions_slot "recommendation_propositions" ;
    warp:warp_statements_slot "recommendation_statements" .

warp:SynthesisAssessment a owl:Class ;
    rdfs:label "SynthesisAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceDirectionEnum ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CertaintyGradeEnum ;
            owl:onProperty warp:strength ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:evidence_balance ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceBalanceEnum ;
            owl:onProperty warp:evidence_balance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty warp:proposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:strength ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:strength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:evidence_balance ],
        warp:EcoStatement ;
    skos:definition "A statement in SEPIO Proposition Assessment Mode, about the state of the evidence for a proposition across many statements. Usually made by a synthesis pipeline or review team. Replaces CAMO EvidenceBaseAssessmentEdge." ;
    skos:exactMatch warp:SynthesisAssessment ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ToleranceProposition a owl:Class ;
    rdfs:label "ToleranceProposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:place ],
        warp:EcoProposition ;
    skos:definition "A proposition put forward by tolerance statements: this organism, this predicate, this variable, at this scope, in this place." ;
    skos:exactMatch warp:ToleranceProposition ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ToleranceStatement a owl:Class ;
    rdfs:label "ToleranceStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:explained_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoProposition ;
            owl:onProperty warp:explained_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ToleranceQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoStatement ;
    skos:definition "The conditions under which a taxon establishes, persists or performs: the soil pH it tolerates, the moisture regime it prefers, the salinity that excludes it. A disposition of the organism, not a change in one thing bringing a change in another, which is why it is not a causal statement. Subject: a taxon, population or life stage node. Object: a quality_of_environmental_material node, or for has_habitat an ENVO habitat or environment node (scripts/check_tolerance.py). The range, optimum, class value and curve are qualifiers, not in the identity key, so every source's range for \"pH of soil\" meets in one proposition. Annotator's test: is the source saying under what conditions the organism can live, or what changes what?" ;
    skos:exactMatch warp:ToleranceStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "tolerance" ;
    warp:warp_identity_extras "place" ;
    warp:warp_proposition_class "ToleranceProposition" ;
    warp:warp_propositions_slot "tolerance_propositions" ;
    warp:warp_statements_slot "tolerance_statements" .

warp:access_level a owl:ObjectProperty ;
    rdfs:label "access_level" ;
    skos:definition "How the statement may be shared and reused." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:adjustment a owl:ObjectProperty ;
    rdfs:label "adjustment" ;
    skos:definition "Whether the source already adjusted the figure." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:adjustment_base_year a owl:DatatypeProperty ;
    rdfs:label "adjustment_base_year" ;
    skos:definition "The base year of that adjustment (missing from the proposal sketch; R5)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:adjustment_rate a owl:DatatypeProperty ;
    rdfs:label "adjustment_rate" ;
    skos:definition "The rate of that adjustment, as a fraction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:agent_kind a owl:ObjectProperty ;
    rdfs:label "agent_kind" ;
    skos:definition "The kind of knowledge the agent brings." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:agent_subtype a owl:DatatypeProperty .

warp:area_source a owl:ObjectProperty ;
    rdfs:label "area_source" ;
    skos:definition "Whether the area was reported or computed." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:area_treated a owl:ObjectProperty ;
    rdfs:label "area_treated" ;
    skos:definition "May be less than the site. Never divide a site's area among strategies." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:assessment_basis a owl:ObjectProperty ;
    rdfs:label "assessment_basis" ;
    skos:definition "For effectiveness: process, trajectory or outcome." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:assessment_method a owl:ObjectProperty ;
    rdfs:label "assessment_method" ;
    skos:definition "field_assessment, remote_sensing, rule_applied, expert_judgement, self_reported." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:assessment_unit a owl:ObjectProperty ;
    rdfs:label "assessment_unit" ;
    skos:definition "What is judged: site, ecosystem unit, jurisdiction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:baseline_date a owl:DatatypeProperty ;
    rdfs:label "baseline_date" ;
    skos:definition "As of when? ISO 8601 year, year-month or date." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:basis a owl:DatatypeProperty ;
    rdfs:label "basis" ;
    skos:definition "What the ratio is per (per_hectare, per_site)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:camo_edge_id a owl:DatatypeProperty ;
    rdfs:label "camo_edge_id" ;
    skos:definition "Identifier of the CAMO CausalEdge this statement was migrated or projected from." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:canonical_node a owl:ObjectProperty ;
    rdfs:label "canonical_node" ;
    skos:definition "DERIVED: the strategy's canonical node, node:strategy-<hash of the key>. Definitions with the same key share it." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:loom_role "calculated" .

warp:causal_direction a owl:ObjectProperty ;
    rdfs:label "causal_direction" ;
    skos:definition "CAMO 'direction' (renamed)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:class_value a owl:ObjectProperty ;
    rdfs:label "class_value" ;
    skos:definition "A value on the source's own scale (Ellenberg R, EIVE, USDA low / medium / high, wetland indicator OBL to UPL), with scale and concept IRIs from vocab/scales.yaml; a practitioner's \"wet\" has a value and no scale." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:code a owl:DatatypeProperty .

warp:community a owl:DatatypeProperty ;
    rdfs:label "community" ;
    skos:definition "Community or nation with authority over the knowledge." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:concept a owl:ObjectProperty ;
    rdfs:label "concept" ;
    skos:definition "IRI of the value inside the scheme. Optional only while a scheme is still unregistered." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_allowed_prefixes "scale TODO" .

warp:consent_reference a owl:DatatypeProperty ;
    rdfs:label "consent_reference" ;
    skos:definition "Pointer to the consent or agreement under which the statement was recorded." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:context a owl:ObjectProperty ;
    rdfs:label "context" ;
    rdfs:range causal_mosaic:ContextAnnotation ;
    skos:definition "Conditions under which the statement is said to hold (scope conditions), as the source gives them. Shared by every predicate group." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:contributing_sole a owl:ObjectProperty ;
    rdfs:label "contributing_sole" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:contribution a owl:ObjectProperty ;
    rdfs:label "contribution" ;
    skos:definition "Direct, or a precursor to actions that act on the outcome." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:contributor a owl:ObjectProperty .

warp:conversion_rate a owl:DatatypeProperty ;
    rdfs:label "conversion_rate" ;
    skos:definition "The exchange rate applied, if the figure was converted (target units per source unit)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:cost_basis a owl:ObjectProperty ;
    rdfs:label "cost_basis" ;
    skos:definition "Actual expenditure, budget allocation, estimate, quote or payment rate." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:cost_bearer a owl:ObjectProperty ;
    rdfs:label "cost_bearer" ;
    skos:definition "Who paid. May not be the claimant." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:cost_behaviour a owl:ObjectProperty ;
    rdfs:label "cost_behaviour" ;
    skos:definition "Fixed, variable or mixed." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:criteria_text a owl:DatatypeProperty ;
    rdfs:label "criteria_text" ;
    skos:definition "The definition, verbatim." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:currency a owl:DatatypeProperty ;
    rdfs:label "currency" ;
    skos:definition "ISO 4217 code, always the original currency." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:date a owl:DatatypeProperty .

warp:dateAuthored a owl:DatatypeProperty .

warp:dateRecordCreated a owl:DatatypeProperty .

warp:deontic_force a owl:ObjectProperty ;
    rdfs:label "deontic_force" ;
    skos:definition "How strongly the guidance binds: required (a legal duty), recommended, suggested, optional." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:depth a owl:ObjectProperty ;
    rdfs:label "depth" ;
    skos:definition "A refinement (templates' `refinements`): the depth interval the node is about, e.g. 0 to 15 cm. Part of what the node is, but with no ontology class, so the node is a subclass of the template's expression rather than equivalent to it. Only for templates that list it (quality_of_environmental_material)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:derived_from_amount a owl:ObjectProperty ;
    rdfs:label "derived_from_amount" ;
    skos:definition "DERIVED by transfer_costs.py: the IRI of the amount this one was computed from, `<source statement>/predicate_qualifiers/amount`." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:determinism a owl:ObjectProperty ;
    rdfs:label "determinism" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:directionOfEvidenceProvided a owl:ObjectProperty .

warp:doi a owl:DatatypeProperty .

warp:ecosystem_context a owl:ObjectProperty ;
    rdfs:label "ecosystem_context" ;
    rdfs:range warp:EcosystemFunctionalGroupEnum ;
    skos:definition "The KIND of ecosystem the statement is about, as one of CAMO's IUCN Global Ecosystem Typology functional groups (warm_temperate_forests, coastal_saltmarshes_and_reedbeds). Not a place: \"Florida\" or \"the Mediterranean coast of Israel\" go in `place` (R19)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effect_on_object a owl:ObjectProperty ;
    rdfs:label "effect_on_object" ;
    skos:definition "Effect of the interaction on the object population." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effect_on_subject a owl:ObjectProperty ;
    rdfs:label "effect_on_subject" ;
    skos:definition "Effect of the interaction on the subject population." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effect_strength a owl:ObjectProperty ;
    rdfs:label "effect_strength" ;
    skos:definition "CAMO 'strength' (renamed)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:effort a owl:ObjectProperty ;
    rdfs:label "effort" ;
    skos:definition "Standard 4: person-days, litres, machine hours. The most transferable part of a costing: labour can be re-priced at local rates." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:end a owl:DatatypeProperty ;
    rdfs:label "end" ;
    skos:definition "ISO 8601 year, year-month or date. Absent if open or ongoing." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:entity a owl:ObjectProperty ;
    rdfs:label "entity" ;
    skos:definition "The kind of thing counted, as a CURIE (a node, an ENVO term, or a TODO: placeholder)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:every a owl:DatatypeProperty ;
    rdfs:label "every" ;
    skos:definition "ISO 8601 duration between repeats (P1Y: yearly)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_balance a owl:ObjectProperty ;
    rdfs:label "evidence_balance" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_object a owl:ObjectProperty ;
    rdfs:label "evidence_object" ;
    skos:definition "Whether the evidence bears on correlation (difference-making), mechanism (production), or both (Russo-Williamson). EcoWeaver extension to SEPIO; candidate for an upstream contribution." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:evidence_type a owl:ObjectProperty ;
    rdfs:label "evidence_type" ;
    skos:definition "Kind of study or reasoning (CAMO's values, ECO parents as broad mappings, plus not_stated). Specializes SEPIO EvidenceLine.subtype, which is left empty. Use CAMO's expert_judgment for expert opinion (decision D2), and not_stated when the source gives no basis at all." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:filler_term a owl:ObjectProperty ;
    rdfs:label "value" ;
    skos:definition "The filling term, as a CURIE." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:geometry a owl:DatatypeProperty ;
    rdfs:label "geometry" ;
    skos:definition "GeoJSON or WKT, or a reference to one. May be generalized or withheld under care. GeoJSON must parse as JSON. Never exported." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:geometry_precision a owl:ObjectProperty ;
    rdfs:label "geometry_precision" ;
    skos:definition "exact, generalized, centroid, or withheld (then no geometry at all)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:guidance a owl:ObjectProperty ;
    rdfs:label "guidance" ;
    skos:definition "Do, avoid or consider. In the identity key." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:human_caused a owl:DatatypeProperty ;
    rdfs:label "human_caused" ;
    skos:definition "Must the decline be caused by people?" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:intensity a owl:DatatypeProperty ;
    rdfs:label "intensity" ;
    skos:definition "Standard 2: how intensively (\"two herbicide passes per year\")." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:issued_by a owl:ObjectProperty ;
    rdfs:label "issued_by" ;
    skos:definition "Whose definition it is." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:jurisdiction a owl:DatatypeProperty ;
    rdfs:label "jurisdiction" ;
    skos:definition "An ISO 3166-2 code (CA-SK) where one exists, exported as an IRI; or text where none does, as for many Indigenous territories, exported as a literal." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:lag a owl:DatatypeProperty ;
    rdfs:label "lag" ;
    skos:definition "Time after the previous step starts, as an ISO 8601 duration (P2W: two weeks). A string, never xsd:duration (decision D19)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:mediation a owl:ObjectProperty ;
    rdfs:label "mediation" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:modality a owl:ObjectProperty ;
    rdfs:label "modality" ;
    rdfs:range warp:ModalityEnum ;
    skos:definition "Whether the statement reports (observed), infers (inferred) or forecasts (anticipated). Different from hedging, which is causal_language: hedging is how sure the speaker sounds, modality is what kind of statement it is. A proposition projects to OWL only when every statement grouped under it is observed (decision D15)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:moderation a owl:ObjectProperty ;
    rdfs:label "moderation" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:name a owl:DatatypeProperty .

warp:necessity a owl:ObjectProperty ;
    rdfs:label "necessity" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:node a owl:ObjectProperty ;
    rdfs:label "node" ;
    skos:definition "The CAMO node being defined." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:operationalizes a owl:ObjectProperty ;
    rdfs:label "operationalizes" ;
    skos:definition "The concept this set defines." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:optimum a owl:ObjectProperty ;
    rdfs:label "optimum" ;
    skos:definition "The optimum value, mostly with prefers." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:optional a owl:DatatypeProperty ;
    rdfs:label "optional" ;
    skos:definition "True for parts marked \"if needed\". Left out of the identity key and out of the OWL, kept in RDF." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:original_text a owl:DatatypeProperty ;
    rdfs:label "original_text" ;
    skos:definition "The statement as worded in its source (verbatim sentence, notebook line, transcript passage). Distinct from statementText, which is the normalized rendering." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:price_year a owl:DatatypeProperty ;
    rdfs:label "price_year" ;
    skos:definition "The year the costs were incurred (an integer, never xsd:gYear)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:priority a owl:ObjectProperty ;
    rdfs:label "priority" ;
    skos:definition "The priority on the source's own scale (DFO High / Medium / Low; ECCC Urgent / Necessary / Beneficial), as a ScaledValue with scale and concept IRIs from vocab/scales.yaml." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:profile_version a owl:DatatypeProperty ;
    rdfs:label "profile_version" ;
    skos:definition "Version of this profile the set conforms to." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:proportionality a owl:ObjectProperty ;
    rdfs:label "proportionality" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:propositionText a owl:DatatypeProperty .

warp:protocols a owl:DatatypeProperty ;
    rdfs:label "protocols" ;
    skos:definition "Community protocols governing use, in the community's words." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:proximate_distal a owl:ObjectProperty ;
    rdfs:label "proximate_distal" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:raised_as_question a owl:DatatypeProperty ;
    rdfs:label "raised_as_question" ;
    skos:definition "True if people created this proposition as an open question before any statement asserted it. Such propositions keep their id and are never deleted by re-derivation; they revert to open_question if their statements are removed." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:range a owl:ObjectProperty ;
    rdfs:label "range" ;
    skos:definition "The range of the variable. Either end may be open." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:recordMetadata a owl:ObjectProperty .

warp:reference_basis a owl:ObjectProperty ;
    rdfs:label "reference_basis" ;
    skos:definition "Degraded compared with what?" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:repeat a owl:ObjectProperty ;
    rdfs:label "repeat" ;
    skos:definition "How the part recurs (yearly mowing for three years)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:response a owl:ObjectProperty ;
    rdfs:label "response" ;
    skos:definition "What the range was judged against: occurrence, germination, establishment, growth, survival, reproduction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:reversibility a owl:ObjectProperty ;
    rdfs:label "reversibility" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:scheme a owl:DatatypeProperty ;
    rdfs:label "scheme" ;
    skos:definition "The registry or numbering scheme (\"agreement\", a program's registry name)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:score a owl:DatatypeProperty .

warp:season a owl:DatatypeProperty ;
    rdfs:label "season" ;
    skos:definition "A refinement: the season the node is about (\"growing season\", \"spring freshet\"). As for depth." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:specificity a owl:ObjectProperty ;
    rdfs:label "specificity" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:stability a owl:ObjectProperty ;
    rdfs:label "stability" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:start a owl:DatatypeProperty ;
    rdfs:label "start" ;
    skos:definition "ISO 8601 year, year-month or date." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:starting_conditions a owl:DatatypeProperty ;
    rdfs:label "starting_conditions" ;
    skos:definition "Initial abundance or cover, as the source gives it." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:stated_goal a owl:DatatypeProperty ;
    rdfs:label "stated_goal" ;
    skos:definition "The aim of the work as the source states it (\"to restore native vegetation\", \"to reduce larval density\"), recorded without judging whether it was met. Shared by every predicate group. Aims belong to the evidence layer: never put them on nodes (what counts as success is contested) or on statements." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:statementText a owl:DatatypeProperty .

warp:step a owl:DatatypeProperty ;
    rdfs:label "step" ;
    skos:definition "Position in the sequence, from 1. Parts that run together share a step." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:strengthOfEvidenceProvided a owl:ObjectProperty .

warp:sufficiency a owl:ObjectProperty ;
    rdfs:label "sufficiency" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:suitability a owl:DatatypeProperty ;
    rdfs:label "suitability" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    skos:definition "The version this one replaces." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:system a owl:DatatypeProperty .

warp:systemVersion a owl:DatatypeProperty .

warp:targetProposition a owl:ObjectProperty .

warp:temporal_extent a owl:ObjectProperty ;
    rdfs:label "temporal_extent" ;
    rdfs:range causal_mosaic:TemporalExtent ;
    skos:definition "The temporal window over which the stated effect or condition was observed (CAMO TemporalExtent). Not a calendar period: dated periods use Period (start and end as ISO 8601 strings)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:temporal_ordering a owl:ObjectProperty ;
    rdfs:label "temporal_ordering" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:tenure a owl:ObjectProperty ;
    rdfs:label "tenure" ;
    skos:definition "public, private, indigenous, mixed or unknown." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:threshold_kind a owl:ObjectProperty ;
    rdfs:label "threshold_kind" ;
    skos:definition "How much change makes it degraded?" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:threshold_text a owl:DatatypeProperty ;
    rdfs:label "threshold_text" ;
    skos:definition "The threshold as written." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:times a owl:DatatypeProperty ;
    rdfs:label "times" ;
    skos:definition "Number of times the part is carried out." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:timing_of_influence a owl:ObjectProperty ;
    rdfs:label "timing_of_influence" ;
    skos:definition "When the action takes effect, on the source's scale (DFO Immediate / Medium / Future)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:title a owl:DatatypeProperty .

warp:transfer_rule a owl:DatatypeProperty ;
    rdfs:label "transfer_rule" ;
    skos:definition "DERIVED: the versioned transfer rule that adjusted it, e.g. warp-cost-transfer/1." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:transferred_from a owl:ObjectProperty ;
    rdfs:label "transferred_from" ;
    skos:definition "DERIVED by scripts/transfer_costs.py: the cost statement this one was adjusted from (to another place, year or currency). Requires transfer_rule." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:until a owl:DatatypeProperty ;
    rdfs:label "until" ;
    skos:definition "When repeats stop, as text, for open-ended repeats (\"until native cover exceeds 50%\")." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:urls a owl:DatatypeProperty .

warp:var a owl:DatatypeProperty ;
    rdfs:label "var" ;
    skos:definition "Template variable name." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:volunteer_effort a owl:ObjectProperty ;
    rdfs:label "volunteer_effort" ;
    skos:definition "Volunteer time: valuable and often uncounted." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://example.org/sepio-model/contributions> a owl:ObjectProperty .

<https://example.org/sepio-model/qualifier> a owl:ObjectProperty .

<https://example.org/sepio-model/urls> a owl:DatatypeProperty .

causal_mosaic:AppliedToEntity a owl:Class ;
    rdfs:label "AppliedToEntity" ;
    rdfs:subClassOf causal_mosaic:EntityReference ;
    skos:definition "A structured entity reference used by the CausalNode.applied_to slot. On composite_variable nodes it identifies a taxon or ecological guild whose measurements are aggregated (scope role). On environmental_process and management_intervention nodes it identifies the directional target of the process or intervention (target role). Uses the same entity_type / entity_term decomposition as CausalNode. Amounts (share, dominance, rank) do not belong here: they go on CompositionMember, in CausalNode.composition." ;
    skos:exactMatch causal_mosaic:AppliedToEntity ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:CausalEdge a owl:Class ;
    rdfs:label "CausalEdge" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:moderation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:fcm_weight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:temporal_ordering ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:contributing_sole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:original_sentence ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:annotation_notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TemporalExtent ;
            owl:onProperty causal_mosaic:temporal_extent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:annotation_timestamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:moderation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:dose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ReversibilityEnum ;
            owl:onProperty camo:reversibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty camo:stability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:dose_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:causal_language ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:direction ],
        [ a owl:Restriction ;
