warp:agents a owl:ObjectProperty ;
    rdfs:label "agents" ;
    skos:definition "People, organizations, communities and software that make, record or assess statements. Referred to by id from contributions and CARE metadata." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:area_by_claimant a owl:ObjectProperty ;
    rdfs:label "area_by_claimant" ;
    skos:definition "DERIVED: each claimant's area treated." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:assessments a owl:ObjectProperty ;
    rdfs:label "assessments" ;
    skos:definition "Synthesis assessments over propositions." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:attributes_assessed a owl:ObjectProperty ;
    rdfs:label "attributes_assessed" ;
    skos:definition "Which aspects count (SER's six attributes; provisional)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:causal_propositions a owl:ObjectProperty ;
    rdfs:label "causal_propositions" ;
    skos:definition "Causal propositions: derived by scripts/derive_propositions.py, or written by people as open questions." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:causal_statements a owl:ObjectProperty ;
    rdfs:label "causal_statements" ;
    skos:definition "Causal statements as annotated (one per source assertion)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:comparator a owl:ObjectProperty ;
    rdfs:label "comparator" ;
    skos:definition "What the effect was assessed relative to." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:components a owl:ObjectProperty ;
    rdfs:label "components" ;
    skos:definition "The parts, at least two. Parallel parts share a step number." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

concept:degraded_area a owl:NamedIndividual,
        warp:CriteriaConceptEnum ;
    rdfs:label "degraded_area" .

concept:effective_restoration a owl:NamedIndividual,
        warp:CriteriaConceptEnum ;
    rdfs:label "effective_restoration" .

warp:cost_propositions a owl:ObjectProperty ;
    rdfs:label "cost_propositions" ;
    skos:definition "Cost propositions (derived): one per action, predicate, object, scope, place, phase and reporting level." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:cost_statements a owl:ObjectProperty ;
    rdfs:label "cost_statements" ;
    skos:definition "Cost statements: what carrying out an action took." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:count a owl:ObjectProperty ;
    rdfs:label "count" ;
    skos:definition "Standard 3, when the scale is a number of things (46 protected areas): a Count, not a unit." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:covers_roles a owl:ObjectProperty ;
    rdfs:label "covers_roles" ;
    skos:definition "For a phase-level cost of a strategy: which components (by role) the cost covers." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:criteria_propositions a owl:ObjectProperty ;
    rdfs:label "criteria_propositions" ;
    skos:definition "Criteria propositions (derived, warp-criteria-identity/1)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:criteria_sets a owl:ObjectProperty ;
    rdfs:label "criteria_sets" ;
    skos:definition "Versioned definitions (degraded area, effective restoration): information records, not nodes." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:criteria_statements a owl:ObjectProperty ;
    rdfs:label "criteria_statements" ;
    skos:definition "Criteria statements: that a site or project meets a criteria set, with a verdict." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:dataItems a owl:ObjectProperty .

warp:derived_from_statements a owl:ObjectProperty ;
    rdfs:label "derived_from_statements" ;
    skos:definition "Statements grouped under this proposition." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:documents a owl:ObjectProperty ;
    rdfs:label "documents" ;
    skos:definition "Sources referenced by statements and evidence lines." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ecosystem_type a owl:ObjectProperty ;
    rdfs:label "ecosystem_type" ;
    skos:definition "ENVO environmental system classes; mixed sites are common. Exported as rdf:type: the site is an instance of each." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_allowed_prefixes "ENVO TODO" .

warp:evidence_item_refs a owl:ObjectProperty ;
    rdfs:label "evidence_item_refs" ;
    skos:definition "Evidence items referenced by identifier: other statements, study results, documents, dataset records. Use instead of SEPIO's hasEvidenceItems, which inlines whole objects. Each must resolve to an id in the files checked together (scripts/check_statements.py)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:explained_by a owl:ObjectProperty ;
    rdfs:label "explained_by" ;
    rdfs:range warp:EcoProposition ;
    skos:definition "Propositions giving the mechanism behind a tolerance, usually causal (saturated soils cause root anoxia, so the species is intolerant of saturation). By reference." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:fillers a owl:ObjectProperty ;
    rdfs:label "fillers" ;
    skos:definition "One filler per template variable. Required for class_expression templates (checked by scripts/expand_nodes.py); strategies and sites have no variables." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:hasEvidenceLines a owl:ObjectProperty .

warp:implementation_propositions a owl:ObjectProperty ;
    rdfs:label "implementation_propositions" ;
    skos:definition "Derived projects (grouping records) by scripts/derive_projects.py (warp-impl-identity/1). Each is about a project individual, proj:<id>." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:implementation_statements a owl:ObjectProperty ;
    rdfs:label "implementation_statements" ;
    skos:definition "Implementation statements: that a strategy or action was carried out at a site." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:includes_categories a owl:ObjectProperty ;
    rdfs:label "includes_categories" ;
    skos:definition "Standard 4: which categories a total includes. Required for totals (check_cost.py); unknown is valid and common." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:interaction_propositions a owl:ObjectProperty ;
    rdfs:label "interaction_propositions" ;
    skos:definition "Biotic interaction propositions (derived or open questions)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:interaction_statements a owl:ObjectProperty ;
    rdfs:label "interaction_statements" ;
    skos:definition "Biotic interaction statements as annotated." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:justified_by a owl:ObjectProperty ;
    rdfs:label "justified_by" ;
    rdfs:range warp:EcoProposition ;
    skos:definition "The propositions the guidance cites as its reason, usually causal propositions (\"avoid stocking: stocking decreases abundance\"). Empty when the source gives no reason. A prediction in the guidance is recorded as its own causal statement (modality anticipated) and cited here; it is never derived from the guidance automatically." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:knowledge_holders a owl:ObjectProperty ;
    rdfs:label "knowledge_holders" ;
    skos:definition "People or groups recognised as holding this knowledge, by agent id. Often the statement's author, but not always: knowledge relayed by a community member may be held by an elder or by the community." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:local_contexts_labels a owl:ObjectProperty ;
    rdfs:label "local_contexts_labels" ;
    skos:definition "Local Contexts TK/BC label or notice URIs, where applied." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:node_definitions a owl:ObjectProperty ;
    rdfs:label "node_definitions" ;
    skos:definition "Logical definitions of nodes: which node template each node fills, and with what. Expanded to OWL and DOSDP fill tables by scripts/expand_nodes.py. See docs/node-templates.md." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:nodes a owl:ObjectProperty ;
    rdfs:label "nodes" ;
    skos:definition "CAMO node shapes referred to by statements and propositions." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:outcome_reported a owl:ObjectProperty ;
    rdfs:label "outcome_reported" ;
    skos:definition "Causal statements from the same source about what the spending achieved: the bridge to cost-effectiveness. By reference." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:philosophical_accounts a owl:ObjectProperty ;
    rdfs:label "philosophical_accounts" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:recommendation_propositions a owl:ObjectProperty ;
    rdfs:label "recommendation_propositions" ;
    skos:definition "Recommendation propositions (derived): one per action, outcome, scope and guidance." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:recommendation_statements a owl:ObjectProperty ;
    rdfs:label "recommendation_statements" ;
    skos:definition "Guidance statements: do, avoid or consider an action because of an outcome." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:response_curve a owl:ObjectProperty ;
    rdfs:label "response_curve" ;
    skos:definition "Habitat suitability breakpoints, in order: x strictly increasing (checked by scripts/check_tolerance.py), suitability in [0, 1], x in the unit of `range`. A model's combination rule (geometric mean, minimum) is not a statement: record it on the EcoStudyResult." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:site_definitions a owl:ObjectProperty ;
    rdfs:label "site_definitions" ;
    skos:definition "Sites: particulars, each one piece of ground. Emitted as OWL individuals under site: in project/sites.ttl, never classes; geometry is never exported. Their own list for the same reason as strategies." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:sourceDataSet a owl:ObjectProperty .

warp:source_spans a owl:ObjectProperty ;
    rdfs:label "source_spans" ;
    skos:definition "Text spans grounding the statement in its source document." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:status_by_claimant a owl:ObjectProperty ;
    rdfs:label "status_by_claimant" ;
    skos:definition "DERIVED: each claimant's latest status." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:strategy_definitions a owl:ObjectProperty ;
    rdfs:label "strategy_definitions" ;
    skos:definition "Management strategies: ordered bundles of action nodes. Their own list (not node_definitions) because a NodeDefinition list has no type designator to tell a strategy from a filled template. scripts/derive_strategies.py derives each one's canonical node." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:study_results a owl:ObjectProperty ;
    rdfs:label "study_results" ;
    skos:definition "Summarized study arms or plot groups used as evidence items." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:tolerance_propositions a owl:ObjectProperty ;
    rdfs:label "tolerance_propositions" ;
    skos:definition "Tolerance propositions (derived): one per organism, predicate, variable, scope and place." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:tolerance_statements a owl:ObjectProperty ;
    rdfs:label "tolerance_statements" ;
    skos:definition "Tolerance statements: the conditions under which an organism lives." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:transfer_steps a owl:DatatypeProperty ;
    rdfs:label "transfer_steps" ;
    skos:definition "DERIVED: the steps the transfer applied, in order (\"indexed ILS 2008 to 2026\", \"converted ILS to CAD\", \"labour re-priced from effort\")." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/elmo/cas/ConservationAction> a owl:NamedIndividual,
        warp:EntityTypeEnum ;
    rdfs:label "management_intervention" ;
    skos:definition "A deliberate human action intended to change an ecological outcome. A subtype of environmental_process with an implied human agent. Examples: invasive species removal, prescribed fire, seeding, hydrological restoration." .

