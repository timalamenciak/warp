    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ThresholdKindEnum#any_decline> <https://w3id.org/ecoweaver/warp/ThresholdKindEnum#fraction_of_reference> <https://w3id.org/ecoweaver/warp/ThresholdKindEnum#categorical_state> <https://w3id.org/ecoweaver/warp/ThresholdKindEnum#expert_judgement> ) ] ;
