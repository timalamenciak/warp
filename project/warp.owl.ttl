        <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#not_assessed>,
        <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> .

warp:EvidenceBalanceEnum a owl:Class ;
    rdfs:label "EvidenceBalanceEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#supportive> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#mixed> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#conflicting> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#insufficient> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#no_evidence> <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#not_assessed> ) ;
    skos:definition "Overall balance of evidence across included article-level causal edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#conflicting>,
        <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#insufficient>,
