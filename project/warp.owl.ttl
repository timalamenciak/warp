            owl:onProperty causal_mosaic:section ] ;
    skos:definition "A span of text in the source document, for provenance and RAG." ;
    skos:exactMatch causal_mosaic:TextSpan ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:source_spans a owl:ObjectProperty .

warp:AssessmentBasisEnum a owl:Class ;
    rdfs:label "AssessmentBasisEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#process> <https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#trajectory> <https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#outcome> ) ] ;
    skos:definition "For effectiveness: actions in place (process), moving toward the reference (trajectory), or reached it (outcome)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#outcome>,
        <https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#process>,
        <https://w3id.org/ecoweaver/warp/AssessmentBasisEnum#trajectory> .

warp:AssessmentUnitEnum a owl:Class ;
    rdfs:label "AssessmentUnitEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#site> <https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#ecosystem_unit> <https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#jurisdiction> ) ] ;
    skos:definition "What a criteria set judges: a site, an ecosystem unit, a jurisdiction." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#ecosystem_unit>,
        <https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#jurisdiction>,
        <https://w3id.org/ecoweaver/warp/AssessmentUnitEnum#site> .

warp:ContributingSoleEnum a owl:Class ;
    rdfs:label "ContributingSoleEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#sole_cause> <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#contributing_cause> ) ] ;
    skos:definition "Whether the cause is presented as the sole cause or a contributing cause." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#contributing_cause>,
        <https://w3id.org/ecoweaver/warp/ContributingSoleEnum#sole_cause> .

warp:CostAdjustmentEnum a owl:Class ;
    rdfs:label "CostAdjustmentEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CostAdjustmentEnum#none> <https://w3id.org/ecoweaver/warp/CostAdjustmentEnum#inflation> <https://w3id.org/ecoweaver/warp/CostAdjustmentEnum#discounted> ) ] ;
    skos:definition "Whether the source already standardized the figure." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CostAdjustmentEnum#discounted>,
        <https://w3id.org/ecoweaver/warp/CostAdjustmentEnum#inflation>,
        <https://w3id.org/ecoweaver/warp/CostAdjustmentEnum#none> .

warp:CostBehaviourEnum a owl:Class ;
    rdfs:label "CostBehaviourEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CostBehaviourEnum#fixed> <https://w3id.org/ecoweaver/warp/CostBehaviourEnum#variable> <https://w3id.org/ecoweaver/warp/CostBehaviourEnum#mixed> ) ] ;
    skos:definition "How a cost varies with scale; needed to estimate economies of scale." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CostBehaviourEnum#fixed>,
        <https://w3id.org/ecoweaver/warp/CostBehaviourEnum#mixed>,
        <https://w3id.org/ecoweaver/warp/CostBehaviourEnum#variable> .

warp:CostStatement a owl:Class ;
    rdfs:label "CostStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:transfer_rule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:transfer_steps ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:transfer_rule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:cost_bearer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:starting_conditions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:transferred_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostStatement ;
            owl:onProperty warp:transferred_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:transfer_rule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:transfer_steps ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:outcome_reported ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Period ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:starting_conditions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:cost_bearer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostQualifiers ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:transferred_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:place ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:cost_bearer ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:starting_conditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoStatement ;
            owl:onProperty warp:outcome_reported ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:predicate_qualifiers ],
        warp:EcoStatement ;
    skos:definition "What carrying out an action took (money, staff and volunteer time, equipment and materials) with the context needed to read the number. Subject: an action or strategy node, the same kind of node the recommendation group uses, so a recommendation and the cost of following it meet. Object: a cost category for incurs_cost, an action or strategy node for costs_relative_to (checked by scripts/check_cost.py). A source reporting one total gives one statement with object total; a breakdown gives one statement per category. Annotator's test: is the source saying what an action took, or what it did?" ;
    skos:exactMatch warp:CostStatement ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    warp:warp_group "cost" ;
    warp:warp_identity_extras "place predicate_qualifiers.phase predicate_qualifiers.reporting_level" ;
    warp:warp_proposition_class "CostProposition" ;
    warp:warp_propositions_slot "cost_propositions" ;
    warp:warp_statements_slot "cost_statements" .

warp:CriteriaStatusEnum a owl:Class ;
    rdfs:label "CriteriaStatusEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#draft> <https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#adopted> <https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#superseded> ) ] ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#adopted>,
        <https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#draft>,
        <https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#superseded> .

warp:DirectionStatusEnum a owl:Class ;
    rdfs:label "DirectionStatusEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#asserted> <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#uncertain> <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#bidirectional> ) ] ;
    skos:definition "Whether and how the direction of causation is stated." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#asserted>,
        <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#bidirectional>,
        <https://w3id.org/ecoweaver/warp/DirectionStatusEnum#uncertain> .

warp:EcoCoding a owl:Class ;
    rdfs:label "EcoCoding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:system ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:systemVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:systemVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:systemVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:system ],
        <https://example.org/sepio-model/Coding> ;
    skos:definition "A SEPIO Coding (a code or label from some system) with WARP IRIs for its slots." ;
    skos:exactMatch warp:EcoCoding ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:EcoContribution a owl:Class ;
    rdfs:label "EcoContribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:contributor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:contributor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ] ) ] ) ] ;
            owl:onProperty warp:date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ContributionRoleEnum ;
            owl:onProperty warp:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcoAgent ;
            owl:onProperty warp:contributor ],
        <https://example.org/sepio-model/Contribution> ;
    skos:definition "One agent's part in making a statement, judging an evidence line, or recording either. The role says which." ;
    skos:exactMatch warp:EcoContribution ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:GuidanceEnum a owl:Class ;
    rdfs:label "GuidanceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/GuidanceEnum#do> <https://w3id.org/ecoweaver/warp/GuidanceEnum#avoid> <https://w3id.org/ecoweaver/warp/GuidanceEnum#consider> ) ] ;
    skos:definition "What the guidance says to do with the subject action. In the identity key, so \"do X\" and \"avoid X\" for the same outcome are two propositions. Each value names the sub-property of warp:suggested_to the exporter writes (warp_subproperty), so the relation layer reads correctly without the qualifier." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/GuidanceEnum#avoid>,
        <https://w3id.org/ecoweaver/warp/GuidanceEnum#consider>,
        <https://w3id.org/ecoweaver/warp/GuidanceEnum#do> .

warp:InteractionPredicateEnum a owl:Class ;
    rdfs:label "InteractionPredicateEnum" ;
    skos:definition "Predicates for biotic interaction statements, from the Relation Ontology (IDs and labels checked against OLS 2026-10-10). Annotations follow the CAMO convention so rendering code can treat every group alike." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values RO:0002437,
        RO:0002444,
        RO:0002455,
        RO:0002470 .

warp:MeasurementRelationEnum a owl:Class ;
    rdfs:label "MeasurementRelationEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#direct> <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#proxy> <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#derived> ) ] ;
    skos:definition "How what a parameter option measures relates to the node it supplies. Causal models should allow for measurement error when the relation is proxy or derived." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#derived>,
        <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#direct>,
        <https://w3id.org/ecoweaver/warp/MeasurementRelationEnum#proxy> .

warp:NativenessBasisEnum a owl:Class ;
    rdfs:label "NativenessBasisEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/NativenessBasisEnum#regional_flora_or_fauna> <https://w3id.org/ecoweaver/warp/NativenessBasisEnum#national_checklist> <https://w3id.org/ecoweaver/warp/NativenessBasisEnum#author_judgement> ) ] ;
    skos:definition "How the source decided which taxa counted as native." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/NativenessBasisEnum#author_judgement>,
        <https://w3id.org/ecoweaver/warp/NativenessBasisEnum#national_checklist>,
        <https://w3id.org/ecoweaver/warp/NativenessBasisEnum#regional_flora_or_fauna> .

warp:ScaledValue a owl:Class ;
    rdfs:label "ScaledValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:concept ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:scale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:concept ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:scale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:scale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:concept ] ;
    skos:definition "A value on a source's own ordinal or categorical scale: DFO's High / Medium / Low priority, a USDA tolerance rating, a wetland indicator status. `value` is the source's wording, verbatim. `scale` is the IRI of a SKOS scheme in vocab/scales.yaml (scale:dfo-recovery-priority, never the bare token), and `concept` the IRI of the value inside it, so \"medium\" can be compared with \"high\" without a script knowing the order (decision D18). A practitioner's \"wet\" is on no scale: it has a value and nothing else." ;
    skos:exactMatch warp:ScaledValue ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:TolerancePredicateEnum a owl:Class ;
    rdfs:label "TolerancePredicateEnum" ;
    skos:definition "Predicates for tolerance statements: under what conditions an organism establishes, persists or performs. Three minted in warp: (declared in src/warp/owl/warp-relations.ttl), one reused from RO. The object's kind varies by predicate (checked by scripts/check_tolerance.py, R17)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values RO:0002303,
        warp:intolerant_of,
        warp:prefers,
        warp:tolerates .

warp:amount a owl:ObjectProperty ;
    rdfs:label "amount" ;
    skos:definition "Standard 4/5: the money, in its original currency and price year." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:external_ids a owl:ObjectProperty .

warp:funded_by a owl:ObjectProperty .

warp:implemented_by a owl:ObjectProperty .

warp:max a owl:DatatypeProperty ;
    rdfs:label "max" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:min a owl:DatatypeProperty ;
    rdfs:label "min" ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:ratio a owl:ObjectProperty ;
    rdfs:label "ratio" ;
    skos:definition "For costs_relative_to: the multiple, and what it is per." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:replaces a owl:ObjectProperty .

warp:reportedIn a owl:ObjectProperty .

<http://purl.obolibrary.org/obo/NCIT_C94731> a owl:NamedIndividual,
        warp:SeasonEnum ;
    rdfs:label "spring" ;
    skos:definition "Spring, without further subdivision." ;
    warp:preferred_label "Spring" .

<https://example.org/sepio-model/DataItem> a owl:Class ;
    rdfs:label "DataItem" ;
    dcterms:title "Data Item" ;
    ns1:status "Informative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/unit> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/confidenceInterval> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/confidenceInterval> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/variabilityMeasures> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/confidenceInterval> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/componentDataItem> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/componentDataItem> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/variabilityMeasures> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/unit> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/unit> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "An Information Entity representing an individual piece of data, generated or acquired through methods which reliably produce truthful information about something." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Examples include raw observations or measurements such as an allele count, or patient's weight, derived calculations such as frequency or mean, and computed statistical scores/metrics such as p-values and z-scores." .

warp:AccessLevelEnum a owl:Class ;
    rdfs:label "AccessLevelEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AccessLevelEnum#open> <https://w3id.org/ecoweaver/warp/AccessLevelEnum#attribution_required> <https://w3id.org/ecoweaver/warp/AccessLevelEnum#community_restricted> <https://w3id.org/ecoweaver/warp/AccessLevelEnum#restricted> ) ] ;
    skos:definition "How a statement and its content may be shared and reused." ;
