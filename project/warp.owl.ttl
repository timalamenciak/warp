warp:AssessmentMethodEnum a owl:Class ;
    rdfs:label "AssessmentMethodEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#field_assessment> <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#remote_sensing> <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#rule_applied> <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#expert_judgement> <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#self_reported> ) ] ;
    skos:definition "How a verdict was reached. rule_applied: EcoWeaver applying a criteria set to data (a SHACL or SPARQL rule); such a verdict enters as a claim by EcoWeaver like any other, never as an axiom." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#expert_judgement>,
        <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#field_assessment>,
        <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#remote_sensing>,
        <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#rule_applied>,
        <https://w3id.org/ecoweaver/warp/AssessmentMethodEnum#self_reported> .

warp:ClaimStrengthEnum a owl:Class ;
    rdfs:label "ClaimStrengthEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#no_relationship> <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#associational> <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#uncertain_causal> <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#direct_causal> ) ] ;
    skos:definition "Four-level causal language strength scale, adapted from Yu et al. (2019). Captures the epistemic commitment of the text, not the actual strength of evidence." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#associational>,
        <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#direct_causal>,
        <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#no_relationship>,
        <https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#uncertain_causal> .

warp:CostBasisEnum a owl:Class ;
    rdfs:label "CostBasisEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CostBasisEnum#actual_expenditure> <https://w3id.org/ecoweaver/warp/CostBasisEnum#budget_allocation> <https://w3id.org/ecoweaver/warp/CostBasisEnum#estimate> <https://w3id.org/ecoweaver/warp/CostBasisEnum#quote> <https://w3id.org/ecoweaver/warp/CostBasisEnum#payment_rate> ) ] ;
    skos:definition "What kind of figure it is; plays the role evidence type plays elsewhere. A payment_rate is what a program pays, not necessarily what the work cost: check cost_bearer." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CostBasisEnum#actual_expenditure>,
        <https://w3id.org/ecoweaver/warp/CostBasisEnum#budget_allocation>,
        <https://w3id.org/ecoweaver/warp/CostBasisEnum#estimate>,
        <https://w3id.org/ecoweaver/warp/CostBasisEnum#payment_rate>,
        <https://w3id.org/ecoweaver/warp/CostBasisEnum#quote> .

warp:CostCategoryEnum a owl:Class ;
    rdfs:label "CostCategoryEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/CostCategoryEnum#total> <https://w3id.org/ecoweaver/warp/CostCategoryEnum#labour> <https://w3id.org/ecoweaver/warp/CostCategoryEnum#capital_equipment> <https://w3id.org/ecoweaver/warp/CostCategoryEnum#consumables> <https://w3id.org/ecoweaver/warp/CostCategoryEnum#overhead> ) ] ;
    skos:definition "What a cost covers. The object of incurs_cost, and the values of includes_categories. Not IRIs of their own in the relation layer: each category names the sub-property of warp:incurs_cost the exporter writes (warp_subproperty). `unknown` is a sentinel: valid in includes_categories (common for program budgets), never an object, never exported." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/CostCategoryEnum#capital_equipment>,
        <https://w3id.org/ecoweaver/warp/CostCategoryEnum#consumables>,
        <https://w3id.org/ecoweaver/warp/CostCategoryEnum#labour>,
        <https://w3id.org/ecoweaver/warp/CostCategoryEnum#overhead>,
        <https://w3id.org/ecoweaver/warp/CostCategoryEnum#total> .

warp:DeterminismEnum a owl:Class ;
    rdfs:label "DeterminismEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DeterminismEnum#deterministic_process> <https://w3id.org/ecoweaver/warp/DeterminismEnum#indeterministic_process> <https://w3id.org/ecoweaver/warp/DeterminismEnum#epistemic_probability_only> <https://w3id.org/ecoweaver/warp/DeterminismEnum#ambiguous> ) ] ;
    skos:definition "Whether the causal relationship frames the underlying process as deterministic or indeterministic, or uses probability only to express epistemic uncertainty." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DeterminismEnum#ambiguous>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#deterministic_process>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#epistemic_probability_only>,
        <https://w3id.org/ecoweaver/warp/DeterminismEnum#indeterministic_process> .

warp:DirectionEvidenceEnum a owl:Class ;
    rdfs:label "DirectionEvidenceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#experimental> <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#temporal_precedence> <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#theoretical> <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#natural_experiment> <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#structural_model> ) ] ;
    skos:definition "How direction of causation is established." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#experimental>,
        <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#natural_experiment>,
        <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#structural_model>,
        <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#temporal_precedence>,
        <https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#theoretical> .

warp:DominanceEnum a owl:Class ;
    rdfs:label "DominanceEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DominanceEnum#dominant> <https://w3id.org/ecoweaver/warp/DominanceEnum#codominant> <https://w3id.org/ecoweaver/warp/DominanceEnum#subdominant> <https://w3id.org/ecoweaver/warp/DominanceEnum#minor> <https://w3id.org/ecoweaver/warp/DominanceEnum#rare> ) ] ;
    skos:definition "A member's standing in the assemblage where the source ranks members without giving a number, e.g. \"dominated by Elymus trachycaulus\". Ordinal only: do not infer a share from it." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DominanceEnum#codominant>,
        <https://w3id.org/ecoweaver/warp/DominanceEnum#dominant>,
        <https://w3id.org/ecoweaver/warp/DominanceEnum#minor>,
        <https://w3id.org/ecoweaver/warp/DominanceEnum#rare>,
        <https://w3id.org/ecoweaver/warp/DominanceEnum#subdominant> .

warp:DoseResponseShapeEnum a owl:Class ;
    rdfs:label "DoseResponseShapeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#monotonic> <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#threshold> <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#saturating> <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#unimodal> <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#none> ) ] ;
    skos:definition "The shape of a reported dose-response relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#monotonic>,
        <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#none>,
        <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#saturating>,
        <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#threshold>,
        <https://w3id.org/ecoweaver/warp/DoseResponseShapeEnum#unimodal> .

warp:InteractionTypeEnum a owl:Class ;
    rdfs:label "InteractionTypeEnum" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#synergistic> <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#antagonistic> <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#qualitative> <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#quantitative> <https://w3id.org/ecoweaver/warp/InteractionTypeEnum#not_specified> ) ] ;
    skos:definition "The kind of interaction or effect modification described." ;
