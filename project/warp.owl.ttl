causal_mosaic:StudyCoordinates a owl:Class ;
    rdfs:label "StudyCoordinates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -1.8e+02 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1.8e+02 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:longitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:latitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_south ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:coordinate_location_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -9e+01 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 9e+01 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:latitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_south ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_east ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:coordinate_uncertainty_m ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:latitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_west ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:coordinate_uncertainty_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_north ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:bbox_west ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:elevation_m ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_east ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:elevation_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:geodetic_datum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:geodetic_datum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_south ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:longitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:geodetic_datum ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CoordinateLocationBasisEnum ;
            owl:onProperty causal_mosaic:coordinate_location_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_east ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_north ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:bbox_north ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:elevation_m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:bbox_west ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:coordinate_uncertainty_m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:longitude ] ;
    skos:definition "Structured coordinate representation for a study location. At minimum, provide latitude and longitude as a centroid when coordinates are reported. Optionally provide a bounding box for larger study areas and elevation. Coordinates should be in WGS 84 (EPSG:4326), which is what GPS devices and most ecology papers report." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

warp:CareMetadata a owl:Class ;
