warp:CostIdentityQualifiers a owl:Class ;
    rdfs:label "CostIdentityQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:reporting_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostPhaseEnum ;
            owl:onProperty warp:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ReportingLevelEnum ;
            owl:onProperty warp:reporting_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:reporting_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:phase ] ;
    skos:definition "The qualifiers a cost proposition was grouped by (its identity extras): phase and reporting level. Amounts, efforts and scales stay on the statements, where they vary." ;
    skos:exactMatch warp:CostIdentityQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/ecoweaver/warp/CostPhaseEnum#follow_up> a owl:NamedIndividual,
        warp:CostPhaseEnum ;
    rdfs:label "follow_up" .

<https://w3id.org/ecoweaver/warp/CostPhaseEnum#initial> a owl:NamedIndividual,
        warp:CostPhaseEnum ;
    rdfs:label "initial" .

