        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#model_output>,
        <https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#remote_sensing> .

<https://example.org/sepio-model/Coding> a owl:Class ;
    rdfs:label "Coding" ;
    dcterms:title "Coding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/system> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/systemVersion> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/system> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/system> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/code> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/code> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/code> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "A structured representation of a code for a defined concept in a terminology or code system." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Coding supports use of terms form ontologies/terminologies in structured object that reports id, label, and metadata about system it came from.  follows FHIR approach.  Used in model when implementers are free to create own value sets of terms which get reported within coding objects in SEPIO data. Validation requires additional tooling - as constraints are not defined in schema itself.",
        "Either a code, label, or both must be provided." .

warp:StateOrChangeQualifierEnum a owl:Class ;
    rdfs:label "StateOrChangeQualifierEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#increased> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#decreased> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#present> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#absent> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#introduced> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#removed> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#unchanged> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#occurred> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#initiated> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#terminated> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#ongoing> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#interrupted> <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#aborted> ) ;
    skos:definition "Qualifier indicating the state or change in the variable's attribute. Corresponds to ELMO's direction_qualifier slot. Together with measured_attribute and the entity ontology term, forms the full semantic content of a node: \"state or change qualifier of attribute of entity.\"" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#aborted>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#absent>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#decreased>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#increased>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#initiated>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#interrupted>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#introduced>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#occurred>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#ongoing>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#present>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#removed>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#terminated>,
        <https://w3id.org/ecoweaver/warp/StateOrChangeQualifierEnum#unchanged> .

warp:CausalPredicateEnum a owl:Class ;
    rdfs:label "CausalPredicateEnum" ;
    owl:unionOf ( camo:causes camo:contributes_to camo:associated_with camo:prevents camo:enables camo:disrupts camo:regulates camo:mediates camo:moderates <https://w3id.org/biolink/vocab/precedes> camo:correlated_with ) ;
    skos:definition """Controlled predicate vocabulary for causal edges, grounded primarily in CAMO and cross-linked to Biolink / RO where possible. Each predicate carries a sign and transitivity property for FCM rendering.
FCM sign composition. The predicate's sign annotation and the nodes' fcm_sign annotations (StateOrChangeQualifierEnum) combine by one of two conventions, chosen once per rendering and never mixed:
(1) State level: FCM concepts are CAMO nodes as annotated ("decreased X" and "increased X" are different concepts). Edge sign = predicate sign. Node qualifiers are not applied; they are already part of each concept's identity. CausalEdge.fcm_weight is stored at this level.
(2) Variable level: nodes are first collapsed to variables (entity + measured_attribute, qualifier dropped). Edge sign = subject fcm_sign x predicate sign x object fcm_sign, with positive = +1 and negative = -1. A node with no qualifier counts as +1, as do the process_phase values occurred and ongoing (fcm_sign neutral), since the node is the variable's reference state. An edge with an unchanged node on either end has no variable-level sign and is left out.
Worked examples, variable level: "increased X prevents Y" = (+1)(-1)(+1) = negative; "decreased X causes Y" = (-1)(+1)(+1) = negative (the same finding, same sign); "decreased X causes decreased Y" = (-1)(+1)(-1) = positive; "removed X disrupts increased Y" = (-1)(-1)(+1) = positive. Applying node signs at the state level, or using only the object sign at the variable level, flips edges.
Only predicates whose sign is positive or negative carry an FCM sign. unspecified, variable, pathway, modifier and temporal predicates need an explicit fcm_weight or are left out of the FCM. Negated edges (null results, causal_language: no_relationship) produce no FCM arc.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/precedes>,
        camo:associated_with,
        camo:causes,
        camo:contributes_to,
        camo:correlated_with,
        camo:disrupts,
        camo:enables,
        camo:mediates,
        camo:moderates,
        camo:prevents,
        camo:regulates .

causal_mosaic:CausalNode a owl:Class ;
    rdfs:label "CausalNode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EntityTypeEnum ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:embedding_vector ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:StateOrChangeQualifierEnum ;
            owl:onProperty causal_mosaic:state_or_change_qualifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:embedding_vector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:embedding_vector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:state_or_change_qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:entity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:variable_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ParameterOption ;
            owl:onProperty causal_mosaic:parameter_options ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty causal_mosaic:entity_term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:measured_attribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(orcid:\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]|camo_agent:[A-Za-z0-9._-]+)$" ] ) ] ) ] ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:AppliedToEntity ;
            owl:onProperty causal_mosaic:applied_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:measured_attribute ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:source_spans ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:variable_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:embedding_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TextSpan ;
            owl:onProperty causal_mosaic:source_spans ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:variable_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:parameter_options ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty causal_mosaic:measured_attribute ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:embedding_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:state_or_change_qualifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:embedding_text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:applied_to ] ;
    skos:definition """A node in the labeled property graph representing a causally active ecological entity — specifically, a state or change in state of an environmental variable or process. Merges ELMO's entity structure (Alamenciak et al. 2025) with CAMO's annotation requirements.
Key design principle: causation in ecology is represented between states or changes in state, not between things alone. A taxon does not cause anything by itself; the causally relevant annotation concerns the state or change of an attribute of a taxon. Therefore each node decomposes into:

  entity: what thing (taxon, chemical, abiotic factor, process)
  attribute: what measurable property (abundance, cover, rate)
  qualifier: whether or how it changed (present, increased, etc.)

The human-readable 'name' is the composed form: "Increased abundance of Canis lupus". The structured fields allow decomposed querying: "show me all claims involving Canis lupus" or "all claims about abundance changes" or "all claims where abundance decreased."
This pattern corresponds to ELMO's subject/object value + derivative qualifier + state/change qualifier structure.
For taxon-specific measurements a two-path model applies. Single-taxon measurements use entity_type: taxon, with the Wikidata QID in entity_term and the measured property in measured_attribute — the taxon node is both organism and measurement and participates directly in causal edges. Multi-taxon aggregates and ecological guilds ("native species", "shade-tolerant species") use entity_type: environmental_variable with one or more Wikidata QIDs or free-text guild names in applied_to. Causal edges are never used for taxon-to-measurement links; applied_to is a queryable annotation field only.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:status a owl:ObjectProperty .

warp:EvidenceTypeEnum a owl:Class ;
    rdfs:label "EvidenceTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#randomized_experiment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#natural_experiment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#quasi_experiment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_longitudinal> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_cross_sectional> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#mechanistic_study> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#structural_equation_model> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#meta_analysis> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#systematic_review> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#modeling_simulation> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#expert_judgment> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#case_study> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#theoretical> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#indigenous_knowledge> <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#practitioner_experience> ) ;
    skos:definition """TYPE of evidence per Illari's type/object distinction: what kind of study or reasoning produced the evidence.
ECO grounding: the Evidence and Conclusion Ontology is built around molecular and clinical assays and has no equivalent for any of these study designs, so no value uses meaning (which asserts equivalence). Where ECO has a parent term, it is given as a broad_mapping. Values with no ECO parent (natural_experiment, the observational designs, mechanistic_study, structural_equation_model, case_study, indigenous_knowledge) are left unmapped rather than forced onto an unrelated term. IDs verified against ECO via OLS, 2026-09-24.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    linkml:permissible_values <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#case_study>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#expert_judgment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#indigenous_knowledge>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#mechanistic_study>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#meta_analysis>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#modeling_simulation>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#natural_experiment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_cross_sectional>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#observational_longitudinal>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#practitioner_experience>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#quasi_experiment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#randomized_experiment>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#structural_equation_model>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#systematic_review>,
        <https://w3id.org/ecoweaver/warp/EvidenceTypeEnum#theoretical> .

<https://example.org/sepio-model/subtype> a owl:DatatypeProperty,
