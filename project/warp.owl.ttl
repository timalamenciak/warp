            owl:onProperty warp:mediation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:stability ] ;
    skos:definition "The predicate layer of a causal statement: the philosophical account invoked and the causal features of the asserted relation. A simple predicate (camo:prevents) plus these qualifiers, following the Biolink pattern, because an RDF predicate is a single IRI. Fields mirror CAMO CausalEdge Layers 2-3; 'direction' and 'strength' are renamed to avoid colliding with SEPIO's evidential direction and strength." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:InteractionQualifiers a owl:Class ;
    rdfs:label "InteractionQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionEffectEnum ;
            owl:onProperty warp:effect_on_object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:effect_on_object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:effect_on_subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:effect_on_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionEffectEnum ;
            owl:onProperty warp:effect_on_subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:effect_on_subject ] ;
    skos:definition "The predicate layer of an interaction statement: the sign of the effect on each partner (+/- for predation, +/+ for mutualism, and so on)." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:NodeDefinition a owl:Class ;
    rdfs:label "NodeDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:TemplateFiller ;
            owl:onProperty warp:fillers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:fillers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty warp:node ] ;
    skos:definition "Says which node template a node fills and with which terms. The CAMO node stays the annotation record; this is its logical definition." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:TemplateFiller a owl:Class ;
    rdfs:label "TemplateFiller" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:var ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:label ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:var ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:var ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:value ] ;
    skos:definition "The term filling one template variable." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

BFO:0000015 a owl:Class ;
    rdfs:label "environmental_process" ;
    rdfs:subClassOf warp:EntityTypeEnum ;
    skos:definition "A process that changes the state of an ecosystem over time. Examples: prescribed burning, sod translocation, nitrogen deposition, competitive exclusion, trophic cascade. Corresponds to \"flows\" in ecological modeling." .

BFO:0000019 a owl:Class ;
    rdfs:label "environmental_variable" ;
    rdfs:subClassOf warp:EntityTypeEnum ;
    skos:definition "A measurable aspect of ecosystem state at a point in time. Examples: bare soil cover, species abundance, soil pH, canopy height, phylogenetic diversity. Corresponds to \"state variables\" in ecological modeling (Jørgensen and Fath 2011; Palmeri et al. 2013)." .

RO:0002437 a owl:Class ;
    rdfs:label "biotically_interacts_with" ;
    rdfs:subClassOf warp:InteractionPredicateEnum ;
    warp:rosetta_template "{subject} interacts with {object}" .

RO:0002444 a owl:Class ;
    rdfs:label "parasite_of" ;
    rdfs:subClassOf warp:InteractionPredicateEnum ;
    warp:rosetta_template "{subject} is a parasite of {object}" .

RO:0002455 a owl:Class ;
    rdfs:label "pollinates" ;
    rdfs:subClassOf warp:InteractionPredicateEnum ;
    warp:rosetta_template "{subject} pollinates {object}" .

RO:0002470 a owl:Class ;
    rdfs:label "eats" ;
    rdfs:subClassOf warp:InteractionPredicateEnum ;
    warp:rosetta_template "{subject} eats {object}" .

<https://example.org/sepio-model/EvidenceLine> a owl:Class ;
    rdfs:label "EvidenceLine" ;
    dcterms:title "Evidence Line" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/strengthOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/targetProposition> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/directionOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/directionOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/directionOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/evidenceItemSources> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/InformationEntity> ;
            owl:onProperty <https://example.org/sepio-model/hasEvidenceItems> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/strengthOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/scoreOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/scoreOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/strengthOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://example.org/sepio-model/scoreOfEvidenceProvided> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/targetProposition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/evidenceItemSources> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/hasEvidenceItems> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/subtype> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Proposition> ;
            owl:onProperty <https://example.org/sepio-model/targetProposition> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "An independent, evidence-based argument that may support or refute the validity of a specific proposition. The strength and direction of this argument is based on an interpretation of one or more pieces of information as evidence for or against the target proposition." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Evidence Lines are flexible with respect to the granularity of arguments they support, and the scope of evidence items they can collectively assess. Narrow scoping will bucket available evidence into many, fine-grained Evidence Lines that make the most atomic independently meaningful arguments possible. The ACMG Variant Pathogenicity Interpretation Guidelines are an example of a fairly fine-grained evidence interpretation framework. Broader scoping approaches may organize the same available evidence into fewer Evidence Lines that build and assess less atomic arguments based on a wider and more diverse set of evidence items.  For example, CIViC curators assess the strength and direction of evidence items at the level of *all information reported in a publication for a specific study* - which can encompass many different results and evidence types that under more fine-grained interpretation approaches might be split apart and assessed as separate lines of evidence.",
        "Evidence Lines are used to capture various pieces of information (i.e. 'evidence items') that are assessed together as an argument for or against some 'target proposition' - and to report the direction (supports or disputes) and strength (e.g. strong, moderate, weak) that the argument is determined to make. For example, the various allele counts and population frequency calculations for the BRCA2 c.8023A>G variant in the ExAC database are evidence items that may be collectively assessed to build an EvidenceLine making argument of 'moderate' strength that 'supports' a target proposition that the variant is pathogenic for Breast Cancer.",
        "This CIViC EID5682 record (https://civicdb.org/evidence/5682/summary) is a clear example of this - illustrating how ACMG-curated evidence assessed at a finer-grained level would lend itself to SEPIO representations that creates a larger number of more atomic Evidence Lines, as compared to how CIViC-curated evidence from the same source or publication would be represented. We see here that CIViC evidence assessments are performed at the level of all results reported in PMID:23143947 - which SEPIO would capture as a single Evidence Line that assigns a strength (level C) and direction (supports) to the collective argument made by this evidence. However, as detailed in the free-text summary of this EID, the more fine-grained ACMG framework breaks out and separately assess two arguments here - one based on criterion PP1 (disease co-segregation evidence), and one based on criterion PP4 (highly specific gene-phenotype information) - which SEPIO woudl capture as two distinct Evidence Lines." .

<https://example.org/sepio-model/Qualifier> a owl:Class ;
    rdfs:label "Qualifier" ;
    dcterms:title "Qualifier" ;
    ns1:status <Informative> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/name> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "A key-value object used to capture additional piece of information that extends or refines the meaning of a Statement's core subject - predicate - object 'triple' - by providing additional detail, or constraining the statement to apply in a particular context." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Qualifiers allow representation of more complex, n-ary statements that may not be accommodated by a simple subject-predicate-object (SPO) triple. For example, if a triple asserts that 'Variant X' - predicts sensitivity to - 'Treatment Y', a qualifier can be used to indicate that this applies in the context of a particular 'Disease Z'. Qualifiers can also add information that 'quantifies' aspects of a Statement - e.g. for a Statement triple asserting that a 'Variant X'- causes - 'Phenotype Y', a qualifier can be used to add frequency/penetrance information that quantifies the percentage of carriers in which the phenotype is observed to manifest." .

<https://example.org/sepio-model/RecordMetadata> a owl:Class ;
    rdfs:label "RecordMetadata" ;
    dcterms:title "Record Metadata" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/dateRecordCreated> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/contributions> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/recordVersion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/recordIdentifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/recordVersion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/recordVersion> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/dateRecordCreated> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/derivedFromRecord> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/derivedFromRecord> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/recordIdentifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/recordIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Contribution> ;
            owl:onProperty <https://example.org/sepio-model/contributions> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/dateRecordCreated> ],
        <https://example.org/sepio-model/Utility> ;
    skos:definition "A reusable structure that encapsulates provenance metadata about a serialized data record or object in a particular dataset (as opposed to provenance of the real world entity this record or object represents)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Record-level metadata applies to a specific concrete encoding/serialization of information (e.g as a record in a specific data/knowlegebase, or an online digital resource). A RecordMetadata object can capture when, how, and by whom a record serialization was generated or modified; what upstream resources it was derived or retrieved from; and record-level administrative information such as versioning and lifecycle status." .

<https://example.org/sepio-model/StudyGroup> a owl:Class ;
    rdfs:label "StudyGroup" ;
    dcterms:title "Study Group" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/memberCount> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/memberCount> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://example.org/sepio-model/memberCount> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Characteristic> ;
            owl:onProperty <https://example.org/sepio-model/characteristics> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/characteristics> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/isSubsetOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/StudyGroup> ;
            owl:onProperty <https://example.org/sepio-model/isSubsetOf> ],
        <https://example.org/sepio-model/Entity> ;
    skos:definition "A collection of individuals or specimens from the same taxonomic class, selected for analysis in a scientific study based on their exhibiting one or more common characteristics  (e.g. species, race, age, gender, disease state, income). May be referred to as a 'cohort' or 'population' in specific research settings." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "A Study Group may include all participants in a given study, or specific subsets that are designated based on shared roles or characteristics." .

<https://example.org/sepio-model/StudyResult> a owl:Class ;
    rdfs:label "StudyResult" ;
    dcterms:title "Study Result" ;
    ns1:status <Draft> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/dataItems> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/focus> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/StudyGroup> ;
            owl:onProperty <https://example.org/sepio-model/studyGroup> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/componentResult> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/focus> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/sourceDataSet> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/StudyResult> ;
            owl:onProperty <https://example.org/sepio-model/componentResult> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataSet> ;
            owl:onProperty <https://example.org/sepio-model/sourceDataSet> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/Coding> ;
            owl:onProperty <https://example.org/sepio-model/interpretation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/interpretation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/interpretation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://example.org/sepio-model/DataItem> ;
            owl:onProperty <https://example.org/sepio-model/dataItems> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://example.org/sepio-model/focus> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://example.org/sepio-model/studyGroup> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://example.org/sepio-model/studyGroup> ],
        <https://example.org/sepio-model/InformationEntity> ;
    skos:definition "A collection of data items from a single study that pertain to a particular subject or experimental unit in the study, along with optional provenance information describing how these data items were generated." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "- StudyResults provide a useful way to capture a subset of items from a study dataset that are used as evidence in generating higher order knowledge assertions about the entity that is the focus of the study result. For example, a subset of allele frequency data items about a particular variant of interest in the complete gnomAD dataset can be reported in a StudyResult object, along with relevant provenance information, so they can be referenced as evidence for a higher-order assertion about the variant's pathogenicity.",
        "As an example, consider the comprehensive allele frequency dataset provided by gnomAD, which covers millions of variants. A curator looking to assess the pathogenicity of a particular variant might create a StudyResult object to capture a subset of data related to this focus allele, including  its count, frequency, homozygous frequency, along with metadata concerning the shared provenance or quality of this data. The StudyResult could then be references as a piece of evidence used to inform the focus alleles final pathogenicity classification.",
        "Note that the use of a Study Results is not reserved only for defining subsets of data from a larger HTP/clinical study data sets.  A StudyResult might be used to organize the data from a simple, small scale bench experiment - e.g. a western blot analysis of protein expression, or an in vitro binding assay focused on a single protein.  Even such small 'studies' can generate multiple data items and metadata, and a StudyResult object can be used to collect all or some of these data points pertinent to a particular focus into an organized structure." .

<https://example.org/sepio-model/activityType> a owl:ObjectProperty ;
    rdfs:label "activityType" ;
    ns1:status <Draft> ;
    skos:definition "The specific type of activity performed or role played by an agent in making the contribution (e.g. for a publication, agents may contribute as a primary author, editor, figure designer, data generator, etc. . Values of this property may be framed as activities or as contribution roles (e.g. using terms from the Contribution Role Ontology (CRO))." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Each implementation can define terms for the specific types of activities relevant to their use case/application. \\n- Note that if the same Agent performed multiple types of activities in contributing to some artifact, they may all be captured in a single Contribution object. However, if data creators want to provide metadata specific to each activity (e.g. when or how each was performed), then a separate Contribution object should be created for each activity." .

<https://example.org/sepio-model/alternativeLabels> a owl:DatatypeProperty ;
    rdfs:label "alternativeLabels" ;
    ns1:status <Draft> ;
    skos:definition "Alternative name(s) for the Entity." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/characteristics> a owl:ObjectProperty ;
    rdfs:label "characteristics" ;
    ns1:status <Draft> ;
    skos:definition "A feature or role shared by all members of the StudyGroup, representing a criterion for membership in the group." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/componentDataItem> a owl:ObjectProperty ;
    rdfs:label "componentDataItem" ;
    ns1:status <Informative> ;
    skos:definition "A more foundational data item that is a logical component of a compound data item." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Examples of 'compound' data items with component parts include a confidence interval, which is comprised of data items representing its lower and upper bounds,  or a blood pressure reading, which is comprised of separate systolic and diastolic measurements." .

<https://example.org/sepio-model/componentResult> a owl:ObjectProperty ;
    rdfs:label "componentResult" ;
    ns1:status <Draft> ;
    skos:definition "Another StudyResult comprised of data items about the same focus as its parent Result, but based on a more narrowly scoped analysis of the foundational data (e.g. an analysis based on data about a subset of the parent Results full study population)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute allows data creators to break down a StudyResult into finer-grained StudyResult instances with a narrower scope. For example, a StudyResult about the frequency of an allele in a global population of individuals can be broken down into separate 'component' Results about distinct subpopulations of individuals in the source data (e.g. frequency of the allele in asian vs african subpopulations, or male vs female subgroups)." .

<https://example.org/sepio-model/dataItems> a owl:ObjectProperty ;
    rdfs:label "dataItems" ;
    ns1:status <Informative> ;
    skos:definition "One or more data items that are included in the StudyResult because it pertains to the 'focus' of the result. This can be data that directly describes this 'focus' (e.g. the population frequency of an allele focus), or be metadata about how data about the 'focus' were generated (e.g the quality measures for the sequencing run used to determine this allele frequency)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Any type of data item from a Study may be captured in a StudyResult - including raw experimental/observational data, derived calculations or quality measures, provenance information about how the data were generated in the study, or qualitative expert interpretations of the primary study data (e.g. the interpretation of a blood cholesterol value of 250 mg/dL as being 'high', or a Polyphen functional impact score of 0.115 as being 'deleterious').",
        "The model specifies use of a key-value based 'DataItem' object to capture the meaning and value of each type of data item captured in a given StudyResult. But in practice, profiles for specific StudyResult types may choose to define one or more specializations of the generic 'dataItems' property as named attributes. This makes the data more succinct and parsable, and allows specific constraints to be applied and validated for different data items. For example, a PopulaitonAlleleFrequencyStudyResult profile may define a named 'focusAlleleFrequency' attribute that is required, and a named 'focusAlleleCount' attribute that is optional - both of which conceptually specialize the core-im 'dataItems' property. Under this approach, the core 'dataItems' acts as a placeholder to seed such specializations, but is not used directly in StudyResult profiles." .

<https://example.org/sepio-model/derivedFrom> a owl:ObjectProperty ;
    rdfs:label "derivedFrom" ;
    ns1:status <Draft> ;
    skos:definition "Another Information Entity from which this Information Entity is derived, in whole or in part." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/derivedFromRecord> a owl:DatatypeProperty ;
    rdfs:label "derivedFromRecord" ;
    ns1:status <Draft> ;
    skos:definition "Another data record from which the record described here was derived, through a data ingest and/or transformation process." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Value should be a string representing the identifier of the source record." .

<https://example.org/sepio-model/evidenceItemSources> a owl:DatatypeProperty ;
    rdfs:label "evidenceItemSources" ;
    ns1:status <Informative> ;
    skos:definition "An information resource (e.g. document, dataset, digital resource such as a database or  knowledgebase) that provides information interpreted as evidence in building an Evidence Line." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This is a 'shortcut relation' that can be used to directly link an Evidence Line to sources of its supporting Evidence Items, without having to represent those Evidence Items directly. Populate with the name or uri or curie of a source of information. Future work will define a more formal framework for referencing information sources." .

<https://example.org/sepio-model/extensions> a owl:ObjectProperty ;
    rdfs:label "extensions" ;
    ns1:status <Draft> ;
    skos:definition "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Extension objects have a key-value data structure that allows definition of custom fields in the data itself. Extensions are not expected to be natively understood, but may be used for pre-negotiated exchange of message attributes between systems." .

<https://example.org/sepio-model/hasEvidence> a owl:ObjectProperty ;
    rdfs:label "hasEvidence" ;
    ns1:status <Informative> ;
    skos:definition "A piece of information that represents or contributes to an argument for or against the validity of the Proposition put forth in a Statement. This is a shortcut relation that links a Statement directly to a piece of evidence supporting it, bypassing the Evidence Line class when used data creators do not utilize an Evidence Line object." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "- Evidence is any information that is interpreted in assessing the truth of  the proposition a Statement puts forth as true or false.  A piece of information only becomes evidence when it is interpreted in this way. Different types of information entities can be used and cited as evidence, including direct observation or measurement data, derived statistical calculations, data tables or figures in a publication, conclusions/findings from a particular study, or prior assertions of knowledge  that themselves are based on their own set of evidence.",
        "This is a shortcut relation that links a Statement directly to a piece of evidence supporting it, bypassing the Evidence Line class - to be used data creators cannot or do not wish to create an Evidence Line object." .

<https://example.org/sepio-model/hasEvidenceFromSources> a owl:ObjectProperty ;
    rdfs:label "hasEvidenceFromSources" ;
    skos:definition "An Information Entity (typically a publication, dataset, or database) that provided information used as evidence to generate the knowledge expressed in a Statement." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This is a 'shortcut property' that can be used to directly link a Statement to sources that provided evidence supporting/disputing it, without having to create Evidence Lines or Evidence Items in the data." .

<https://example.org/sepio-model/hasEvidenceItems> a owl:ObjectProperty ;
    rdfs:label "hasEvidenceItems" ;
    ns1:status <Draft> ;
    skos:definition "An individual piece of information that was evaluated as evidence in building the argument represented by an Evidence Line." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "A given Evidence Line may be supported by one or many individual evidence items. What matters is that all evidence items in a given Evidence Line get collectively assessed and assigned direction and strength  as a single argument for or against a target proposition.",
        "Different types and scales of information entity can serve as evidence (experimental measurements or observations, data tables or figures, images, prior assertions, etc.) Only when assessed as evidence do we consider the information to be an 'Evidence Item'.  For example, a piece of population frequency data about BRCA2 c.8023A>G  becomes an Evidence Item when it is assessed for the support it may offer for a target proposition (e.g. the prospect of the variant’s pathogenicity)." .

<https://example.org/sepio-model/hasEvidenceLines> a owl:ObjectProperty ;
    rdfs:label "hasEvidenceLines" ;
    ns1:status <Draft> ;
    skos:definition "An evidence-based argument that supports or disputes the validity of the proposition that a Statement assesses or puts forth as true. The strength and direction of this argument (whether it supports or disputes  the proposition, and how strongly) is based on an interpretation of one or more pieces of information as evidence (i.e. 'Evidence Items)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Evidence Lines are useful in cases where a data provider wants to describe in detail how information was  assessed as evidence to generate and score different arguments for or against a Statement''s proposition. Evidence Lines can be omitted if such information is not available or needed.",
        "Evidence Lines result from the interpretation of one or more pieces of information to build an argument for or against a particular Proposition. These arguments have direction (supporting / disputing) and strength (e.g. strong, moderate, weak) relative to the Proposition they are evaluated against. For example, ExaC allele counts and frequency calculations for the BRCA2 c.8023A>G variant in different populations may be collectively assessed to provide an argument of 'moderate' strength in 'support of ' a proposition that the variant is pathogenicity for breast cancer." .

<https://example.org/sepio-model/hasEvidenceOfTypes> a owl:DatatypeProperty ;
    rdfs:label "hasEvidenceOfTypes" ;
    ns1:status <Informative> ;
    skos:definition "A term describing a type of evidence used to assess the validity of Statement's proposition (e.g. 'sequence similarity evidence', 'in vitro assay evidence')." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This contrasts with hasEvidence and hasEvidenceLine attributes that describe specific instances of evidence information, such as a particular data item, study result, or prior assertions, etc. Where possible, data cretors should use of terms from ontologies such as the Evidence and Conclusion Ontology (ECO) to describe specific types of evidence (e.g. ECO:0000044 'sequence similarity evidence')." .

<https://example.org/sepio-model/identifiers> a owl:DatatypeProperty ;
    rdfs:label "identifiers" ;
    ns1:status <Informative> ;
    skos:definition "A globally-unique 'business' identifier or accession number for the real-world entity represented by a data object. These are typically assigned by an external system or authority, and used to connect entities and share content across different systems." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "A given real world entity - e.g. a genetic variant - may have many business identifiers defined by different systems, which can be captured in the \"identifiers\" property to indicate that they represent the same thing.",
        "Preferred values for this attribute are CURIEs or URIs - so the system that provisioned the identifier is clear." .

<https://example.org/sepio-model/input> a owl:ObjectProperty ;
    rdfs:label "input" ;
    ns1:status <Informative> ;
    skos:definition "An entity that was input into the Activity (could be material or information)" ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/isAbout> a owl:DatatypeProperty ;
    rdfs:label "isAbout" ;
    ns1:status <Informative> ;
    skos:definition "An entity or concept in the world that the information entity describes/is about." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "e.g. In the context of a Statement object, this attribute may be used to indicate entities/concepts it is about, in lieu of providing a more precise description of what the Statement asserts to be true using subject, predicate, object, and qualifier properties. e.g. the Statement that \"BRCA2 c.8023A>G is pathogenic for Breast Cancer\" might be annotated to be about the variant 'BRCA2 c.8023A>G', and the disease 'Breast Cancer'." .

<https://example.org/sepio-model/isSubsetOf> a owl:ObjectProperty ;
    rdfs:label "isSubsetOf" ;
    ns1:status <Draft> ;
    skos:definition "A larger StudyGroup of which this StudyGroup represents a subset." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/output> a owl:ObjectProperty ;
    rdfs:label "output" ;
    ns1:status <Informative> ;
    skos:definition "An entity that was output from the Activity (could be material or information)" ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/performedBy> a owl:ObjectProperty ;
    rdfs:label "performedBy" ;
    ns1:status <Draft> ;
    skos:definition "An Agent who participated in executing the Activity." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/reportedIn> a owl:DatatypeProperty ;
    rdfs:label "reportedIn" ;
    ns1:status <Draft> ;
    skos:definition "A document in which the Information Entity is reported." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute is used specifically to reference documents/publications where the Information Entity is expressed or reported.  For a Statement, this might be a publication where the authors express the statement in text. For a Data Item, this might be a publication with a table or figure that reports the value of the  data." .

<https://example.org/sepio-model/sourceDataSet> a owl:ObjectProperty ;
    rdfs:label "sourceDataSet" ;
    ns1:status <Draft> ;
    skos:definition "A larger DataSet from which the content of the StudyResult was derived." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "In most cases, a StudyResult will be generated using data from one source dataset - but it is possible multiple datasets related to a single study contain data about a particular focus that get collected into a single StudyResult instance." .

<https://example.org/sepio-model/sources> a owl:DatatypeProperty ;
    rdfs:label "sources" ;
    ns1:status <Draft> ;
    skos:definition "A document or other informtion resource in which the information entity, or evidence supporting it, is reported." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "This attribute is more general than InformationEntity.reportedIn (which is used to references a Docuement that directly reports the infrormation), and Statement.hasEvidenceFromSources (which is used to reference resources that provided evidence used to generate the knowledge expressed in a Statement). It can be used to cover both cases, in situations where a data provider does not know which is the case, or does not wish to make the distinction." .

<https://example.org/sepio-model/supportingMethodTypes> a owl:ObjectProperty ;
    rdfs:label "supportingMethodTypes" ;
    ns1:status <Informative> ;
    skos:definition "Types of methodological approaches that were executed to directly or indirectly support creation of the Information Entity." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Implementers should define a relevant source or set of method type codes/terms to use here, based on the needs of the domain or application.'",
        "This field captures terms representing TYPES of methods applied, vs the 'specifiedBy' or'supportingMethods' attributes which capture specific INSTANCES of methods used. These may include types of methods that directly produced the Information Entity, or upstream/accessory methods that indirectly support creation of the Information Entity" .

<https://example.org/sepio-model/supportingMethods> a owl:DatatypeProperty ;
    rdfs:label "supportingMethods" ;
    ns1:status <Informative> ;
    skos:definition "Specific methods that were executed to directly or indirectly support creation of the Information Entity." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "These may include methods that directly produced the Information Entity, or upstream/accessory methods that indirectly support creation of the Information Entity - e.g. methods used to produce data that was interpreted as evidence to generate a Statement of knowledge.",
        "This field captures terms representing specific INSTANCES of methods applied, vs the 'supportingMethodTypes' attribute which captures TYPES of methods used." .

<https://example.org/sepio-model/values> a owl:DatatypeProperty ;
    rdfs:label "values" ;
    ns1:status <Draft> ;
    skos:definition "The specific value(s) that the indicated traitor role  holds in all population members (e.g. 'east asian', 'female', 'adolescent', 'cancer')." ;
    skos:inScheme <https://w3id.org/sepio-model> .

<https://example.org/sepio-model/variabilityMeasures> a owl:ObjectProperty ;
    rdfs:label "variabilityMeasures" ;
    ns1:status <Informative> ;
    skos:definition "A statistical score describing the variability inherent in a data item representing a statistical summary of a set of observations/measurements (e.g. the standard deviation associated with a statistical mean calculated across several experimental replicates)." ;
    skos:inScheme <https://w3id.org/sepio-model> ;
    skos:note "Examples of statistical measures of variability include an Interquartile Range, Variance, Standard Deviation, Standard Error. The type of variability measure used here represents should be reported in the DataItem instance created to represent it." .

<https://w3id.org/biolink/vocab/precedes> a owl:Class ;
    rdfs:label "precedes" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "Temporal precedence without causal commitment." ;
    skos:editorialNote "This maps to the Biolink Model because precedes is well-defined there." ;
    warp:fcm_default_weight "0.0" ;
    warp:rosetta_template "{subject} precedes {object}" ;
    warp:sign "temporal" .

camo:Agency a owl:Class ;
    rdfs:label "agency" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "C causes E if bringing about C would be an effective means for a free agent to bring about E. von Wright (1971), Menzies and Price (1993). Important for management and restoration prescriptions." ;
    warp:canonical_question "Can an agent bring about E by doing C?" ;
    warp:evidence_affinity "management_trials, adaptive_management, practice_evidence" ;
    warp:family "complementary" ;
    warp:linguistic_cues "managers can achieve Y by doing X; restoration prescription; we can restore; recommended intervention; adaptive management" .

camo:ComplementaryAccount a owl:Class ;
    rdfs:label "complementary" ;
    rdfs:subClassOf warp:AccountFamilyEnum ;
    skos:definition "Additional structural accounts (regularity, INUS, capacities, agency)." .

camo:Counterfactual a owl:Class ;
    rdfs:label "counterfactual" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "Had C not occurred, E would not have occurred. Lewis (1973), revised as influence theory. Operationalized by potential outcomes / Rubin causal model." ;
    warp:canonical_question "Would E have occurred without C?" ;
    warp:evidence_affinity "experimental, potential_outcomes, control_group" ;
    warp:family "difference_making" ;
    warp:linguistic_cues "without X; in the absence of; had [not]; would not have; if X had not occurred; removal language implying dependence" .

camo:DifferenceMakingAccount a owl:Class ;
    rdfs:label "difference_making" ;
    rdfs:subClassOf warp:AccountFamilyEnum ;
    skos:definition "Asks WHETHER C makes a difference to E." .

camo:INUSComponent a owl:Class ;
    rdfs:label "inus_component" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "C is an Insufficient but Necessary part of an Unnecessary but Sufficient condition. Mackie (1965). Rothman's sufficient-component cause model in epidemiology." ;
    warp:canonical_question "Is C a necessary component of a sufficient cause constellation?" ;
    warp:evidence_affinity "multifactorial_analysis, interaction_studies" ;
    warp:family "complementary" ;
    warp:linguistic_cues "contributing factor; one of several causes; component cause; in combination with; multifactorial; necessary but not sufficient" .

camo:Interventionist a owl:Class ;
    rdfs:label "interventionist" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "There exists an intervention on C that changes E or its probability distribution. Woodward (2003). Invariant generalizations stable under intervention. Pearl's do-calculus." ;
    warp:canonical_question "Does intervening on C change E?" ;
    warp:evidence_affinity "experimental, quasi_experimental, natural_experiment" ;
    warp:family "difference_making" ;
    warp:linguistic_cues "experimental manipulation of; removal led to; treatment resulted in; randomized trial showed; controlled experiment demonstrated" .

camo:Mechanistic a owl:Class ;
    rdfs:label "mechanistic" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "Entities and activities organized to produce the phenomenon. Machamer-Darden-Craver (2000), Illari and Williamson (2012) consensus definition. Dominant in biology and ecology." ;
    warp:canonical_question "What entities and activities produce E from C?" ;
    warp:evidence_affinity "mechanistic_study, process_tracing, lab_experiment" ;
    warp:family "production" ;
    warp:linguistic_cues "the mechanism by which; pathway from X to Y; exerts its effect via; step-by-step process; molecular pathway; trophic cascade" .

camo:ProbabilisticVariation a owl:Class ;
    rdfs:label "probabilistic" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "C raises the probability of E, conditioned on certain background factors, or causation is identified through systematic co-variation between values of variables across cases or units. Reichenbach, Suppes, and Eells describe probabilistic accounts; Russo (2009) describes the variation account. Operationalized by relative risks, odds ratios, conditional probabilities, regression, path analysis, or structural equation modeling." ;
    warp:canonical_question "Does C raise the probability of E, or do variations in C systematically track variations in E?" ;
    warp:evidence_affinity "epidemiological, statistical, population_level, structural_equation_model, path_analysis, regression" ;
    warp:family "difference_making" ;
    warp:linguistic_cues "increases the risk of; risk factor for; associated with [+stats]; probability; odds ratio; relative risk; hazard ratio; P(E|C); regression coefficient; path coefficient; structural equation model; SEM; variance explained; R²; beta coefficient; effect of X on Y" .

camo:ProductionAccount a owl:Class ;
    rdfs:label "production" ;
    rdfs:subClassOf warp:AccountFamilyEnum ;
    skos:definition "Asks HOW C brings about E. Also known as mechanism account." .

camo:Regularity a owl:Class ;
    rdfs:label "regularity" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "Constant conjunction between event types. Hume, Mill, neo-Humean accounts. Causation as repeated, regular succession." ;
    warp:canonical_question "Does C-type always/usually precede E-type?" ;
    warp:evidence_affinity "repeated_observation, survey, monitoring" ;
    warp:family "complementary" ;
    warp:linguistic_cues "wherever X appears, Y follows; consistently observed; invariably accompanies; universal pattern; law-like regularity" .

camo:Transmission a owl:Class ;
    rdfs:label "transmission" ;
    rdfs:subClassOf warp:PhilosophicalAccountEnum ;
    skos:definition "Causal production as transmission between system states, including conserved quantities, material flows, physical signals, or information. Combines causal process accounts associated with Salmon mark-transmission and Dowe conserved quantity theory with information-transmission accounts associated with Collier and Illari (2011). Generalizes beyond physics and can handle absences." ;
    warp:canonical_question "What conserved quantity, material flow, signal, or information is transmitted from C to E?" ;
    warp:evidence_affinity "physical_measurement, tracer_studies, biomarker_tracking, signal_tracing, omics" ;
    warp:family "production" ;
    warp:linguistic_cues "energy transfer; material flow; physical transmission; nutrient transport; water flow; sediment transport; signal; information channel; biomarker pathway; contaminant tracing; gene expression cascade; environmental signal" .

camo:causes a owl:Class ;
    rdfs:label "causes" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "Direct positive causation: C produces E." ;
    warp:fcm_default_weight "0.7" ;
    warp:rosetta_template "{subject} causes {object}" ;
    warp:sign "positive" .

camo:contributes_to a owl:Class ;
    rdfs:label "contributes_to" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "C is one of several contributing factors to E." ;
    warp:fcm_default_weight "0.4" ;
    warp:rosetta_template "{subject} contributes to {object}" ;
    warp:sign "positive" .

camo:correlated_with a owl:Class ;
    rdfs:label "correlated_with" ;
    rdfs:subClassOf camo:associated_with,
        warp:CausalPredicateEnum ;
    skos:definition "A reported statistical correlation (e.g., Pearson or Spearman r, Rsquared, regression slope) without direction or causal commitment. A narrower form of associated_with: use it only when the source reports a correlation statistic; otherwise use associated_with." ;
    skos:exactMatch <https://w3id.org/biolink/vocab/correlated_with> ;
    warp:fcm_default_weight "0.2" ;
    warp:rosetta_template "{subject} is correlated with {object}" ;
    warp:sign "unspecified" .

camo:disrupts a owl:Class ;
    rdfs:label "disrupts" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "C degrades, suppresses, or disrupts E." ;
    warp:fcm_default_weight "-0.5" ;
    warp:rosetta_template "{subject} disrupts {object}" ;
    warp:sign "negative" .

camo:enables a owl:Class ;
    rdfs:label "enables" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "C facilitates or promotes E but is not sufficient." ;
    warp:fcm_default_weight "0.5" ;
    warp:rosetta_template "{subject} enables {object}" ;
    warp:sign "positive" .

camo:mediates a owl:Class ;
    rdfs:label "mediates" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "M is on the causal pathway between C and E." ;
    warp:fcm_default_weight "0.0" ;
    warp:rosetta_template "{subject} mediates the effect on {object}" ;
    warp:sign "pathway" .

camo:moderates a owl:Class ;
    rdfs:label "moderates" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "Z modifies the strength or direction of the C-to-E relationship." ;
    warp:fcm_default_weight "0.0" ;
    warp:rosetta_template "{subject} moderates the relationship with {object}" ;
    warp:sign "modifier" .

camo:prevents a owl:Class ;
    rdfs:label "prevents" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "C inhibits, blocks, or reduces E." ;
    warp:fcm_default_weight "-0.6" ;
    warp:rosetta_template "{subject} prevents {object}" ;
    warp:sign "negative" .

camo:regulates a owl:Class ;
    rdfs:label "regulates" ;
    rdfs:subClassOf warp:CausalPredicateEnum ;
    skos:definition "C modulates E (direction may be positive or negative - depends on the node state changes)." ;
    warp:fcm_default_weight "0.0" ;
    warp:rosetta_template "{subject} regulates {object}" ;
    warp:sign "variable" .

causal_mosaic:ComparatorAnnotation a owl:Class ;
    rdfs:label "ComparatorAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator_node_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:comparator_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:comparator_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:comparator_node_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:comparator_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty causal_mosaic:comparator_node_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:comparator_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ComparatorTypeEnum ;
            owl:onProperty causal_mosaic:comparator_type ] ;
    skos:definition """One comparison arm of a causal edge; an edge lists one per arm (see CausalEdge.comparator). Controls are recorded here rather than as nodes: nodes represent states and changes in state, whereas a control represents what a measurement was contrasted with. Modelling a control as a node forces either a hub node shared across unrelated studies or a per-study singleton that can never merge, and neither survives type-level synthesis.
Where the comparison arm is itself a management decision a practitioner could take — natural regeneration, cessation of grazing — annotate it as an ordinary management_intervention or environmental_process node and point comparator_node_id at it. An arm that exists only to be measured against gets no node.
A factor applied to every arm including the comparator explains no between-arm difference and is not a cause the study tests; it should not be annotated as a cause in that document's graph.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ContextAnnotation a owl:Class ;
    rdfs:label "ContextAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:scope_conditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:geographic_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:temporal_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:temporal_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcosystemFunctionalGroupEnum ;
            owl:onProperty causal_mosaic:ecosystem_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty causal_mosaic:scope_conditions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:temporal_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:ecosystem_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:geographic_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:ecosystem_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:geographic_scope ] ;
    skos:definition "Scope conditions or enabling conditions for the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:DirectionAnnotation a owl:Class ;
    rdfs:label "DirectionAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:DirectionStatusEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_for_direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:evidence_for_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DirectionEvidenceEnum ;
            owl:onProperty causal_mosaic:evidence_for_direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ] ;
    skos:definition "Direction and asymmetry of the causal relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:EvidentialBasis a owl:Class ;
    rdfs:label "EvidentialBasis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceObjectEnum ;
            owl:onProperty causal_mosaic:evidence_objects ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EvidenceTypeEnum ;
            owl:onProperty causal_mosaic:evidence_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidence_objects ] ;
    skos:definition "Operationalizes Illari's type/object distinction and the Russo-Williamson Thesis at the article-annotation level. Tracks what kinds of evidence an individual source provides; aggregate criteria are assessed on EvidenceBaseAssessmentEdge." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:MediationAnnotation a owl:Class ;
    rdfs:label "MediationAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty causal_mosaic:mediator_node_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:pathway_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:pathway_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:pathway_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:mediator_node_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ] ;
    skos:definition "Whether a mediating pathway is identified between cause and effect." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ModerationAnnotation a owl:Class ;
    rdfs:label "ModerationAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty causal_mosaic:moderator_node_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:interaction_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:InteractionTypeEnum ;
            owl:onProperty causal_mosaic:interaction_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:moderator_node_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:interaction_type ] ;
    skos:definition "Whether effect modification by a third variable is noted." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:StrengthAnnotation a owl:Class ;
    rdfs:label "StrengthAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:quantitative_numeric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:quantitative_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:quantitative_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:quantitative_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:dose_response ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:dose_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:quantitative_numeric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:quantitative_numeric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty causal_mosaic:dose_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:StrengthQualitativeEnum ;
            owl:onProperty causal_mosaic:qualitative_descriptor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:qualitative_descriptor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:qualitative_descriptor ] ;
    skos:definition "Effect size, magnitude, or dose-response characterization." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:TemporalExtent a owl:Class ;
    rdfs:label "TemporalExtent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:observation_seasons ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:observation_grain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:lag_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:observation_grain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:lag_months ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:lag_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:duration_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:observation_seasons ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:duration_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:observation_grain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:duration_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty causal_mosaic:duration_months ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:duration_months ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:duration_months ] ;
    skos:definition """The temporal window over which a causal effect was observed or measured. Distinct from the study period (when was fieldwork done): this captures the timescale of the causal relationship itself. For example, a study conducted from 2015-2020 might report that invasive removal led to native recovery "within three growing seasons" — the study period is 5 years, but the temporal extent of the causal effect is 3 growing seasons (~18 months).
This is important for practitioners who need to know how long to wait for results, and for meta-analysts investigating whether effect sizes vary with observation duration.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:account_coverage a owl:ObjectProperty ;
    rdfs:label "account_coverage" ;
    skos:definition "Philosophical accounts of causation represented by the evidence contributing to this aggregate relationship." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:applied_to a owl:ObjectProperty ;
    rdfs:label "applied_to" ;
    skos:definition """The entity or entities that this node is directed at, acts upon, or whose scope the measurement spans. Covers two roles depending on node type:
(1) Scope role (environmental_variable): one or more taxa or ecological guilds whose measurements are aggregated or grouped — for example, "richness of liverworts, Sphagnum, and true mosses" (list the Wikidata QID for each group) or "abundance of native species" (free text "native species", tracked in NAO). Wikidata QIDs for higher-rank taxa enable downstream traversal to all taxon nodes sharing that QID without requiring a structural edge. Free-text values are accepted for functional groups and guilds with no Wikidata resolution (e.g., "native species", "shade-tolerant species", "invasive plants") and should be tracked in the project NAO list. Do not use on single-taxon nodes — use entity_type: taxon with the QID in entity_term instead.
(2) Target role (environmental_process and management_intervention): the specific entity that the process or intervention is directed at or acts upon. Use when the node's meaning is only complete with reference to a target — for example, "herbivory on Sphagnum" or "invasive species removal of Alliaria petiolata".
Accepts any entity type (taxon, community, habitat, etc.) using the same entity_type / entity_term decomposition as CausalNode.""" ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:note "For environmental_variable nodes: list the taxa or guilds whose measurements are aggregated. For process and intervention nodes: name the directional target entity. Leave empty for processes with no directional target and for variables with no taxonomic scope (e.g., soil pH, water table level)." .

causal_mosaic:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    skos:definition "Authors of the source document." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:bradford_hill_viewpoints a owl:ObjectProperty ;
    rdfs:label "bradford_hill_viewpoints" ;
    skos:definition "Bradford Hill viewpoints supported by the aggregated evidence base. Some viewpoints require qualitative judgment and may not be fully programmatically reassessable each time article-level causal edges change." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:comparator a owl:ObjectProperty ;
    rdfs:label "comparator" ;
    skos:definition "What the effect described by this edge was assessed relative to. Answers \"compared with what?\" — a property of the causal inference, not an entity in the world, and therefore annotated here rather than as a control node. One entry per comparison arm, so designs with more than one contrast keep a separate description and comparator_node_id for each: a BACI design (e.g. Kramer et al. 1995) records one pre_treatment_baseline entry and one untreated_control or spatial_or_temporal_control entry. Use a single entry when the source reports one comparison." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:coordinate_location_basis a owl:ObjectProperty ;
    rdfs:label "coordinate_location_basis" ;
    skos:definition "Annotation of what the coordinate values represent. Select exact_site when the coordinates identify the study site or sampling location; select nearest_municipality when the coordinates are for the nearest municipality rather than the exact site." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:edges a owl:ObjectProperty ;
    rdfs:label "edges" ;
    skos:definition "All annotated causal relationships." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:entity_terms a owl:DatatypeProperty ;
    rdfs:label "entity_terms" ;
    skos:definition "Entity terms the option can apply to, as CURIEs (preferred) or free text. A broader term covers its members (e.g. wd:Q756, plants, covers every plant taxon); resolving members is left to the matching tool." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:entity_types a owl:ObjectProperty ;
    rdfs:label "entity_types" ;
    skos:definition "Entity types the option can apply to." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_base_assessments a owl:ObjectProperty ;
    rdfs:label "evidence_base_assessments" ;
    skos:definition "Derived evidence-base-level assessments over sets of article-level causal edges. These should be regenerated when new relevant CausalEdge records are added." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_objects a owl:ObjectProperty ;
    rdfs:label "evidence_objects" ;
    skos:definition "OBJECT of evidence: whether it supports correlation, mechanism, or both. Per the Russo-Williamson Thesis." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:evidence_types a owl:ObjectProperty ;
    rdfs:label "evidence_types" ;
    skos:definition "TYPE of evidence: what kind of study or reasoning." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:excluded_edge_ids a owl:DatatypeProperty ;
    rdfs:label "excluded_edge_ids" ;
    skos:definition "Article-level CausalEdge identifiers reviewed but excluded from this aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:included_edge_ids a owl:DatatypeProperty ;
    rdfs:label "included_edge_ids" ;
    skos:definition "Article-level CausalEdge identifiers included in this aggregate assessment." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:measured_attributes a owl:DatatypeProperty ;
    rdfs:label "measured_attributes" ;
    skos:definition "Measured attributes the option can supply, as CURIEs (preferred, e.g. PATO terms) or free text." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:mediator_node_ids a owl:DatatypeProperty ;
    rdfs:label "mediator_node_ids" ;
    skos:definition "Node IDs of mediating entities. These should also appear as separate nodes in the graph with their own edges." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:moderator_node_ids a owl:DatatypeProperty ;
    rdfs:label "moderator_node_ids" ;
    skos:definition "Node IDs of moderating entities." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:nodes a owl:ObjectProperty ;
    rdfs:label "nodes" ;
    skos:definition "All causal entities (causes, effects, mediators, moderators)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:observation_seasons a owl:DatatypeProperty ;
    rdfs:label "observation_seasons" ;
    skos:definition "Seasons during which the effect was observed, if seasonally restricted. E.g., [\"spring\", \"summer\"] for a growing-season study. Important for context-dependent effects that may not hold year-round." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:options a owl:ObjectProperty ;
    rdfs:label "options" ;
    skos:definition "The parameter options in this catalog." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:parameter_options a owl:ObjectProperty ;
    rdfs:label "parameter_options" ;
    skos:definition "Ways the state or change this node represents could be measured or supplied as a parameter, given as ids of ParameterOption entries in a ParameterOptionCatalog. A list of possibilities, independent of any source document: it does not record what a study measured. Used to bind nodes to data streams in digital twins and to choose observable variables when building causal models. Options apply to the variable, so nodes sharing a variable_key should carry the same options, filtered to those whose value_type suits the node's qualifier family." ;
    skos:inScheme <https://w3id.org/causal-mosaic> ;
    warp:loom_role "calculated" ;
    warp:note "Populated from the parameter option catalog, not by annotators. References are by id; loom checks that each id exists in the catalog." .

causal_mosaic:philosophical_accounts a owl:ObjectProperty ;
    rdfs:label "philosophical_accounts" ;
    skos:definition "Which philosophical account(s) of causation does this claim invoke? A claim may invoke multiple accounts simultaneously." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:qualifier_families a owl:ObjectProperty ;
    rdfs:label "qualifier_families" ;
    skos:definition "Qualifier families of the nodes the option can supply. Should be consistent with the option's value_type (see ValueTypeEnum)." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:scope_conditions a owl:DatatypeProperty ;
    rdfs:label "scope_conditions" ;
    skos:definition "Named conditions under which the relationship holds. E.g., 'in acidic soils', 'at elevations above 2000m', 'in temperate grasslands'." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:source_documents a owl:ObjectProperty ;
    rdfs:label "source_documents" ;
    skos:definition "All documents contributing to this graph. Edges reference entries here by document_id rather than carrying inline copies." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:study_coordinates a owl:ObjectProperty ;
    rdfs:label "study_coordinates" ;
    skos:definition "Coordinate set or sets reported for the study. Use one entry per reported centroid or bounded study area. This supports multi-site studies without requiring site names that the source may not report. Coordinates enable map-based evidence gap maps, proximity-weighted retrieval (\"show me evidence from sites near mine\"), and spatial analysis of where causal relationships have been tested." ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#attribution_required> a owl:Class ;
    rdfs:label "attribution_required" ;
    rdfs:subClassOf warp:AccessLevelEnum .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#community_restricted> a owl:Class ;
    rdfs:label "community_restricted" ;
    rdfs:subClassOf warp:AccessLevelEnum ;
    skos:definition "Shareable only within, or with the permission of, the knowledge holders' community." .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#open> a owl:Class ;
    rdfs:label "open" ;
    rdfs:subClassOf warp:AccessLevelEnum .

<https://w3id.org/ecoweaver/warp/AccessLevelEnum#restricted> a owl:Class ;
    rdfs:label "restricted" ;
    rdfs:subClassOf warp:AccessLevelEnum ;
    skos:definition "Not to be shared beyond the original context." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#acoustic_monitoring> a owl:Class ;
    rdfs:label "acoustic_monitoring" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Passive acoustic recorders or hydrophones (e.g. bird, bat or frog detection)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#camera_trap> a owl:Class ;
    rdfs:label "camera_trap" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Motion- or time-triggered cameras recording animals or vegetation." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#citizen_science> a owl:Class ;
    rdfs:label "citizen_science" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Observations contributed by volunteers or community platforms (e.g. iNaturalist, eBird, structured volunteer surveys)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#environmental_dna> a owl:Class ;
    rdfs:label "environmental_dna" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Detection of taxa from DNA in environmental samples (water, soil, air), including metabarcoding." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#expert_elicitation> a owl:Class ;
    rdfs:label "expert_elicitation" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Values supplied by expert judgement or structured elicitation, where no measurement is available." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#field_survey> a owl:Class ;
    rdfs:label "field_survey" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Direct observation or measurement by people in the field (e.g. quadrat cover, transect counts, plant height, point counts)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#in_situ_sensor> a owl:Class ;
    rdfs:label "in_situ_sensor" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "An automated instrument deployed at the site that records continuously or at intervals (e.g. soil moisture probe, water level logger, weather station, flux tower)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#laboratory_assay> a owl:Class ;
    rdfs:label "laboratory_assay" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Analysis of collected samples in a laboratory (e.g. soil nutrient analysis, tissue chemistry, seed bank germination trials)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#management_record> a owl:Class ;
    rdfs:label "management_record" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Records kept by the people carrying out an action (e.g. burn logs, seeding records, removal tallies, grazing schedules). The usual way to supply management_intervention nodes." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#model_output> a owl:Class ;
    rdfs:label "model_output" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Values produced by a model, reanalysis or gridded data product rather than direct observation (e.g. climate reanalysis, species distribution model output)." .

<https://w3id.org/ecoweaver/warp/AcquisitionMethodEnum#remote_sensing> a owl:Class ;
    rdfs:label "remote_sensing" ;
    rdfs:subClassOf warp:AcquisitionMethodEnum ;
    skos:definition "Measurement from satellite, airborne or drone platforms (e.g. multispectral imagery, LiDAR, radar)." .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#community_member> a owl:Class ;
    rdfs:label "community_member" ;
    rdfs:subClassOf warp:AgentKindEnum .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#indigenous_knowledge_holder> a owl:Class ;
    rdfs:label "indigenous_knowledge_holder" ;
    rdfs:subClassOf warp:AgentKindEnum .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#organization> a owl:Class ;
    rdfs:label "organization" ;
    rdfs:subClassOf warp:AgentKindEnum .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#practitioner> a owl:Class ;
    rdfs:label "practitioner" ;
    rdfs:subClassOf warp:AgentKindEnum .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#researcher> a owl:Class ;
    rdfs:label "researcher" ;
    rdfs:subClassOf warp:AgentKindEnum .

<https://w3id.org/ecoweaver/warp/AgentKindEnum#synthesis_pipeline> a owl:Class ;
    rdfs:label "synthesis_pipeline" ;
    rdfs:subClassOf warp:AgentKindEnum ;
    skos:definition "An EcoWeaver or other automated synthesis process." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#insufficient_evidence> a owl:Class ;
    rdfs:label "insufficient_evidence" ;
    rdfs:subClassOf warp:AssessmentStatusEnum ;
    skos:definition "There is not enough evidence to assess this criterion." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#mixed> a owl:Class ;
    rdfs:label "mixed" ;
    rdfs:subClassOf warp:AssessmentStatusEnum ;
    skos:definition "The evidence base contains conflicting signals for this criterion." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_assessed> a owl:Class ;
    rdfs:label "not_assessed" ;
    rdfs:subClassOf warp:AssessmentStatusEnum ;
    skos:definition "The criterion has not been assessed." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#not_satisfied> a owl:Class ;
    rdfs:label "not_satisfied" ;
    rdfs:subClassOf warp:AssessmentStatusEnum ;
    skos:definition "The criterion is not satisfied by the aggregated evidence base." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#partially_satisfied> a owl:Class ;
    rdfs:label "partially_satisfied" ;
    rdfs:subClassOf warp:AssessmentStatusEnum ;
    skos:definition "The criterion is partially satisfied by the aggregated evidence base." .

<https://w3id.org/ecoweaver/warp/AssessmentStatusEnum#satisfied> a owl:Class ;
    rdfs:label "satisfied" ;
    rdfs:subClassOf warp:AssessmentStatusEnum ;
    skos:definition "The criterion is satisfied by the aggregated evidence base." .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#analogy> a owl:Class ;
    rdfs:label "analogy" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Similar cause-effect relationships are known in analogous systems." ;
    warp:maps_to_account "mechanistic" ;
    warp:maps_to_feature "stability" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#biological_gradient> a owl:Class ;
    rdfs:label "biological_gradient" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Dose-response relationship." ;
    warp:maps_to_account "probabilistic" ;
    warp:maps_to_feature "strength" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#coherence> a owl:Class ;
    rdfs:label "coherence" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Causal interpretation fits with broader knowledge." ;
    warp:maps_to_account "mechanistic" ;
    warp:maps_to_feature "stability" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#consistency> a owl:Class ;
    rdfs:label "consistency" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Replicated across different studies, populations, and contexts." ;
    warp:maps_to_account "regularity" ;
    warp:maps_to_feature "stability" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#experiment> a owl:Class ;
    rdfs:label "experiment" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Deliberate manipulation changes the outcome." ;
    warp:maps_to_account "interventionist" ;
    warp:maps_to_feature "direction" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#plausibility> a owl:Class ;
    rdfs:label "plausibility" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "A known or plausible mechanism exists." ;
    warp:maps_to_account "mechanistic" ;
    warp:maps_to_feature "mediation" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#specificity> a owl:Class ;
    rdfs:label "specificity" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "One-to-one mapping between cause and effect." ;
    warp:maps_to_account "probabilistic" ;
    warp:maps_to_feature "specificity" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#strength> a owl:Class ;
    rdfs:label "strength" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Large effect size or strong association." ;
    warp:maps_to_account "probabilistic" ;
    warp:maps_to_feature "strength" .

<https://w3id.org/ecoweaver/warp/BradfordHillViewpointEnum#temporality> a owl:Class ;
    rdfs:label "temporality" ;
    rdfs:subClassOf warp:BradfordHillViewpointEnum ;
    skos:definition "Cause precedes effect (the only 'inarguable' viewpoint)." ;
    warp:maps_to_account "counterfactual | probabilistic | interventionist | transmission | mechanistic | regularity | inus_component | agency" ;
    warp:maps_to_feature "temporal_ordering" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#high> a owl:Class ;
    rdfs:label "high" ;
    rdfs:subClassOf warp:CertaintyGradeEnum ;
    skos:definition "High certainty. Rosetta rendering: 'X increases Y'." ;
    warp:rosetta_verb_modifier "" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#low> a owl:Class ;
    rdfs:label "low" ;
    rdfs:subClassOf warp:CertaintyGradeEnum ;
    skos:definition "Low certainty. Rosetta rendering: 'X may increase Y'." ;
    warp:rosetta_verb_modifier "may" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#moderate> a owl:Class ;
    rdfs:label "moderate" ;
    rdfs:subClassOf warp:CertaintyGradeEnum ;
    skos:definition "Moderate certainty. Rosetta rendering: 'X probably increases Y'." ;
    warp:rosetta_verb_modifier "probably" .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#not_assessed> a owl:Class ;
    rdfs:label "not_assessed" ;
    rdfs:subClassOf warp:CertaintyGradeEnum ;
    skos:definition "Certainty not formally assessed." .

<https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> a owl:Class ;
    rdfs:label "very_low" ;
    rdfs:subClassOf warp:CertaintyGradeEnum ;
    skos:definition "Very low certainty. Rosetta rendering: 'X might increase Y'." ;
    warp:rosetta_verb_modifier "might" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#associational> a owl:Class ;
    rdfs:label "associational" ;
    rdfs:subClassOf warp:ClaimStrengthEnum ;
    skos:definition "Correlation or co-occurrence without causal verb." ;
    warp:exemplars "correlated with; associated with; co-occurred with; linked to" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#direct_causal> a owl:Class ;
    rdfs:label "direct_causal" ;
    rdfs:subClassOf warp:ClaimStrengthEnum ;
    skos:definition "Unhedged causal verb asserting direct causation." ;
    warp:exemplars "causes; leads to; results in; produces; drives; determines" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#no_relationship> a owl:Class ;
    rdfs:label "no_relationship" ;
    rdfs:subClassOf warp:ClaimStrengthEnum ;
    skos:definition "Explicitly states no causal or associational relationship: a null result. Always paired with negated: true on the same edge (and negated: true is used only with this value). The object node keeps the qualifier a positive finding would use; it is not set to \"unchanged\"." ;
    warp:exemplars "no significant effect; did not affect; no association was found" .

<https://w3id.org/ecoweaver/warp/ClaimStrengthEnum#uncertain_causal> a owl:Class ;
    rdfs:label "uncertain_causal" ;
    rdfs:subClassOf warp:ClaimStrengthEnum ;
    skos:definition "Hedged causal language or conditional causation." ;
    warp:exemplars "may cause; could contribute to; suggests a causal role; possibly leads to" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#alternative_treatment> a owl:Class ;
    rdfs:label "alternative_treatment" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "A different active treatment arm, not an untreated one." ;
    warp:exemplars "compared with the simple seed mix; versus mowing" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_applicable> a owl:Class ;
    rdfs:label "not_applicable" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "The claim is mechanistic, theoretical, or definitional and invokes no contrast." .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#not_reported> a owl:Class ;
    rdfs:label "not_reported" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "No comparator is stated or recoverable from the text. Informative: it downgrades certainty rather than leaving a silent gap." .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#passive_management_arm> a owl:Class ;
    rdfs:label "passive_management_arm" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "An arm representing a real do-nothing or cease-disturbance decision that a practitioner could choose. Where this value is used the arm should also be annotated as its own node, referenced by comparator_node_id, because it is a management intervention in its own right rather than a bare comparison." ;
    warp:exemplars "natural recovery; unseeded natural regeneration; grazing withdrawal" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#pre_treatment_baseline> a owl:Class ;
    rdfs:label "pre_treatment_baseline" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "The same units measured before the intervention; a before-after contrast rather than a between-arm one." ;
    warp:exemplars "compared with pre-treatment cover; relative to year 0" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#reference_undisturbed> a owl:Class ;
    rdfs:label "reference_undisturbed" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "An undisturbed or intact system used as a recovery benchmark or restoration target rather than as an experimental arm." ;
    warp:exemplars "adjacent undisturbed prairie; remnant reference stand" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#spatial_or_temporal_control> a owl:Class ;
    rdfs:label "spatial_or_temporal_control" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "An unimpacted site or period used as a control in an observational or quasi-experimental design." ;
    warp:exemplars "upstream reach; pre-invasion period; paired uninvaded catchment" .

<https://w3id.org/ecoweaver/warp/ComparatorTypeEnum#untreated_control> a owl:Class ;
    rdfs:label "untreated_control" ;
    rdfs:subClassOf warp:ComparatorTypeEnum ;
    skos:definition "Concurrent units receiving no manipulation of the factor under test." ;
    warp:exemplars "no treatment (control); unsprayed plots; unfenced plots" .

<https://w3id.org/ecoweaver/warp/ContributingSoleEnum#contributing_cause> a owl:Class ;
    rdfs:label "contributing_cause" ;
    rdfs:subClassOf warp:ContributingSoleEnum ;
    skos:definition "Presented as one of several contributing factors." .

<https://w3id.org/ecoweaver/warp/ContributingSoleEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:ContributingSoleEnum ;
    skos:definition "Not discussed." .

<https://w3id.org/ecoweaver/warp/ContributingSoleEnum#sole_cause> a owl:Class ;
    rdfs:label "sole_cause" ;
    rdfs:subClassOf warp:ContributingSoleEnum ;
    skos:definition "Presented as the only cause." .

<https://w3id.org/ecoweaver/warp/ContributionRoleEnum#annotator> a owl:Class ;
    rdfs:label "annotator" ;
    rdfs:subClassOf warp:ContributionRoleEnum ;
    skos:definition "Recorded the statement in EcoWeaver from its source. Use on recordMetadata.contributions: it is provenance of the record, not of the knowledge." .

<https://w3id.org/ecoweaver/warp/ContributionRoleEnum#author> a owl:Class ;
    rdfs:label "author" ;
    rdfs:subClassOf warp:ContributionRoleEnum ;
    skos:definition "Made the statement: put the proposition forward (Assertion Mode) or assessed it (Proposition Assessment Mode). Use on Statement.contributions." .

<https://w3id.org/ecoweaver/warp/ContributionRoleEnum#evidence_assessor> a owl:Class ;
    rdfs:label "evidence_assessor" ;
    rdfs:subClassOf warp:ContributionRoleEnum ;
    skos:definition "Judged the direction and strength of an evidence line. Use on EvidenceLine.contributions." .

<https://w3id.org/ecoweaver/warp/ContributionRoleEnum#reviewer> a owl:Class ;
    rdfs:label "reviewer" ;
    rdfs:subClassOf warp:ContributionRoleEnum ;
    skos:definition "Checked an annotation or assessment made by someone else." .

<https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#exact_site> a owl:Class ;
    rdfs:label "exact_site" ;
    rdfs:subClassOf warp:CoordinateLocationBasisEnum ;
    skos:definition "Coordinates identify the exact study site or sampling location." ;
    warp:display_label "Exact site" .

<https://w3id.org/ecoweaver/warp/CoordinateLocationBasisEnum#nearest_municipality> a owl:Class ;
    rdfs:label "nearest_municipality" ;
    rdfs:subClassOf warp:CoordinateLocationBasisEnum ;
    skos:definition "Coordinates identify the nearest municipality used as an approximate proxy for the study location." ;
    warp:display_label "Coordinates of nearest municipality" .

<https://w3id.org/ecoweaver/warp/DeterminismEnum#ambiguous> a owl:Class ;
    rdfs:label "ambiguous" ;
    rdfs:subClassOf warp:DeterminismEnum ;
    skos:definition "Cannot determine whether probability reflects the modeled process or only epistemic uncertainty." .

<https://w3id.org/ecoweaver/warp/DeterminismEnum#deterministic_process> a owl:Class ;
    rdfs:label "deterministic_process" ;
    rdfs:subClassOf warp:DeterminismEnum ;
    skos:definition "The modeled causal process is treated as deterministic: C invariably produces E under the specified conditions." .

<https://w3id.org/ecoweaver/warp/DeterminismEnum#epistemic_probability_only> a owl:Class ;
    rdfs:label "epistemic_probability_only" ;
    rdfs:subClassOf warp:DeterminismEnum ;
    skos:definition "Probability is used only to represent uncertainty about the causal relationship, without implying an indeterministic causal process." .

<https://w3id.org/ecoweaver/warp/DeterminismEnum#indeterministic_process> a owl:Class ;
    rdfs:label "indeterministic_process" ;
    rdfs:subClassOf warp:DeterminismEnum ;
    skos:definition "The modeled causal process is treated as ontically indeterministic: C changes the probability of E without guaranteeing it." .

<https://w3id.org/ecoweaver/warp/DeterminismEnum#not_addressed> a owl:Class ;
    rdfs:label "not_addressed" ;
    rdfs:subClassOf warp:DeterminismEnum ;
    skos:definition "Not discussed." .

<https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#experimental> a owl:Class ;
    rdfs:label "experimental" ;
    rdfs:subClassOf warp:DirectionEvidenceEnum ;
    skos:definition "Direction established by experimental manipulation." .

<https://w3id.org/ecoweaver/warp/DirectionEvidenceEnum#natural_experiment> a owl:Class ;
    rdfs:label "natural_experiment" ;
    rdfs:subClassOf warp:DirectionEvidenceEnum ;
