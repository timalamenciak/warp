        warp:CostPhaseEnum ;
    rdfs:label "maintenance" .

<https://w3id.org/ecoweaver/warp/CostPhaseEnum#monitoring> a owl:NamedIndividual,
        warp:CostPhaseEnum ;
    rdfs:label "monitoring" .

<https://w3id.org/ecoweaver/warp/CostPhaseEnum#whole_project> a owl:NamedIndividual,
        warp:CostPhaseEnum ;
    rdfs:label "whole_project" .

warp:CostPredicateEnum a owl:Class ;
    rdfs:label "CostPredicateEnum" ;
    skos:definition "Predicates for cost statements. warp:incurs_cost is abstract in the relation layer: the exporter writes one sub-property per cost category (incurs_total_cost, incurs_labour_cost, ...), with the amount as the object (decision D16). Declared in src/warp/owl/warp-relations.ttl." ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> ;
    linkml:permissible_values warp:costs_relative_to,
        warp:incurs_cost .

warp:CostQualifiers a owl:Class ;
    rdfs:label "CostQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:effort ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:intensity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:amount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:intensity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:cost_behaviour ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:ratio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:covers_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:cost_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:amount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:effort ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:reporting_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:volunteer_effort ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:ratio ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Count ;
            owl:onProperty warp:count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:volunteer_effort ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:intensity ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostBehaviourEnum ;
            owl:onProperty warp:cost_behaviour ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ReportingLevelEnum ;
            owl:onProperty warp:reporting_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostBasisEnum ;
            owl:onProperty warp:cost_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostCategoryEnum ;
            owl:onProperty warp:includes_categories ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:cost_behaviour ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostPhaseEnum ;
            owl:onProperty warp:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:Quantity ;
            owl:onProperty warp:volunteer_effort ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:cost_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:reporting_level ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:StrategyRoleEnum ;
            owl:onProperty warp:covers_roles ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CostRatio ;
            owl:onProperty warp:ratio ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:MonetaryAmount ;
            owl:onProperty warp:amount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:includes_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:count ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty warp:amount ] [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty warp:effort ] [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty warp:ratio ] ) ] ;
    skos:definition "The predicate layer of a cost statement. One of amount, effort or ratio is required; the rules that depend on the predicate (incurs_cost needs amount or effort, plus scale and phase; costs_relative_to needs ratio) are in scripts/check_cost.py, because a LinkML rule on CostStatement cannot test slots inside predicate_qualifiers (R3, R4)." ;
    skos:exactMatch warp:CostQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CostRatio a owl:Class ;
    rdfs:label "CostRatio" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:basis ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:basis ] ;
    skos:definition "\"A costs about a third of B, per hectare.\"" ;
    skos:exactMatch warp:CostRatio ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:Count a owl:Class ;
    rdfs:label "Count" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty warp:entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:value ] ;
    skos:definition "A number of things, where a unit would be wrong: 46 protected areas, 12 culverts. `entity` is a CURIE for the kind of thing counted." ;
    skos:exactMatch warp:Count ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CriteriaIdentityQualifiers a owl:Class ;
    rdfs:label "CriteriaIdentityQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:Period ;
            owl:onProperty warp:assessed_period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:assessed_period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:assessed_period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:criteria_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:criteria_set ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaSet ;
            owl:onProperty warp:criteria_set ] ;
    skos:definition "The qualifiers a criteria proposition was grouped by: criteria set and assessed period." ;
    skos:exactMatch warp:CriteriaIdentityQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

warp:CriteriaQualifiers a owl:Class ;
    rdfs:label "CriteriaQualifiers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:Period ;
            owl:onProperty warp:assessed_period ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CriteriaSet ;
            owl:onProperty warp:criteria_set ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:assessed_period ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AssessmentMethodEnum ;
            owl:onProperty warp:assessment_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:assessed_period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:assessment_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:criteria_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:criteria_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty warp:assessment_method ] ;
    skos:exactMatch warp:CriteriaQualifiers ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

<https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#adopted> a owl:NamedIndividual,
        warp:CriteriaStatusEnum ;
    rdfs:label "adopted" .

<https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#draft> a owl:NamedIndividual,
        warp:CriteriaStatusEnum ;
    rdfs:label "draft" .

<https://w3id.org/ecoweaver/warp/CriteriaStatusEnum#superseded> a owl:NamedIndividual,
        warp:CriteriaStatusEnum ;
    rdfs:label "superseded" .

warp:CurvePoint a owl:Class ;
    rdfs:label "CurvePoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty warp:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty warp:suitability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:suitability ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:suitability ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty warp:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty warp:x ] ;
    skos:definition "One breakpoint of a habitat suitability response curve: the value of the variable (in the unit of the statement's range) and the suitability there, between 0 and 1." ;
    skos:exactMatch warp:CurvePoint ;
    skos:inScheme <https://w3id.org/ecoweaver/warp> .

