            owl:onProperty causal_mosaic:causal_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:proportionality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:annotation_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:philosophical_accounts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:temporal_extent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:temporal_ordering ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ScopeEnum ;
            owl:onProperty camo:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ComparatorAnnotation ;
            owl:onProperty causal_mosaic:comparator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:proportionality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:certainty_grade ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:specificity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -1e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:fcm_weight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:reversibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:PhilosophicalAccountEnum ;
            owl:onProperty causal_mosaic:philosophical_accounts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:necessity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:fcm_weight_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:QuantityValue ;
            owl:onProperty camo:dose ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty camo:sufficiency ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:SourceDocument ;
            owl:onProperty causal_mosaic:source_document ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:CertaintyGradeEnum ;
            owl:onProperty causal_mosaic:certainty_grade ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:annotation_confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty causal_mosaic:negated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:fcm_weight_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:MediationAnnotation ;
            owl:onProperty camo:mediation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:ContributingSoleEnum ;
            owl:onProperty camo:contributing_sole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:evidential_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:dose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:ecosystem_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty causal_mosaic:annotation_timestamp ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty camo:temporal_ordering ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:certainty_grade ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:evidential_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:specificity ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:TextSpan ;
            owl:onProperty causal_mosaic:source_spans ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:annotation_notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:strength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:determinism ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:CausalNode ;
            owl:onProperty causal_mosaic:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:proximate_distal ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:causal_language ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:StrengthAnnotation ;
            owl:onProperty camo:strength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:annotator ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:DeterminismEnum ;
            owl:onProperty camo:determinism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty camo:necessity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty camo:sufficiency ] ;
    skos:definition """An edge in the labeled property graph representing a causal relationship. Carries all four annotation layers as properties:\r
  Layer 1: Claim strength and linguistic expression\r
  Layer 2: Philosophical account classification\r
  Layer 3: Sixteen causal features\r
  Layer 4: Evidential basis\r
Plus rendering metadata for each downstream target.""" ;
    skos:exactMatch causal_mosaic:CausalEdge ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ContextAnnotation a owl:Class ;
    rdfs:label "ContextAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:geographic_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:geographic_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:geographic_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:ecosystem_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:temporal_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:temporal_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:scope_conditions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:ecosystem_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:scope_conditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:temporal_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:EcosystemFunctionalGroupEnum ;
            owl:onProperty causal_mosaic:ecosystem_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:FeatureAssertionEnum ;
            owl:onProperty causal_mosaic:status ] ;
    skos:definition "Scope conditions or enabling conditions for the causal relationship." ;
    skos:exactMatch causal_mosaic:ContextAnnotation ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

causal_mosaic:ParameterOption a owl:Class ;
    rdfs:label "ParameterOption" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom warp:ValueTypeEnum ;
            owl:onProperty causal_mosaic:value_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^camo_param:[A-Za-z0-9._-]+$" ] ) ] ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:option_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:sensor_or_instrument ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:option_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:label ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:measurement_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:AcquisitionMethodEnum ;
            owl:onProperty causal_mosaic:acquisition_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:typical_spatial_resolution_m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:measurement_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:option_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:value_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:observable_property ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^(unit|UO):\\S+$" ] ) ] ;
            owl:onProperty causal_mosaic:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:sensor_or_instrument ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty causal_mosaic:typical_spatial_resolution_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:sensor_or_instrument ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:value_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:acquisition_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^P(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$" ] ) ] ) ] ;
            owl:onProperty causal_mosaic:typical_temporal_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty causal_mosaic:typical_temporal_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:typical_spatial_resolution_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom causal_mosaic:ApplicabilityScope ;
            owl:onProperty causal_mosaic:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty causal_mosaic:acquisition_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty causal_mosaic:protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:typical_temporal_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom warp:MeasurementRelationEnum ;
            owl:onProperty causal_mosaic:measurement_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty causal_mosaic:observable_property ] ;
    skos:closeMatch sosa:Procedure ;
    skos:definition "One way of measuring or supplying a value for a node: a type of sensor, survey, assay, record or model, described independently of any study. Many nodes can share one option (e.g. quadrat percent cover applies to any plant cover node). An option says what could be measured, not what was measured." ;
    skos:exactMatch causal_mosaic:ParameterOption ;
    skos:inScheme <https://w3id.org/causal-mosaic> .

