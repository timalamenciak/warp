@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scale: <https://w3id.org/ecoweaver/warp/scale/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix warp: <https://w3id.org/ecoweaver/warp/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ecoweaver/warp/ontology/scales> a owl:Ontology ;
    rdfs:label "WARP source scales" ;
    owl:versionInfo "warp-scales/1" .

warp:ordinal a owl:AnnotationProperty ;
    rdfs:label "ordinal" ;
    skos:definition "1-based position of a concept in its scheme, ascending in what the scheme's skos:scopeNote says the order measures." .

<https://w3id.org/ecoweaver/warp/scale/dfo-recovery-priority/high> a skos:Concept ;
    skos:inScheme scale:dfo-recovery-priority ;
    skos:notation "high" ;
    skos:prefLabel "High"@en ;
    warp:ordinal 3 .

<https://w3id.org/ecoweaver/warp/scale/dfo-recovery-priority/low> a skos:Concept ;
