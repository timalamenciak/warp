scale:dfo-recovery-priority a skos:ConceptScheme ;
    dcterms:source "Fisheries and Oceans Canada (recovery strategies under SARA)" ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/dfo-recovery-priority/high>,
        <https://w3id.org/ecoweaver/warp/scale/dfo-recovery-priority/low>,
        <https://w3id.org/ecoweaver/warp/scale/dfo-recovery-priority/medium> ;
    skos:notation "dfo-recovery-priority" ;
    skos:prefLabel "DFO recovery approach priority"@en ;
    skos:scopeNote "Ordinal order: priority, lowest first"@en .

scale:dfo-timing-of-influence a skos:ConceptScheme ;
    dcterms:source "Fisheries and Oceans Canada (recovery strategies under SARA)" ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/dfo-timing-of-influence/future>,
        <https://w3id.org/ecoweaver/warp/scale/dfo-timing-of-influence/immediate>,
        <https://w3id.org/ecoweaver/warp/scale/dfo-timing-of-influence/medium> ;
    skos:notation "dfo-timing-of-influence" ;
    skos:prefLabel "DFO timing of influence of a recovery approach"@en ;
    skos:scopeNote "Ordinal order: how soon the approach takes effect, latest first"@en .

scale:eccc-recovery-priority a skos:ConceptScheme ;
    dcterms:source "Environment and Climate Change Canada (recovery strategies under SARA)" ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/eccc-recovery-priority/beneficial>,
        <https://w3id.org/ecoweaver/warp/scale/eccc-recovery-priority/necessary>,
        <https://w3id.org/ecoweaver/warp/scale/eccc-recovery-priority/urgent> ;
    skos:notation "eccc-recovery-priority" ;
    skos:prefLabel "ECCC recovery measure priority"@en ;
    skos:scopeNote "Ordinal order: priority, lowest first"@en .

scale:usda-tolerance-rating a skos:ConceptScheme ;
    dcterms:source "USDA NRCS PLANTS database" ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/usda-tolerance-rating/high>,
        <https://w3id.org/ecoweaver/warp/scale/usda-tolerance-rating/low>,
        <https://w3id.org/ecoweaver/warp/scale/usda-tolerance-rating/medium>,
        <https://w3id.org/ecoweaver/warp/scale/usda-tolerance-rating/none> ;
    skos:notation "usda-tolerance-rating" ;
    skos:prefLabel "USDA PLANTS tolerance rating"@en ;
    skos:scopeNote "Ordinal order: tolerance, least tolerant first"@en .

scale:eive-1.0-reaction a skos:ConceptScheme ;
    dcterms:source "Dengler et al. 2023, Ecological Indicator Values for Europe (EIVE) 1.0" ;
    rdfs:comment "EIVE values are continuous on 0-10. These five bins of width 2 are WARP's, not EIVE's, so that a value can be compared with others; the verbatim value stays in ScaledValue.value. TODO: confirm the binning (or drop the concepts and keep only the scheme) before release."@en ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/eive-1.0-reaction/0-2>,
        <https://w3id.org/ecoweaver/warp/scale/eive-1.0-reaction/2-4>,
        <https://w3id.org/ecoweaver/warp/scale/eive-1.0-reaction/4-6>,
        <https://w3id.org/ecoweaver/warp/scale/eive-1.0-reaction/6-8>,
        <https://w3id.org/ecoweaver/warp/scale/eive-1.0-reaction/8-10> ;
    skos:notation "eive-1.0-reaction" ;
    skos:prefLabel "EIVE 1.0 reaction (soil pH) indicator value, binned"@en ;
    skos:scopeNote "Ordinal order: position on the reaction gradient, most acid first"@en .

scale:wetland-indicator-status a skos:ConceptScheme ;
    dcterms:source "US National Wetland Plant List (US Army Corps of Engineers)" ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/wetland-indicator-status/FAC>,
        <https://w3id.org/ecoweaver/warp/scale/wetland-indicator-status/FACU>,
        <https://w3id.org/ecoweaver/warp/scale/wetland-indicator-status/FACW>,
        <https://w3id.org/ecoweaver/warp/scale/wetland-indicator-status/OBL>,
        <https://w3id.org/ecoweaver/warp/scale/wetland-indicator-status/UPL> ;
    skos:notation "wetland-indicator-status" ;
    skos:prefLabel "Wetland indicator status"@en ;
    skos:scopeNote "Ordinal order: affinity for wetlands, lowest first"@en .

scale:usda-texture-class a skos:ConceptScheme ;
    dcterms:source "USDA Natural Resources Conservation Service" ;
    skos:hasTopConcept <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/clay>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/clay-loam>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/loam>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/loamy-sand>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/sand>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/sandy-clay>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/sandy-clay-loam>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/sandy-loam>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/silt>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/silt-loam>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/silty-clay>,
        <https://w3id.org/ecoweaver/warp/scale/usda-texture-class/silty-clay-loam> ;
    skos:notation "usda-texture-class" ;
    skos:prefLabel "USDA soil texture class"@en ;
    skos:scopeNote "Ordinal order: approximate fineness, coarsest first (texture classes are not strictly ordinal)"@en .

