prop:question-road-salt-spring-salamander a warp:CausalProposition ;
    warp:identity_key "causal|node:road_salt_application|prevents|node:abundance_of_spring_salamander|affirmed|contingent" ;
    warp:identity_rule_version "warp-prop-identity/4" ;
    warp:object node:abundance_of_spring_salamander ;
    warp:predicate camo:prevents ;
    warp:propositionText "Does road salt application reduce Spring Salamander abundance? The recovery strategy says its impact cannot be properly assessed (TODO check wording)." ;
    warp:raised_as_question true ;
    warp:scope <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#contingent> ;
    warp:status <https://w3id.org/ecoweaver/warp/PropositionStatusEnum#open_question> ;
    warp:subject node:road_salt_application .

