<https://w3id.org/ecoweaver/warp/assessment/bloodroot-gm-1> a warp:SynthesisAssessment ;
    warp:contributions <https://w3id.org/ecoweaver/warp/contrib/bloodroot-gm-1-author> ;
    warp:direction <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> ;
    warp:evidence_balance <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#supportive> ;
    warp:hasEvidenceLines <https://w3id.org/ecoweaver/warp/el/bloodroot-gm-1-experimental>,
        <https://w3id.org/ecoweaver/warp/el/bloodroot-gm-1-practice> ;
    warp:proposition prop:question-bloodroot-garlic-mustard ;
    warp:statementText "The evidence that planting bloodroot typically suppresses garlic mustard population growth is supportive but of low certainty." ;
    warp:strength <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#low> .

<https://w3id.org/ecoweaver/warp/assessment/burning-shrub-cover-1> a warp:SynthesisAssessment ;
    warp:contributions <https://w3id.org/ecoweaver/warp/contrib/burning-shrub-cover-1-author> ;
    warp:direction <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> ;
    warp:evidence_balance <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#supportive> ;
    warp:hasEvidenceLines <https://w3id.org/ecoweaver/warp/el/burning-shrub-cover-1-study> ;
    warp:proposition prop:247fc9907bf5 ;
    warp:statementText "Illustrative: the evidence that prescribed burning typically reduces shrub cover is supportive, of moderate certainty." ;
    warp:strength <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#moderate> .

<https://w3id.org/ecoweaver/warp/assessment/tidal-restoration-aedes-dorsalis-1> a warp:SynthesisAssessment ;
    warp:contributions <https://w3id.org/ecoweaver/warp/contrib/tidal-aedes-1-author> ;
    warp:direction <https://w3id.org/ecoweaver/warp/EvidenceDirectionEnum#supports> ;
    warp:evidence_balance <https://w3id.org/ecoweaver/warp/EvidenceBalanceEnum#insufficient> ;
    warp:hasEvidenceLines <https://w3id.org/ecoweaver/warp/el/tidal-aedes-1-case> ;
    warp:proposition prop:question-tidal-restoration-aedes-dorsalis ;
    warp:scope <https://w3id.org/ecoweaver/warp/SemanticUnitScopeEnum#prototypical> ;
    warp:statementText "Restoring tidal action may reduce Aedes dorsalis larval density in marshes generally; the only evidence is one unreplicated site." ;
    warp:strength <https://w3id.org/ecoweaver/warp/CertaintyGradeEnum#very_low> .

warp:date_lower_bound a owl:AnnotationProperty ;
    rdfs:comment "Normalized xsd:dateTime bound of an ISO 8601 date (half-open: lower inclusive, upper exclusive). Written by export_rdf.py beside the verbatim string (D19)." .

warp:date_upper_bound a owl:AnnotationProperty ;
    rdfs:comment "Normalized xsd:dateTime bound of an ISO 8601 date (half-open: lower inclusive, upper exclusive). Written by export_rdf.py beside the verbatim string (D19)." .

